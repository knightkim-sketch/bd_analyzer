--- a/YUViewLib/src/ui/Mainwindow.cpp
+++ b/YUViewLib/src/ui/Mainwindow.cpp
@@ -258,6 +258,18 @@ MainWindow::MainWindow(bool useAlternativeSources, QWidget *parent) : QMainWindo
                                     QT_VERSION);
   }
 
+  /* Frame Info started out on the right and was moved to the left, directly above the pane that shows
+   * the block syntax, so the pixel analysis and the syntax of the same block sit together. A saved
+   * window state still places it on the right, so move it once and remember that we did - after that
+   * the user's own arrangement is left alone.
+   */
+  if (!settings.value("mainWindow/frameInfoMovedLeft", false).toBool())
+  {
+    this->addDockWidget(Qt::LeftDockWidgetArea, ui.frameInfoDock);
+    this->splitDockWidget(ui.frameInfoDock, ui.cachingInfoDock, Qt::Vertical);
+    settings.setValue("mainWindow/frameInfoMovedLeft", true);
+  }
+
   connect(ui.openButton, &QPushButton::clicked, this, &MainWindow::showFileOpenDialog);
 
   // Connect signals from the separate window
