+  /* The working directory, and nowhere else.
+   *
+   * It used to be the executable's directory with a fallback to the user cache directory, and both
+   * are wrong for how this is deployed. From an RPM the executable lives in /opt/bd-analyzer, owned
+   * by root, so the preferred location always failed the write probe and every run silently landed
+   * in ~/.cache - a path nobody looks at, on a partition that is small on these machines. Decoded
+   * YUV is measured in gigabytes; where it goes must be predictable rather than discovered.
+   *
+   * So it follows the user instead: start the analyzer from the volume that has the room, and the
+   * cache is there, visible next to the material being analysed. Nothing in the application changes
+   * the working directory (no QDir::setCurrent anywhere), so resolving this lazily still gives the
+   * directory the process was started in.
+   *
+   * No fallback on purpose. Somewhere the user did not choose is what this is replacing, and a read
+   * only working directory is a clear "no caching here" rather than a reason to guess again -
+   * callers already treat an empty root as caching being unavailable.
+   */
+  const auto preferred = QDir::currentPath() + "/" + CACHE_DIR_NAME;
+  return isWritable(preferred) ? preferred : QString();
 }
 
 } // namespace
diff --git a/YUViewLib/src/common/BDCachePaths.h b/YUViewLib/src/common/BDCachePaths.h
