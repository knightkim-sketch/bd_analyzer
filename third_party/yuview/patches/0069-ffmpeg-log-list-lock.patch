 QStringList FFmpegVersionHandler::logListFFmpeg;
 
+// av_log calls the callback from whichever thread is logging - the main thread opening a file and
+// the bitstream parser's pooled thread at the same time - so the shared list needs a lock.
+static QMutex logListFFmpegMutex;
+
+QStringList FFmpegVersionHandler::getFFmpegLog()
+{
+  QMutexLocker lock(&logListFFmpegMutex);
+  return logListFFmpeg;
+}
