+/* The three below read the types under the data's mutex (a decoder thread fills them) and leave
+ * uiRows alone: that list must keep matching the check boxes that exist, which a query must not
+ * rebuild behind the panel's back.
+ */
+QStringList StatisticUIHandler::overlayGroups()
+{
+  QStringList groups;
+  if (!this->statisticsData)
+    return groups;
+  std::unique_lock<std::mutex> lock(this->statisticsData->accessMutex);
+  for (const auto &type : this->statisticsData->getStatisticsTypes())
+  {
+    const auto group = type.uiGroup.isEmpty() ? type.typeName : type.uiGroup;
+    if (!groups.contains(group))
+      groups.append(group);
+  }
+  return groups;
+}
+
+bool StatisticUIHandler::isOverlayGroupRendered(const QString &group)
+{
+  if (!this->statisticsData)
+    return false;
+  std::unique_lock<std::mutex> lock(this->statisticsData->accessMutex);
+  for (const auto &type : this->statisticsData->getStatisticsTypes())
+    if ((type.uiGroup.isEmpty() ? type.typeName : type.uiGroup) == group)
+      return type.render;
+  return false;
+}
+
+void StatisticUIHandler::setOverlayGroupRendered(const QString &group, bool render)
+{
+  if (!this->statisticsData)
+    return;
+  // Through the panel's check box when there is one: its signal updates the types, the secondary
+  // controls and the view. Found by its label, which is the group.
+  for (auto *box : itemNameCheckBoxes[0])
+    if (box->text() == group)
+    {
+      box->setChecked(render);
+      return;
+    }
+  {
+    std::unique_lock<std::mutex> lock(this->statisticsData->accessMutex);
+    for (auto &type : this->statisticsData->getStatisticsTypes())
+      if ((type.uiGroup.isEmpty() ? type.typeName : type.uiGroup) == group)
+        type.render = render;
+  }
+  emit updateItem(true);
+}
