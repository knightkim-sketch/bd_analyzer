+void FileInfoWidget::showCodecRows(bool avc)
+{
+  // H.264 and AV1 share the frame index, coding order and packet rows; the rest is per codec.
+  for (const auto *key : {"POC", "frame_num", "slice_type", "nal_ref_idc", "IDR"})
+    this->frameForm->setRowVisible(this->frameValues[key], avc);
+  for (const auto *key : {"order_hint", "frame_type", "show_existing_frame", "Hidden frames in this TU"})
+    this->frameForm->setRowVisible(this->frameValues[key], !avc);
+}
