+void MainWindow::openSequenceGenerator()
+{
+  // Created once and kept, so the scene being drawn survives closing the window.
+  if (!this->sequenceGeneratorWindow)
+  {
+    this->sequenceGeneratorWindow = new bda::integration::SequenceGeneratorWindow(this);
+    connect(this->sequenceGeneratorWindow,
+            &bda::integration::SequenceGeneratorWindow::generated,
+            this,
+            [this](const QString &path) { this->loadFiles({path}); });
+  }
+  this->sequenceGeneratorWindow->show();
+  this->sequenceGeneratorWindow->raise();
+}
