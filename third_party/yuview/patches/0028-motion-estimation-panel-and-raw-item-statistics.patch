+void playlistItemRawFile::drawItem(QPainter *painter,
+                                   int       frameIdx,
+                                   double    zoomFactor,
+                                   bool      drawRawValues)
+{
+  /* The picture first, then the statistics on top - the same order and the same painter call
+   * playlistItemCompressedVideo uses, so an ME overlay on a raw item looks and zooms exactly like
+   * a bitstream overlay on a compressed one.
+   */
+  playlistItemWithVideo::drawItem(painter, frameIdx, zoomFactor, drawRawValues);
+
+  const auto range = this->properties().startEndRange;
+  if (frameIdx >= range.first && frameIdx <= range.second)
+    stats::paintStatisticsData(painter, this->statisticsData, frameIdx, zoomFactor);
+}
+
+bool playlistItemRawFile::supportsMotionEstimation() const
+{
+  // A valid YUV format is the whole requirement: the estimators work on the luma plane, and
+  // readRawFrame() below needs getBytesPerFrame() to mean something.
+  return this->rawFormat == video::RawFormat::YUV && this->video && this->video->isFormatValid();
+}
+
+QByteArray playlistItemRawFile::readRawFrame(int frameIdx)
+{
+  if (!this->supportsMotionEstimation() || frameIdx < 0)
+    return {};
+
+  const auto nrBytes = this->video->getBytesPerFrame();
+  if (nrBytes <= 0)
+    return {};
+
+  int64_t fileStartPos;
+  if (this->isY4MFile)
+  {
+    if (frameIdx >= int(this->y4mFrameIndices.size()))
+      return {};
+    fileStartPos = this->y4mFrameIndices.at(frameIdx);
+  }
+  else
+    fileStartPos = int64_t(frameIdx) * nrBytes;
+
+  QByteArray frame;
+  if (this->dataSource.readBytes(frame, fileStartPos, nrBytes) < nrBytes)
+    // Past the end, or a truncated file.
+    return {};
+  return frame;
+}
