+void MainWindow::cancelMotionEstimation()
+{
+  this->meProgressTimer.stop();
+  // Dropped with the token: the abandoned worker keeps counting into its own copy, and that count
+  // must not reach a bar that now belongs to a different run.
+  this->meProgress.reset();
+  if (this->meCancel)
+  {
+    this->meCancel->cancel();
+    // Dropped rather than reset: the worker keeps its own copy alive and must keep seeing "stop".
+    this->meCancel.reset();
+  }
+}
+
+void MainWindow::motionEstimationTargetChanged(playlistItem *item, int frameIdx)
+{
+  /* Only react when the target actually moved.
+   *
+   * This guard is load-bearing, not tidiness. A finished estimate asks the item to redraw so the
+   * new overlay appears, the redraw makes the view announce its frame again, and that announcement
+   * used to restart the estimate - which finished, redrew, announced... The panel sat there
+   * recomputing the same frame forever and the test that drives it never returned.
+   */
+  if (this->meItem == item && this->meFrameIdx == frameIdx)
+    return;
+
+  this->meItem     = item;
+  this->meFrameIdx = frameIdx;
+  this->restartMotionEstimation();
+}
+
+void MainWindow::restartMotionEstimation()
+{
+  this->cancelMotionEstimation();
+
+  auto *panel = ui.motionEstimationWidget;
+  auto *item  = qobject_cast<playlistItemRawFile *>(this->meItem.data());
+
+  /* Whatever the last run left on the bar describes a frame that is no longer on screen. Clearing
+   * it here covers every early return below at once; a run that actually starts overwrites it.
+   */
+  panel->setProgressIdle(tr("No estimate yet"));
+
+  if (this->meItem.isNull())
+  {
+    panel->setUnavailable(tr("No item selected."));
+    return;
+  }
+  if (item == nullptr || !item->supportsMotionEstimation())
+  {
+    /* Compressed streams are the second phase: the reference frame would have to be decoded, and
+     * this decoder is built around sequential access. Saying so beats a panel that quietly does
+     * nothing.
+     */
+    panel->setUnavailable(tr("Raw YUV items only, for now. A compressed stream would have to decode "
+                             "the reference frame."));
+    return;
+  }
+
+  panel->setAvailable();
+  if (!panel->autoComputeEnabled())
+  {
+    panel->setStatus(tr("Off. Check the box above to estimate in the background."));
+    return;
+  }
+
+  auto       params     = panel->params();
+  const auto range      = item->properties().startEndRange;
+  const int  frameCount = range.second - range.first + 1;
+
+  std::string reason;
+  if (!bda::integration::meFrameRangeOk(this->meFrameIdx, params.frameInterval, frameCount, &reason))
+  {
+    panel->setStatus(QString::fromStdString(reason));
+    return;
+  }
+
+  const int refIdx = bda::integration::meReferenceFrameIdx(this->meFrameIdx, params.frameInterval);
+
+  bda::integration::MeRunRequest request;
+  request.currentFrame   = item->readRawFrame(this->meFrameIdx);
+  request.referenceFrame = item->readRawFrame(refIdx);
+  request.format         = item->getRawPixelFormat();
+  request.frameSize      = item->getRawFrameSize();
+  request.frameIdx       = this->meFrameIdx;
+  request.refFrameIdx    = refIdx;
+
+  if (request.currentFrame.isEmpty() || request.referenceFrame.isEmpty())
+  {
+    panel->setStatus(tr("Could not read frame %1 or %2 from the file.")
+                         .arg(this->meFrameIdx)
+                         .arg(refIdx));
+    return;
+  }
+
+  this->meCancel   = std::make_shared<bda::me::CancelToken>();
+  this->meProgress = std::make_shared<bda::me::ProgressToken>();
+  params.cancel    = this->meCancel.get();
+  params.progress  = this->meProgress.get();
+  request.params   = params;
+
+  /* Register the overlay types now, not when the result arrives.
+   *
+   * The statistics panel builds its rows from the registered types, so leaving registration until
+   * the first estimate finished meant the "draw" checkboxes simply were not there while the user
+   * was looking for them. Registering up front also makes the block-size checkboxes visibly drive
+   * the panel, which is what they are for.
+   */
+  if (bda::integration::syncMeStatTypes(item->getStatisticsData(), params.algorithm, params.blockSizes))
+    if (auto *handler = item->getStatisticsUIHandler())
+      handler->updateStatisticsHandlerControls();
+
+  panel->setStatus(tr("Estimating frame %1 against %2...").arg(this->meFrameIdx).arg(refIdx));
+  panel->setProgressRunning(0, 0);
+  this->meProgressTimer.start();
+
+  /* Both tokens are captured by value so the worker keeps them alive: params.cancel and
+   * params.progress point into them, and this thread drops its own copies on the next restart.
+   */
+  this->meWatcher.setFuture(
+      QtConcurrent::run([request, token = this->meCancel, progress = this->meProgress]()
+                        { return bda::integration::runMe(request); }));
+}
+
+void MainWindow::takeMotionEstimation()
+{
+  const auto result = this->meWatcher.result();
+  auto      *panel  = ui.motionEstimationWidget;
+
+  // A newer run is already on its way; drawing a frame that was abandoned half way would read as a
+  // result rather than as an interruption.
+  if (result.cancelled)
+    return;
+
+  this->meProgressTimer.stop();
+
+  if (!result.error.empty())
+  {
+    panel->setStatus(QString::fromStdString(result.error));
+    panel->setProgressIdle(tr("Failed"));
+    return;
+  }
+
+  auto *item = qobject_cast<playlistItemRawFile *>(this->meItem.data());
+  if (item == nullptr || result.frameIdx != this->meFrameIdx)
+    // The selection or the frame moved on while this was running.
+    return;
+
+  /* No lock taken here, and that is not an oversight.
+   *
+   * StatisticsData::setFrameIndex() locks accessMutex itself (StatisticsData.cpp:607), so calling
+   * it while already holding that lock deadlocks the GUI thread against itself - the mutex is not
+   * recursive. That is exactly what happened: the estimate finished, the finished() handler took
+   * the lock, and setFrameIndex() then waited for a lock its own caller was holding.
+   *
+   * The order below matters instead. setFrameIndex() clears the frame cache when the index moves,
+   * so it has to run *before* the results are filled in, or the fill would be thrown away.
+   */
+  auto &data = item->getStatisticsData();
+  data.setFrameIndex(result.frameIdx);
+  bda::integration::syncMeStatTypes(data, result.algorithm, panel->params().blockSizes);
+  bda::integration::fillMeStatistics(data, result);
+
+  /* No updateStatisticsHandlerControls() here: it rebuilds the panel's rows, and doing that from
+   * a finished background run was the other half of the loop described in playlistItemRawFile's
+   * constructor. The types are registered once per parameter change, which is when the rows are
+   * built anyway.
+   */
+  panel->setStatus(tr("Frame %1 against %2: %3 blocks.")
+                       .arg(result.frameIdx)
+                       .arg(result.refFrameIdx)
+                       .arg(int(result.blocks.size())));
+  // The whole point of the bar: this is what tells the user the overlay they are looking at is the
+  // finished search and not a partial one.
+  panel->setProgressComplete(tr("Frame %1 complete").arg(result.frameIdx));
+
+  /* Repaint the view, nothing more.
+   *
+   * SignalItemChanged() was the obvious call and the wrong one: it means "this item changed", so it
+   * pulls in reloads and further signals, and one of those came back round to restart the estimate
+   * that had just finished. All that is actually needed here is for the overlay to appear, which is
+   * a repaint.
+   */
+  ui.displaySplitView->update();
+}
