+}
+bool playlistItemWithVideo::supportsPixelStatistics() const
+{
+  // Needs the luma plane, so only for YUV output. A decoder that hands back RGB has none.
+  if (this->rawFormat != video::RawFormat::YUV || !this->video)
+    return false;
+  const auto handler = this->getYUVVideo();
+  return handler != nullptr && handler->isFormatValid();
+}
+
+unsigned playlistItemWithVideo::getPixelStatisticsBlockSize() const
+{
+  if (!this->supportsPixelStatistics())
+    return 0;
+  /* Use the grid the view draws, so the numbers describe exactly the cells the user sees: the AV1
+   * superblock for a compressed stream, the fixed analysis grid for a raw file. Before the sequence
+   * header is parsed a compressed item reports 0, so fall back until it knows.
+   */
+  const auto gridSize = this->getDefaultGridSize();
+  return gridSize > 0 ? gridSize : PIXEL_STATS_DEFAULT_BLOCK_SIZE;
+}
+
+uint64_t playlistItemWithVideo::pixelStatsParamHash() const
+{
+  if (!this->supportsPixelStatistics())
+    return 0;
+  const auto handler = this->getYUVVideo();
+  /* Everything that changes the samples or how they are grouped. Luma scale/offset/invert are
+   * display-only (applied when converting to RGB) and deliberately not included.
+   */
+  QByteArray key;
+  key += QByteArray::fromStdString(handler->getPixelFormatYUV().getName());
+  key += handler->convolutionFilterKey();
+  key += QByteArrayLiteral(";blk=") + QByteArray::number(this->getPixelStatisticsBlockSize());
+  const auto digest = QCryptographicHash::hash(key, QCryptographicHash::Sha1);
+  uint64_t   hash{};
+  std::memcpy(&hash, digest.constData(), sizeof(hash));
+  return hash;
+}
+
+void playlistItemWithVideo::openPixelStatsCacheIfNeeded()
+{
+  if (!this->supportsPixelStatistics())
+    return;
+  // startEndRange is (0, nrFrames-1), or (-1, -1) while the format is not known yet.
+  if (this->properties().startEndRange.second < 0)
+    return;
+
+  const auto hash = this->pixelStatsParamHash();
+  if (this->pixelStatsCache.isOpen() && hash == this->pixelStatsCacheParamHash)
+    return;
+
+  // The format, the filter or the block size changed, so everything computed so far describes
+  // something else.
+  this->pixelStatsCache.reset();
+  this->pixelStatsCacheParamHash = hash;
+  this->lumaHistogramFrameIdx    = -1;
+  this->pixelStatsCache.open(this->pixelStatsSourcePath(),
+                             this->getYUVVideo()->getFrameSize(),
+                             this->getPixelStatisticsBlockSize(),
+                             this->properties().startEndRange.second + 1,
+                             hash);
+}
+
+void playlistItemWithVideo::requestPixelStatistics(int frameIdx)
+{
+  if (!this->supportsPixelStatistics())
+    return;
+  if (!this->pixelStatsWatcherConnected)
+  {
+    // Lambda rather than a slot: this class has no Q_OBJECT of its own.
+    connect(&this->pixelStatsWatcher,
+            &QFutureWatcherBase::finished,
+            this,
+            [this] { this->takeComputedPixelStatistics(); });
+    this->pixelStatsWatcherConnected = true;
+  }
+
+  this->openPixelStatsCacheIfNeeded();
+  if (this->pixelStatsCache.has(frameIdx))
+    return;
+  if (this->pixelStatsWatcher.isRunning())
+    // One frame at a time. The caller asks again when the running one reports back.
+    return;
+
+  /* Measure the frame that is actually in the buffer. Asking for a frame that is not loaded would
+   * mean decoding or reading it a second time here; instead we wait to be asked again once the normal
+   * load path has it.
+   */
+  const auto handler     = this->getYUVVideo();
+  int        loadedFrame = -1;
+  auto       rawData     = handler->getCurrentRawYUVData(loadedFrame);
+  if (loadedFrame != frameIdx || rawData.isEmpty())
+    return;
+
+  const auto format    = handler->getPixelFormatYUV();
+  const auto frameSize = handler->getFrameSize();
+  const auto blockSize = this->getPixelStatisticsBlockSize();
+
+  this->pixelStatsFrameInFlight = frameIdx;
+  this->pixelStatsWatcher.setFuture(QtConcurrent::run(
+      [rawData, format, frameSize, blockSize]
+      { return stats::computeLumaBlockStats(rawData, format, frameSize, blockSize); }));
+}
+
+void playlistItemWithVideo::takeComputedPixelStatistics()
+{
+  const auto frameIdx          = this->pixelStatsFrameInFlight;
+  this->pixelStatsFrameInFlight = -1;
+  if (frameIdx < 0)
+    return;
+  const auto blocks = this->pixelStatsWatcher.result();
+  if (blocks.empty())
+    // The pixel format cannot be read (packed, byte packed). Nothing to cache.
+    return;
+  this->pixelStatsCache.store(frameIdx, blocks);
+  emit pixelStatisticsReady(frameIdx);
+}
+
+std::optional<stats::PixelBlockStats>
+playlistItemWithVideo::getPixelBlockStats(const QPoint &pixelPos, int frameIdx)
+{
+  if (!this->pixelStatsCache.isOpen())
+    return {};
+  return this->pixelStatsCache.at(frameIdx, pixelPos);
+}
+
+std::vector<uint32_t> playlistItemWithVideo::getLumaHistogram(int frameIdx)
+{
+  if (!this->supportsPixelStatistics())
+    return {};
+  if (frameIdx == this->lumaHistogramFrameIdx)
+    return this->lumaHistogram;
+
+  const auto handler     = this->getYUVVideo();
+  int        loadedFrame = -1;
+  auto       rawData     = handler->getCurrentRawYUVData(loadedFrame);
+  if (loadedFrame != frameIdx || rawData.isEmpty())
+    return {};
+
+  this->lumaHistogram = stats::computeLumaHistogram(rawData,
+                                                    handler->getPixelFormatYUV(),
+                                                    handler->getFrameSize());
+  this->lumaHistogramFrameIdx = this->lumaHistogram.empty() ? -1 : frameIdx;
+  return this->lumaHistogram;
+}
