+/* bd-analyzer: the frame timeline's sizes, from what opening the file already read - no decoding.
+ * A container's packets (one per temporal unit for AV1) were indexed by the scan, put in
+ * presentation order here; an Annex-B file's frames come from its parser's display-order ranges.
+ */
+std::vector<playlistItem::CodedFrame> playlistItemCompressedVideo::getCodedFrames()
+{
+  std::vector<CodedFrame> frames;
+  if (this->inputFileFFmpegLoading)
+  {
+    auto packets = this->inputFileFFmpegLoading->getPacketIndex();
+    // Without a pts on every packet there is no presentation order to sort by; keep file order.
+    if (std::none_of(packets.begin(), packets.end(), [](const auto &p) {
+          return p.pts == AV_NOPTS_VALUE;
+        }))
+      std::stable_sort(packets.begin(), packets.end(), [](const auto &a, const auto &b) {
+        return a.pts < b.pts;
+      });
+    for (const auto &packet : packets)
+      frames.push_back({packet.bytes, packet.keyframe});
+  }
+  else if (this->inputFileAnnexBParser)
+  {
+    const auto count = this->inputFileAnnexBParser->getNumberPOCs();
+    for (size_t i = 0; i < count; ++i)
+    {
+      CodedFrame frame;
+      if (const auto range = this->inputFileAnnexBParser->getFrameStartEndPosDisplayOrder(
+              parser::FrameIndexDisplayOrder(i)))
+        frame.bytes = int64_t(range->second - range->first); // the end is the next NAL's start
+      frames.push_back(frame);
+    }
+  }
+  return frames;
+}
