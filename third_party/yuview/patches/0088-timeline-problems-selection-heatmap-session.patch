+// The decoder errors of the selected items, for the Problems list.
+void MainWindow::refreshDecoderProblems()
+{
+  std::vector<const void *> present;
+  for (auto *item : ui.playlistTreeWidget->getAllPlaylistItems())
+    present.push_back(item);
+  this->problems->keepDecoderErrorsOf(present);
+  for (auto *item : ui.playlistTreeWidget->getSelectedItems())
+    if (item)
+      this->problems->setDecoderError(item, item->properties().name, item->getDecoderError());
+}
+
+bool MainWindow::saveSession(QString path)
+{
+  if (path.isEmpty())
+    path = QFileDialog::getSaveFileName(
+        this, "Save Session", QString(), "bd-analyzer session (*.bdsession)");
+  if (path.isEmpty())
+    return false;
+  if (!path.endsWith(".bdsession"))
+    path += ".bdsession";
+
+  bda::integration::SessionData session;
+  session.playlistXml = ui.playlistTreeWidget->getPlaylistString(QFileInfo(path).absoluteDir());
+  session.perspective = this->perspectives->current();
+  session.windowState = this->saveState(QT_VERSION);
+  session.windowStateVersion = QT_VERSION;
+  QSaveFile file(path);
+  if (!file.open(QIODevice::WriteOnly) || file.write(bda::integration::writeSession(session)) < 0 ||
+      !file.commit())
+  {
+    QMessageBox::warning(this, "Save Session", "Could not write " + path);
+    return false;
+  }
+  return true;
+}
+
+bool MainWindow::openSession(QString path)
+{
+  if (path.isEmpty())
+    path = QFileDialog::getOpenFileName(
+        this, "Open Session", QString(), "bd-analyzer session (*.bdsession)");
+  if (path.isEmpty())
+    return false;
+  QFile   file(path);
+  QString error;
+  const auto session = file.open(QIODevice::ReadOnly)
+                           ? bda::integration::readSession(file.readAll(), &error)
+                           : std::nullopt;
+  if (!session)
+  {
+    QMessageBox::warning(
+        this, "Open Session", error.isEmpty() ? "Could not read " + path : error);
+    return false;
+  }
+  // The playlist is checked before the current one is thrown away for it.
+  if (QDomDocument document; !document.setContent(session->playlistXml))
+  {
+    QMessageBox::warning(this, "Open Session", "The playlist in " + path + " cannot be read.");
+    return false;
+  }
+  // The layout first, so the items open into the panels they were analysed with.
+  if (session->windowState.isEmpty() ||
+      !this->restoreState(session->windowState, session->windowStateVersion))
+    this->perspectives->apply(session->perspective);
+  this->perspectives->markCurrent(session->perspective);
+  ui.playlistTreeWidget->deletePlaylistItems(true);
+  return ui.playlistTreeWidget->loadPlaylistFromByteArray(session->playlistXml.toUtf8(),
+                                                          QFileInfo(path).absoluteFilePath());
+}
