+QString playlistItemCompressedVideo::getDecoderError() const
+{
+  /* The loading thread sets the error while holding the decoder mutex, and holds it for whole
+   * decodes - so only try it, and report what was last seen while a decode is running.
+   */
+  if (!this->decoderAccessMutex.try_lock())
+    return this->lastDecoderError;
+  if (this->loadingDecoder && this->loadingDecoder->state() == decoder::DecoderState::Error)
+    this->lastDecoderError = this->loadingDecoder->decoderErrorString();
+  else
+    this->lastDecoderError.clear();
+  this->decoderAccessMutex.unlock();
+  return this->lastDecoderError;
+}
