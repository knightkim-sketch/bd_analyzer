+void MainWindow::showStreamDiffLocation(playlistItem *blockStream,
+                                        playlistItem *otherStream,
+                                        playlistItem *syntaxStream,
+                                        int           frameIdx,
+                                        QPoint        pixelPos)
+{
+  if (!blockStream)
+    return;
+
+  /* The stream the block panes follow goes first: it becomes the left view and the first column of
+   * the two-stream panes. The other stays selected so the split view still shows both.
+   */
+  ui.playlistTreeWidget->setSelectedItems(blockStream, otherStream);
+  ui.playbackController->setCurrentFrameAndUpdate(frameIdx);
+  if (pixelPos.x() >= 0 && pixelPos.y() >= 0)
+  {
+    ui.displaySplitView->selectBlockAtItemPixel(0, pixelPos);
+    ui.blockInfoDock->show();
+    ui.blockInfoDock->raise();
+  }
+  // The selection made the Bitstream Analysis pane show blockStream; override it only when the
+  // syntax toggle names the other one, so the same file is not parsed twice.
+  if (syntaxStream && syntaxStream != blockStream)
+    ui.bitstreamAnalysis->currentSelectedItemsChanged(syntaxStream, nullptr, false);
+}
