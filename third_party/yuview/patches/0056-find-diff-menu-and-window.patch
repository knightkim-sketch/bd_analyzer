+void MainWindow::findDiffFromSelection()
+{
+  if (!this->streamDiffWindow)
+    this->streamDiffWindow = new bda::integration::StreamDiffWindow(this);
+
+  const auto result =
+      this->streamDiffWindow->compare(ui.playlistTreeWidget->getAllSelectedItems());
+  if (!result.ok())
+  {
+    /* A dialog rather than a status line, for the same reason the BD-rate action uses one: the
+     * action was a deliberate press and the reason says what to select instead.
+     */
+    QMessageBox::information(this, "Find diff", result.message);
+    return;
+  }
+
+  this->streamDiffWindow->show();
+  this->streamDiffWindow->raise();
+}
