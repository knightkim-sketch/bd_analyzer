+void MainWindow::globalMotionFromSelection()
+{
+  if (!this->globalMotionWindow)
+  {
+    this->globalMotionWindow = new bda::integration::GlobalMotionWindow(this);
+    connect(this->globalMotionWindow,
+            &bda::integration::GlobalMotionWindow::showFrameRequested,
+            this,
+            &MainWindow::showGlobalMotionFrame);
+    // The window redraws its windows for whatever frame the view lands on; a repaint is all it
+    // asks for in return - not SignalItemChanged, which restarts the ME panel (see takeMotionEstimation).
+    connect(ui.displaySplitView,
+            &splitViewWidget::viewFrameChanged,
+            this->globalMotionWindow,
+            &bda::integration::GlobalMotionWindow::setCurrentFrame);
+    connect(this->globalMotionWindow,
+            &bda::integration::GlobalMotionWindow::overlayChanged,
+            ui.displaySplitView,
+            [this] { ui.displaySplitView->update(); });
+  }
+
+  const auto result =
+      this->globalMotionWindow->setTarget(ui.playlistTreeWidget->getAllSelectedItems());
+  if (!result.ok())
+  {
+    QMessageBox::information(this, "Global motion", result.message);
+    return;
+  }
+  this->globalMotionWindow->show();
+  this->globalMotionWindow->raise();
+}
+
+void MainWindow::showGlobalMotionFrame(playlistItem *item, int frameIdx)
+{
+  if (!item)
+    return;
+  ui.playlistTreeWidget->setSelectedItems(item, nullptr);
+  ui.playbackController->setCurrentFrameAndUpdate(frameIdx);
+  ui.displaySplitView->update();
+}
