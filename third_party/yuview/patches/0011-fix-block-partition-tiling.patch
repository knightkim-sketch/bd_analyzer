+  /* The recursion has to start at the level that matches the actual superblock size. Starting at
+   * BL_128X128 makes each call cover a 128x128 area, so for a 64x64-superblock stream - where the
+   * loop advances by one 64x64 superblock - the four quadrants of one call are the neighboring
+   * superblocks, and every block ends up emitted once per call that reaches it: 1, 2 or 4 times
+   * depending on how far it is from the picture border.
+   */
+  const BlockLevel sbLevel = (subBlockSize == 128) ? BL_128X128 : BL_64X64;
+
+  /* sizeInBlocks is in 4x4 units, which is what sb_step and the x/y below are. frameSizeAligned is
+   * in pixels, so iterating to it ran 16x16 instead of 3x3 starting calls for a 176x144 picture and
+   * read block data past the end of each row (b4_stride is far smaller than the aligned pixel
+   * width). Those extra calls emitted nothing only because parseBlockPartition drops out-of-picture
+   * positions.
+   */
+  for (unsigned y = 0; y < frameInfo.sizeInBlocks.height; y += sb_step)
+    for (unsigned x = 0; x < frameInfo.sizeInBlocks.width; x += sb_step)
+      parseBlockRecursive(blockData, x, y, sbLevel, frameInfo);
 }
 
