+void videoHandlerYUV::setStabilization(bda::integration::StabilizationPtr table)
+{
+  {
+    QMutexLocker lock(&this->convolutionFilterMutex);
+    const auto   generation = [](const bda::integration::StabilizationPtr &t) {
+      return t ? std::optional<std::uint64_t>(t->generation) : std::nullopt;
+    };
+    if (generation(table) == generation(this->stabilization))
+      return;
+    this->stabilization = std::move(table);
+  }
+  // The warp runs while the raw samples are read: the same invalidation as setConvolutionFilter().
+  this->currentImageIndex              = -1;
+  this->currentImage_frameIndex        = -1;
+  this->currentFrameRawData_frameIndex = -1;
+  this->setCacheInvalid();
+  emit signalHandlerChanged(true, RECACHE_CLEAR);
+}
+
+QByteArray videoHandlerYUV::stabilizationKey() const
+{
+  const auto table = this->getStabilization();
+  return table ? QByteArrayLiteral(";dis=") + QByteArray::number(qulonglong(table->generation)) : QByteArray();
+}
