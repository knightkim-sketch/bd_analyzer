+bool playlistItemWithVideo::setStabilization(bda::integration::StabilizationPtr table, QString *why)
+{
+  auto *handler = this->getYUVVideo();
+  if (this->rawFormat != video::RawFormat::YUV || handler == nullptr)
+  {
+    if (why)
+      *why = "Stabilisation needs a YUV item.";
+    return false;
+  }
+  if (table && !bda::integration::stabilizationSupported(this->getRawPixelFormat(), this->getRawFrameSize(), why))
+    return false;
+  handler->setStabilization(std::move(table));
+  return true;
+}
