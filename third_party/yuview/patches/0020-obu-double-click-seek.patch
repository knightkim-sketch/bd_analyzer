+void BitstreamAnalysisWidget::dataTreeViewDoubleClicked(const QModelIndex &index)
+{
+  if (!this->playbackController || !index.isValid())
+    return;
+
+  auto sourceIndex = index;
+  if (auto proxy = qobject_cast<QSortFilterProxyModel *>(this->ui.dataTreeView->model()))
+    sourceIndex = proxy->mapToSource(index);
+  if (!sourceIndex.isValid())
+    return;
+
+  const auto item = static_cast<TreeItem *>(sourceIndex.internalPointer());
+  if (!item)
+    return;
+
+  const auto frameIndex = getFrameIndexForObuTreeItem(item);
+  if (!frameIndex)
+    return;
+
+  this->playbackController->setCurrentFrameAndUpdate(*frameIndex);
+}
