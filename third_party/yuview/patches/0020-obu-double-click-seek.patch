+namespace
+{
+
+constexpr auto YUVIEW_FRAME_INDEX_NAME = "YUView frame index";
+
+std::optional<int> getChildIntValue(const TreeItem &item, const std::string &childName)
+{
+  for (size_t i = 0; i < item.getNrChildItems(); ++i)
+  {
+    const auto child = item.getChild(unsigned(i));
+    if (!child || child->getData(0) != childName)
+      continue;
+
+    bool ok = false;
+    const auto value = QString::fromStdString(child->getData(1)).toInt(&ok);
+    if (ok)
+      return value;
+    return {};
+  }
+  return {};
+}
+
+std::optional<int> getFrameIndexForObuTreeItem(TreeItem *item)
+{
+  bool sawObu = false;
+  while (item)
+  {
+    const auto itemName = item->getData(0);
+    if (itemName.rfind("OBU ", 0) == 0)
+      sawObu = true;
+
+    if (itemName.rfind("AVPacket ", 0) == 0)
+    {
+      if (!sawObu)
+        return {};
+      return getChildIntValue(*item, YUVIEW_FRAME_INDEX_NAME);
+    }
+
+    const auto parent = item->getParentItem().lock();
+    item              = parent.get();
+  }
+  return {};
+}
+
