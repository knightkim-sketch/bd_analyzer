@@ -179,6 +179,19 @@ PlaylistTreeWidget::~PlaylistTreeWidget()
  * window would call autoSavePlaylist() on an empty playlist, and that removes the snapshot instead
  * of writing one.
  */
+QList<playlistItem *> PlaylistTreeWidget::getAllSelectedItems() const
+{
+  /* Playlist order rather than click order. Qt's selectedItems() returns them in the order they
+   * were selected, and a group's points are read as a curve - the order they sit in the playlist is
+   * the one the user arranged and the one the table should show.
+   */
+  QList<playlistItem *> result;
+  for (int i = 0; i < this->topLevelItemCount(); ++i)
+    if (auto *item = dynamic_cast<playlistItem *>(this->topLevelItem(i)); item && item->isSelected())
+      result.append(item);
+  return result;
+}
