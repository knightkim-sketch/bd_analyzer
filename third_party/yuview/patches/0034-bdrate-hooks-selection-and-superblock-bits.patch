+bool playlistItemCompressedVideo::providesSuperblockBits() const
+{
+  if (!this->loadingDecoder || !this->loadingDecoder->statisticsSupported())
+    return false;
+  /* The type list is filled when the decoder is allocated, so this answers before any frame has
+   * been decoded - which is when the BD-rate button needs to know.
+   */
+  for (const auto &type : this->statisticsData.getStatisticsTypes())
+    if (type.typeID == decoder::decoderDav1d::SB_BITCOUNT_TYPE_ID)
+      return true;
+  return false;
+}
