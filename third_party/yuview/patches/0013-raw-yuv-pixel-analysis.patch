+#include <QVBoxLayout>
+#include <QWidget>
+
+#include <optional>
+
+#include <ui/widgets/HistogramWidget.h>
+
+class playlistItem;
+
+/* Frame level analysis of a raw YUV item: the luma histogram of the frame, and the statistics of the
+ * 64x64 block that was clicked.
+ *
+ * Separate from BlockInfoWidget on purpose. That one reports what the *bitstream* says about a block
+ * (AV1 syntax from the decoder); this one reports what the *pixels* are, which also exists for raw
+ * files where there is no bitstream.
+ *
+ * The statistics of the whole frame are computed in the background and cached (see
+ * stats::PixelStatisticsCache), so clicking around a frame costs nothing after the first request.
+ */
+class FrameInfoWidget : public QWidget
+{
+  Q_OBJECT
+
+public:
+  explicit FrameInfoWidget(QWidget *parent = nullptr);
+
+  //!< Whether the analysis grid should be drawn. Mirrors the view, see setGridSize().
+  bool isGridEnabled() const { return this->gridCheckBox.isChecked(); }
+
+signals:
+  /* The user toggled the grid. size is the item's grid size when enabling and 0 when disabling, which
+   * is exactly what splitViewWidget::setRegularGridSize() takes.
+   */
+  void gridSizeRequested(int size);
+
+public slots:
+  //!< From splitViewWidget::blockSelected. item == nullptr clears the block section.
+  void setSelectedBlock(playlistItem *item, QPoint pixelPos, int frameIdx);
+  //!< Re-read everything for the stored selection (new frame loaded, format changed, filter changed).
+  void refresh();
+  //!< The playlist selection changed. Clears when our item is no longer selected.
+  void currentSelectedItemsChanged(playlistItem *item1, playlistItem *item2);
+  //!< Reflect the grid size the view actually uses, without emitting gridSizeRequested().
+  void setGridSize(int size);
+  //!< The background computation for a frame finished.
+  void pixelStatisticsReady(int frameIdx);
+  /* Which item and frame the view is showing. The histogram follows the displayed frame, so it must
+   * not wait for a click. The block statistics follow it too, so stepping frames re-reads the same
+   * position.
+   */
+  void setCurrentFrame(playlistItem *item, int frameIdx);
+
+private:
+  /* Take over a new item, connecting to its background-statistics signal. Items come and go with the
+   * playlist, so the connection is made here rather than once in the main window.
+   */
+  void setItem(playlistItem *item);
+  void updateHistogram();
+  void updateBlockStatistics();
+  void showBlockMessage(const QString &text);
+
+  QVBoxLayout     layout;
+  QCheckBox       gridCheckBox;
+  QLabel          histogramLabel;
+  HistogramWidget histogram;
+  QLabel          blockLabel;
+  QTreeWidget     blockTree;
+
+  QPointer<playlistItem>  selectedItem;
+  int                     selectedFrameIdx{-1};
+  //!< Nothing until the user clicks in the view.
+  std::optional<QPoint>   selectedPos;
+  //!< The grid size the item wants, remembered so the checkbox can ask for it again.
+  int                    itemGridSize{64};
+};
