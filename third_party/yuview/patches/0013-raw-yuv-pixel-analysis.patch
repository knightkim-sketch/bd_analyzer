+
+double ConvolutionFilter::coefficientSum() const
+{
+  double sum = 0.0;
+  for (const auto coefficient : this->kernel)
+    sum += coefficient;
+  return sum;
+}
+
+bool ConvolutionFilter::isNoOp() const
+{
+  if (!this->enabled)
+    return true;
+  // The identity kernel, allowing for the fact that the values come from text input.
+  for (size_t i = 0; i < this->kernel.size(); i++)
+  {
+    const auto expected = (i == 4) ? 1.0 : 0.0;
+    if (std::abs(this->kernel[i] - expected) > 1e-12)
+      return false;
+  }
+  return true;
+}
+
+QByteArray ConvolutionFilter::key() const
+{
+  if (this->isNoOp())
+    // Everything that changes nothing must share one key, so toggling an identity kernel on and off
+    // does not throw away the cached statistics.
+    return QByteArrayLiteral("conv:none");
+  QByteArray key = QByteArrayLiteral("conv:");
+  for (const auto coefficient : this->kernel)
+    key += QByteArray::number(coefficient, 'g', 17) + ',';
+  return key;
+}
+
+void ConvolutionFilter::applyToLuma(QByteArray           &rawYUV,
+                                    const PixelFormatYUV &format,
+                                    const Size           &frameSize) const
+{
+  if (this->isNoOp())
+    return;
+  if (!format.isValid() || !frameSize.isValid())
+    return;
+  // Planar only: for those the luma plane is the first plane and a plain width x height array, which
+  // is all this needs. Unpacking a packed format would mean duplicating videoHandlerYUV's conversion.
+  if (!format.isPlanar() || format.isBytePacking())
+    return;
+
+  const auto bitDepth = format.getBitsPerSample();
+  if (bitDepth < 8 || bitDepth > 16)
+    return;
+
+  const bool     twoBytes  = bitDepth > 8;
+  const bool     bigEndian = format.isBigEndian();
+  const unsigned width     = frameSize.width;
+  const unsigned height    = frameSize.height;
+  const int64_t  nrSamples = int64_t(width) * height;
+  const int64_t  lumaBytes = nrSamples * (twoBytes ? 2 : 1);
+  if (rawYUV.size() < lumaBytes)
+    return;
+
+  auto *plane = reinterpret_cast<uint8_t *>(rawYUV.data());
+
+  const auto readSample = [&](unsigned x, unsigned y) -> unsigned {
+    const int64_t index = int64_t(y) * width + x;
+    if (!twoBytes)
+      return plane[index];
+    const auto *p = plane + index * 2;
+    return bigEndian ? (unsigned(p[0]) << 8 | p[1]) : (unsigned(p[1]) << 8 | p[0]);
+  };
+  const auto writeSample = [&](unsigned x, unsigned y, unsigned value) {
+    const int64_t index = int64_t(y) * width + x;
+    if (!twoBytes)
+    {
+      plane[index] = uint8_t(value);
+      return;
+    }
+    auto *p = plane + index * 2;
+    if (bigEndian)
+    {
+      p[0] = uint8_t(value >> 8);
+      p[1] = uint8_t(value & 0xff);
+    }
+    else
+    {
+      p[0] = uint8_t(value & 0xff);
+      p[1] = uint8_t(value >> 8);
+    }
+  };
+
+  // A convolution reads neighbors, so it cannot run in place. One copy of the luma plane is enough.
+  std::vector<uint16_t> source(static_cast<size_t>(nrSamples));
+  for (unsigned y = 0; y < height; y++)
+    for (unsigned x = 0; x < width; x++)
+      source[size_t(y) * width + x] = uint16_t(readSample(x, y));
+
+  const auto     sum       = this->coefficientSum();
+  const double   divisor   = (std::abs(sum) < 1e-12) ? 1.0 : sum;
+  const unsigned maxValue  = (1u << bitDepth) - 1u;
+
+  for (unsigned y = 0; y < height; y++)
+  {
+    for (unsigned x = 0; x < width; x++)
+    {
+      double accumulated = 0.0;
+      for (int ky = -1; ky <= 1; ky++)
+      {
+        // Replicate the border instead of treating the outside as black, which would darken the edges.
+        const unsigned sampleY =
+            unsigned(std::clamp(int(y) + ky, 0, int(height) - 1));
+        for (int kx = -1; kx <= 1; kx++)
+        {
+          const unsigned sampleX = unsigned(std::clamp(int(x) + kx, 0, int(width) - 1));
+          accumulated += this->kernel[size_t((ky + 1) * 3 + (kx + 1))] *
+                         double(source[size_t(sampleY) * width + sampleX]);
+        }
+      }
+      const auto scaled = std::lround(accumulated / divisor);
+      writeSample(x, y, unsigned(std::clamp<int64_t>(scaled, 0, int64_t(maxValue))));
+    }
+  }
+}
+
+} // namespace video::yuv
