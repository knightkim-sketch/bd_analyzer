+
+video::yuv::videoHandlerYUV *playlistItemRawFile::yuvHandler() const
+{
+  // A raw file is either YUV or RGB (see the constructor). Only YUV has a luma plane to measure.
+  return dynamic_cast<video::yuv::videoHandlerYUV *>(this->video.get());
+}
+
+bool playlistItemRawFile::supportsPixelStatistics() const
+{
+  const auto handler = this->yuvHandler();
+  return handler != nullptr && handler->isFormatValid();
+}
+
+unsigned playlistItemRawFile::getDefaultGridSize() const
+{
+  // Only offer the grid where the statistics behind it exist, so the grid never implies numbers that
+  // cannot be shown.
+  return this->supportsPixelStatistics() ? PIXEL_STATS_BLOCK_SIZE : 0;
+}
+
+uint64_t playlistItemRawFile::pixelStatsParamHash() const
+{
+  const auto handler = this->yuvHandler();
+  if (!handler)
+    return 0;
+  /* Everything that changes the samples we measure. The pixel format decides how the plane is read;
+   * the convolution filter rewrites it. Luma scale/offset/invert are display-only (applied during the
+   * conversion to RGB) and deliberately not included.
+   */
+  QByteArray key;
+  key += QByteArray::fromStdString(handler->getPixelFormatYUV().getName());
+  key += handler->convolutionFilterKey();
+  const auto digest = QCryptographicHash::hash(key, QCryptographicHash::Sha1);
+  uint64_t   hash{};
+  std::memcpy(&hash, digest.constData(), sizeof(hash));
+  return hash;
+}
+
+void playlistItemRawFile::openPixelStatsCacheIfNeeded()
+{
+  const auto handler = this->yuvHandler();
+  if (!handler)
+    return;
+  // startEndRange is (0, nrFrames-1), or (-1, -1) while the format is not known yet.
+  if (this->properties().startEndRange.second < 0)
+    return;
+  const auto hash = this->pixelStatsParamHash();
+  if (this->pixelStatsCache.isOpen() && hash == this->pixelStatsCacheParamHash)
+    return;
+
+  // The format or the filter changed, so everything computed so far describes other samples.
+  this->pixelStatsCache.reset();
+  this->pixelStatsCacheParamHash = hash;
+  this->lumaHistogramFrameIdx    = -1;
+  this->pixelStatsCache.open(QString::fromStdString(this->dataSource.getAbsoluteFilePath()),
+                             handler->getFrameSize(),
+                             PIXEL_STATS_BLOCK_SIZE,
+                             this->properties().startEndRange.second + 1,
+                             hash);
+}
+
+void playlistItemRawFile::requestPixelStatistics(int frameIdx)
+{
+  const auto handler = this->yuvHandler();
+  if (!handler)
+    return;
+  this->openPixelStatsCacheIfNeeded();
+  if (this->pixelStatsCache.has(frameIdx))
+    return;
+  if (this->pixelStatsWatcher.isRunning())
+    // One frame at a time. The caller asks again when the running one reports back.
+    return;
+
+  /* Measure the frame that is actually in the buffer. Asking for a frame that is not loaded would
+   * mean reading the file a second time here; instead we simply wait to be asked again once the
+   * normal load path has it.
+   */
+  int  loadedFrame = -1;
+  auto rawData     = handler->getCurrentRawYUVData(loadedFrame);
+  if (loadedFrame != frameIdx || rawData.isEmpty())
+    return;
+
+  const auto format    = handler->getPixelFormatYUV();
+  const auto frameSize = handler->getFrameSize();
+
+  this->pixelStatsFrameInFlight = frameIdx;
+  this->pixelStatsWatcher.setFuture(QtConcurrent::run(
+      [rawData, format, frameSize]
+      { return stats::computeLumaBlockStats(rawData, format, frameSize, PIXEL_STATS_BLOCK_SIZE); }));
+}
+
+void playlistItemRawFile::pixelStatisticsComputed()
+{
+  const auto frameIdx = this->pixelStatsFrameInFlight;
+  this->pixelStatsFrameInFlight = -1;
+  if (frameIdx < 0)
+    return;
+  const auto blocks = this->pixelStatsWatcher.result();
+  if (blocks.empty())
+    // The pixel format cannot be read (packed, byte packed). Nothing to cache.
+    return;
+  this->pixelStatsCache.store(frameIdx, blocks);
+  emit pixelStatisticsReady(frameIdx);
+}
+
+std::optional<stats::PixelBlockStats> playlistItemRawFile::getPixelBlockStats(const QPoint &pixelPos,
+                                                                             int frameIdx)
+{
+  if (!this->pixelStatsCache.isOpen())
+    return {};
+  return this->pixelStatsCache.at(frameIdx, pixelPos);
+}
+
+std::vector<uint32_t> playlistItemRawFile::getLumaHistogram(int frameIdx)
+{
+  const auto handler = this->yuvHandler();
+  if (!handler)
+    return {};
+  if (frameIdx == this->lumaHistogramFrameIdx)
+    return this->lumaHistogram;
+
+  int  loadedFrame = -1;
+  auto rawData     = handler->getCurrentRawYUVData(loadedFrame);
+  if (loadedFrame != frameIdx || rawData.isEmpty())
+    return {};
+
+  this->lumaHistogram = stats::computeLumaHistogram(rawData,
+                                                    handler->getPixelFormatYUV(),
+                                                    handler->getFrameSize());
+  this->lumaHistogramFrameIdx = this->lumaHistogram.empty() ? -1 : frameIdx;
+  return this->lumaHistogram;
+}
