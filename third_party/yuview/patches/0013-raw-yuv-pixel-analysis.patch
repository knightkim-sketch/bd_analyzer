+#pragma once
+
+#include <QByteArray>
+
+#include <array>
+
+#include <common/Typedef.h>
+#include <video/yuv/PixelFormatYUV.h>
+
+namespace video::yuv
+{
+
+/* A 3x3 convolution applied to the luma plane.
+ *
+ * A plain value type on purpose: the caching threads snapshot it (like they already do for the pixel
+ * format and the frame size) instead of reading fields that the GUI thread may be editing.
+ *
+ * Only luma is filtered. Chroma is left alone, so the colors of the picture stay put while the
+ * structure changes - which is what makes the result readable when looking for edges or noise.
+ */
+struct ConvolutionFilter
+{
+  //!< Row major, kernel[4] is the center. The default is the identity.
+  std::array<double, 9> kernel{{0, 0, 0, 0, 1, 0, 0, 0, 0}};
+  bool                  enabled{false};
+
+  //!< Sum of the coefficients. The result is divided by it unless it is zero (edge detectors).
+  double coefficientSum() const;
+
+  //!< True when applying this would not change anything, so the work can be skipped.
+  bool isNoOp() const;
+
+  /* Identifies the filter for the statistics cache: two filters with the same key produce the same
+   * samples, so cached statistics stay valid exactly while the key does not change.
+   */
+  QByteArray key() const;
+
+  /* Rewrite the luma plane of one full frame in place. Border pixels replicate the edge. Does
+   * nothing for formats whose plane layout this cannot read (packed or byte packed formats), and
+   * nothing when isNoOp().
+   */
+  void applyToLuma(QByteArray &rawYUV, const PixelFormatYUV &format, const Size &frameSize) const;
+
+  bool operator==(const ConvolutionFilter &other) const
+  {
+    return this->enabled == other.enabled && this->kernel == other.kernel;
+  }
+  bool operator!=(const ConvolutionFilter &other) const { return !(*this == other); }
+};
+
+} // namespace video::yuv
