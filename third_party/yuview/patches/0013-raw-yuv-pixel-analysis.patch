+QWidget *videoHandlerYUV::createConvolutionFilterControls()
+{
+  auto *group  = new QGroupBox("Convolution filter (luma)");
+  auto *layout = new QVBoxLayout(group);
+
+  this->convEnableCheckBox = new QCheckBox("Enable");
+  this->convEnableCheckBox->setToolTip(
+      "Apply the 3x3 kernel below to the luma plane. The result is divided by the sum of the "
+      "coefficients (not divided when the sum is zero, as for edge detectors). Chroma is not "
+      "touched. Everything downstream sees the filtered picture: the displayed image, the pixel "
+      "values and the block statistics.");
+  this->convEnableCheckBox->setChecked(this->convolutionFilter.enabled);
+  layout->addWidget(this->convEnableCheckBox);
+
+  this->convKernelTable = new QTableWidget(3, 3);
+  this->convKernelTable->horizontalHeader()->hide();
+  this->convKernelTable->verticalHeader()->hide();
+  this->convKernelTable->horizontalHeader()->setSectionResizeMode(QHeaderView::Stretch);
+  this->convKernelTable->verticalHeader()->setSectionResizeMode(QHeaderView::Stretch);
+  this->convKernelTable->setSelectionMode(QAbstractItemView::SingleSelection);
+  // Three rows of text plus the frame. Without this the table claims far more height than it needs.
+  this->convKernelTable->setFixedHeight(3 * 24 + 4);
+  for (int row = 0; row < 3; row++)
+    for (int column = 0; column < 3; column++)
+    {
+      auto *cell = new QTableWidgetItem(
+          QString::number(this->convolutionFilter.kernel[size_t(row * 3 + column)]));
+      cell->setTextAlignment(Qt::AlignCenter);
+      this->convKernelTable->setItem(row, column, cell);
+    }
+  layout->addWidget(this->convKernelTable);
+
+  connect(this->convEnableCheckBox,
+          &QCheckBox::toggled,
+          this,
+          &videoHandlerYUV::slotConvolutionFilterChanged);
+  connect(this->convKernelTable,
+          &QTableWidget::itemChanged,
+          this,
+          &videoHandlerYUV::slotConvolutionFilterChanged);
+
+  return group;
+}
+
+void videoHandlerYUV::slotConvolutionFilterChanged()
+{
+  if (!this->convKernelTable || !this->convEnableCheckBox)
+    return;
+
+  ConvolutionFilter filter;
+  filter.enabled = this->convEnableCheckBox->isChecked();
+  for (int row = 0; row < 3; row++)
+    for (int column = 0; column < 3; column++)
+    {
+      const auto *cell = this->convKernelTable->item(row, column);
+      // Unparsable text counts as 0 rather than rejecting the edit, so a half typed "-" or "." does
+      // not fight the user while they are typing.
+      filter.kernel[size_t(row * 3 + column)] = cell ? cell->text().toDouble() : 0.0;
+    }
+
+  this->setConvolutionFilter(filter);
+}
+
+void videoHandlerYUV::setConvolutionFilter(const ConvolutionFilter &filter)
+{
+  if (filter == this->convolutionFilter)
+    return;
+  // Two filters that both do nothing produce the same samples, so there is nothing to redo.
+  const auto wasNoOp = this->convolutionFilter.isNoOp();
+  this->convolutionFilter = filter;
+  if (wasNoOp && filter.isNoOp())
+    return;
+
+  /* Same invalidation the other YUV controls do (slotYUVControlChanged). The filter runs while the
+   * raw samples are read, so unlike a display-only setting the raw buffer has to be re-read as well -
+   * hence currentFrameRawData_frameIndex too.
+   */
+  this->currentImageIndex              = -1;
+  this->currentImage_frameIndex        = -1;
+  this->currentFrameRawData_frameIndex = -1;
+  this->setCacheInvalid();
+  emit signalHandlerChanged(true, RECACHE_CLEAR);
+}
+
 } // namespace video::yuv
