+ *   but WITHOUT ANY WARRANTY; without even the implied warranty of
+ *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+ *   GNU General Public License for more details.
+ *
+ *   You should have received a copy of the GNU General Public License
+ *   along with this program. If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include "FrameInfoWidget.h"
+
+#include <QHeaderView>
+
+#include <cmath>
+
+#include <playlistitem/playlistItem.h>
+
+namespace
+{
+
+/* The rows of the block statistics table. Adding a value means adding one entry here and one field to
+ * stats::PixelBlockStats (which needs PIXEL_STATS_CACHE_VERSION bumped so old cache files are
+ * discarded) - nothing else in the widget has to change.
+ */
+struct StatisticRow
+{
+  const char *name;
+  QString (*format)(const stats::PixelBlockStats &);
+};
+
+QString formatValue(double value)
+{
+  return QString::number(value, 'f', 2);
+}
+
+const StatisticRow STATISTIC_ROWS[] = {
+    {"mean", [](const stats::PixelBlockStats &s) { return formatValue(s.mean); }},
+    {"variance", [](const stats::PixelBlockStats &s) { return formatValue(s.variance); }},
+    {"std deviation",
+     [](const stats::PixelBlockStats &s) { return formatValue(std::sqrt(s.variance)); }},
+    {"minimum", [](const stats::PixelBlockStats &s) { return QString::number(int(s.minimum)); }},
+    {"maximum", [](const stats::PixelBlockStats &s) { return QString::number(int(s.maximum)); }},
+};
+
+} // namespace
+
+FrameInfoWidget::FrameInfoWidget(QWidget *parent) : QWidget(parent)
+{
+  this->gridCheckBox.setText("Analysis grid");
+  this->gridCheckBox.setToolTip("Draw the block grid the statistics below are computed on.");
+  connect(&this->gridCheckBox,
+          &QCheckBox::toggled,
+          this,
+          [this](bool checked) { emit gridSizeRequested(checked ? this->itemGridSize : 0); });
+
+  this->histogramLabel.setText("Image attribute - luma histogram");
+  this->histogram.setPlaceholderText("No luma data");
+
+  this->blockTree.setColumnCount(2);
+  this->blockTree.setHeaderLabels({"Value", "Y"});
+  this->blockTree.setRootIsDecorated(false);
+  this->blockTree.setUniformRowHeights(true);
+  this->blockTree.setSelectionMode(QAbstractItemView::NoSelection);
+  this->blockTree.setFocusPolicy(Qt::NoFocus);
+  this->blockTree.header()->setSectionResizeMode(0, QHeaderView::ResizeToContents);
+
+  this->layout.setContentsMargins(4, 4, 4, 4);
+  this->layout.addWidget(&this->gridCheckBox);
+  this->layout.addWidget(&this->histogramLabel);
+  this->layout.addWidget(&this->histogram);
+  this->layout.addWidget(&this->blockLabel);
+  this->layout.addWidget(&this->blockTree, 1);
+  this->setLayout(&this->layout);
+
+  this->showBlockMessage("Click in the video to analyze a block.");
+}
+
+void FrameInfoWidget::setItem(playlistItem *item)
+{
+  if (this->selectedItem == item)
+    return;
+  this->selectedItem = item;
+  if (item)
+    // UniqueConnection so re-selecting the same item does not stack connections.
+    connect(item,
+            &playlistItem::pixelStatisticsReady,
+            this,
+            &FrameInfoWidget::pixelStatisticsReady,
+            Qt::UniqueConnection);
+}
+
+void FrameInfoWidget::setGridSize(int size)
+{
+  // Reflect what the view does (the View menu can change it too) without asking for it back.
+  QSignalBlocker blocker(this->gridCheckBox);
+  this->gridCheckBox.setChecked(size > 0);
+  if (size > 0)
+    this->itemGridSize = size;
+}
+
+void FrameInfoWidget::setSelectedBlock(playlistItem *item, QPoint pixelPos, int frameIdx)
+{
+  this->setItem(item);
+  this->selectedFrameIdx = frameIdx;
+  if (item)
+    this->selectedPos = pixelPos;
+  else
+    this->selectedPos.reset();
+  this->refresh();
+}
+
+void FrameInfoWidget::setCurrentFrame(playlistItem *item, int frameIdx)
+{
+  if (this->selectedItem != item)
+    // A different item: the position that was clicked in the old one means nothing here.
+    this->selectedPos.reset();
+  if (this->selectedItem == item && this->selectedFrameIdx == frameIdx)
+    return;
+  this->setItem(item);
+  this->selectedFrameIdx = frameIdx;
+  this->refresh();
+}
+
+void FrameInfoWidget::currentSelectedItemsChanged(playlistItem *item1, playlistItem *item2)
+{
+  if (this->selectedItem && this->selectedItem != item1 && this->selectedItem != item2)
+  {
+    this->selectedItem     = nullptr;
+    this->selectedFrameIdx = -1;
+  }
+  // The grid size is a property of the newly selected item.
+  if (item1)
+    if (const auto size = int(item1->getDefaultGridSize()); size > 0)
+      this->itemGridSize = size;
+  this->refresh();
+}
+
+void FrameInfoWidget::pixelStatisticsReady(int frameIdx)
+{
+  if (frameIdx == this->selectedFrameIdx)
+    this->updateBlockStatistics();
+}
+
+void FrameInfoWidget::refresh()
+{
+  this->updateHistogram();
+  this->updateBlockStatistics();
+}
+
+void FrameInfoWidget::updateHistogram()
+{
+  auto *item = this->selectedItem.data();
+  if (!item || this->selectedFrameIdx < 0)
+  {
+    this->histogram.setHistogram({});
+    this->histogram.setPlaceholderText("Select a raw YUV item");
+    return;
+  }
+  const auto bins = item->getLumaHistogram(this->selectedFrameIdx);
+  this->histogram.setHistogram(bins);
+  if (bins.empty())
+    this->histogram.setPlaceholderText(item->supportsPixelStatistics()
+                                           ? "Frame not loaded yet"
+                                           : "Only available for raw YUV");
+  this->histogramLabel.setText(bins.empty()
+                                   ? QString("Image attribute - luma histogram")
+                                   : QString("Image attribute - luma histogram, frame %1")
+                                         .arg(this->selectedFrameIdx));
+}
+
+void FrameInfoWidget::showBlockMessage(const QString &text)
+{
+  this->blockTree.clear();
+  this->blockLabel.setText(text);
+}
+
+void FrameInfoWidget::updateBlockStatistics()
+{
+  auto *item = this->selectedItem.data();
+  if (!item || this->selectedFrameIdx < 0 || !this->selectedPos)
+    return this->showBlockMessage("Click in the video to analyze a block.");
+  if (!item->supportsPixelStatistics())
+    return this->showBlockMessage("Pixel statistics are only available for raw YUV items.");
+
+  const auto blockSize = item->getPixelStatisticsBlockSize();
+  if (blockSize == 0)
+    return this->showBlockMessage("No block size reported.");
+
+  const auto blockX = (this->selectedPos->x() / int(blockSize)) * int(blockSize);
+  const auto blockY = (this->selectedPos->y() / int(blockSize)) * int(blockSize);
+
+  const auto values = item->getPixelBlockStats(*this->selectedPos, this->selectedFrameIdx);
+  if (!values)
+  {
+    /* Not computed yet. Ask for it - the whole frame is done in one background pass - and come back
+     * when pixelStatisticsReady() arrives.
+     */
+    item->requestPixelStatistics(this->selectedFrameIdx);
+    return this->showBlockMessage(QString("Block (%1,%2) %3x%3 - computing...")
+                                      .arg(blockX)
+                                      .arg(blockY)
+                                      .arg(blockSize));
+  }
+
+  this->blockLabel.setText(
+      QString("Block (%1,%2) %3x%3, frame %4").arg(blockX).arg(blockY).arg(blockSize).arg(
+          this->selectedFrameIdx));
+
+  this->blockTree.clear();
+  for (const auto &row : STATISTIC_ROWS)
+  {
+    auto *treeItem = new QTreeWidgetItem(&this->blockTree);
+    treeItem->setText(0, row.name);
+    treeItem->setText(1, row.format(*values));
+    treeItem->setTextAlignment(1, Qt::AlignRight | Qt::AlignVCenter);
+  }
+}
