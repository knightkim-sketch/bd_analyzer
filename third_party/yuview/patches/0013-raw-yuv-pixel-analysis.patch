+#include "PixelStatistics.h"
+
+#include <QFile>
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <limits>
+
+#include <common/BDCachePaths.h>
+
+namespace stats
+{
+namespace
+{
+
+const char CACHE_MAGIC[8] = {'Y', 'V', 'B', 'D', 'B', 'S', 'T', '1'};
+
+/* The fixed part of the cache file. Written and read field by field rather than by dumping the
+ * struct, so the file does not depend on the compiler's padding.
+ */
+constexpr int HEADER_BYTES = 64;
+
+/* Reading one luma sample. Only planar formats are supported: for those the luma plane is the first
+ * plane and is a plain width x height array of samples, which is all this needs. Packed formats
+ * interleave the components, and byte packing squeezes samples across byte boundaries - both would
+ * need the full unpacking logic from videoHandlerYUV, which is not worth duplicating here.
+ */
+struct LumaPlaneReader
+{
+  const uint8_t *data{};
+  int64_t        sampleCount{};
+  unsigned       width{};
+  bool           twoBytes{};
+  bool           bigEndian{};
+
+  unsigned at(unsigned x, unsigned y) const
+  {
+    const int64_t index = int64_t(y) * this->width + x;
+    if (!this->twoBytes)
+      return this->data[index];
+    const auto *p = this->data + index * 2;
+    return this->bigEndian ? (unsigned(p[0]) << 8 | p[1]) : (unsigned(p[1]) << 8 | p[0]);
+  }
+};
+
+std::optional<LumaPlaneReader> makeLumaReader(const QByteArray                 &rawYUV,
+                                             const video::yuv::PixelFormatYUV &format,
+                                             const Size                       &frameSize)
+{
+  if (!format.isValid() || !frameSize.isValid())
+    return {};
+  if (!format.isPlanar() || format.isBytePacking())
+    return {};
+
+  const auto bitDepth = format.getBitsPerSample();
+  if (bitDepth < 8 || bitDepth > 16)
+    return {};
+
+  LumaPlaneReader reader;
+  reader.twoBytes    = bitDepth > 8;
+  reader.bigEndian   = format.isBigEndian();
+  reader.width       = frameSize.width;
+  reader.sampleCount = int64_t(frameSize.width) * frameSize.height;
+
+  const int64_t lumaBytes = reader.sampleCount * (reader.twoBytes ? 2 : 1);
+  if (rawYUV.size() < lumaBytes)
+    // Truncated frame (a cut file, or the data is not loaded yet).
+    return {};
+
+  reader.data = reinterpret_cast<const uint8_t *>(rawYUV.constData());
+  return reader;
+}
+
+} // namespace
+
+std::vector<PixelBlockStats> computeLumaBlockStats(const QByteArray                 &rawYUV,
+                                                   const video::yuv::PixelFormatYUV &format,
+                                                   const Size                       &frameSize,
+                                                   unsigned                          blockSize)
+{
+  if (blockSize == 0)
+    return {};
+  const auto reader = makeLumaReader(rawYUV, format, frameSize);
+  if (!reader)
+    return {};
+
+  const unsigned blocksPerRow    = (frameSize.width + blockSize - 1) / blockSize;
+  const unsigned blocksPerColumn = (frameSize.height + blockSize - 1) / blockSize;
+
+  std::vector<PixelBlockStats> result(size_t(blocksPerRow) * blocksPerColumn);
+
+  for (unsigned blockY = 0; blockY < blocksPerColumn; blockY++)
+  {
+    const unsigned yStart = blockY * blockSize;
+    const unsigned yEnd   = std::min(yStart + blockSize, frameSize.height);
+    for (unsigned blockX = 0; blockX < blocksPerRow; blockX++)
+    {
+      const unsigned xStart = blockX * blockSize;
+      const unsigned xEnd   = std::min(xStart + blockSize, frameSize.width);
+
+      // Sum of values and of squares in one pass. The counts here are at most 128x128 samples of at
+      // most 16 bit, so uint64 cannot overflow.
+      uint64_t sum      = 0;
+      uint64_t sumSq    = 0;
+      unsigned minimum  = std::numeric_limits<unsigned>::max();
+      unsigned maximum  = 0;
+      uint64_t nrPixels = 0;
+      for (unsigned y = yStart; y < yEnd; y++)
+        for (unsigned x = xStart; x < xEnd; x++)
+        {
+          const auto value = reader->at(x, y);
+          sum += value;
+          sumSq += uint64_t(value) * value;
+          minimum = std::min(minimum, value);
+          maximum = std::max(maximum, value);
+          ++nrPixels;
+        }
+
+      auto &stats = result[size_t(blockY) * blocksPerRow + blockX];
+      if (nrPixels == 0)
+        continue;
+      const double mean = double(sum) / double(nrPixels);
+      // E[x^2] - E[x]^2. Clamped because rounding can push it a hair below zero on a flat block.
+      const double variance = std::max(0.0, double(sumSq) / double(nrPixels) - mean * mean);
+      stats.mean            = float(mean);
+      stats.variance        = float(variance);
+      stats.minimum         = float(minimum);
+      stats.maximum         = float(maximum);
+    }
+  }
+
+  return result;
+}
+
+std::vector<uint32_t> computeLumaHistogram(const QByteArray                 &rawYUV,
+                                           const video::yuv::PixelFormatYUV &format,
+                                           const Size                       &frameSize)
+{
+  const auto reader = makeLumaReader(rawYUV, format, frameSize);
+  if (!reader)
+    return {};
+
+  // Always 256 bins so the shape is comparable regardless of bit depth.
+  const auto shift = (format.getBitsPerSample() > 8) ? (format.getBitsPerSample() - 8) : 0u;
+  std::vector<uint32_t> histogram(256, 0);
+  for (unsigned y = 0; y < frameSize.height; y++)
+    for (unsigned x = 0; x < frameSize.width; x++)
+    {
+      const auto bin = reader->at(x, y) >> shift;
+      ++histogram[std::min(bin, 255u)];
+    }
+  return histogram;
+}
+
+bool PixelStatisticsCache::open(const QString &sourceFilePath,
+                                const Size    &newFrameSize,
+                                unsigned       newBlockSize,
+                                int            newNrFrames,
+                                uint64_t       newParamHash)
+{
+  this->records.clear();
+  this->framePresent.clear();
+  this->filePath.clear();
+  this->nrFrames = 0;
+
+  if (newBlockSize == 0 || newNrFrames <= 0 || !newFrameSize.isValid())
+    return false;
+
+  this->frameSize       = newFrameSize;
+  this->blockSize       = newBlockSize;
+  this->nrFrames        = newNrFrames;
+  this->paramHash       = newParamHash;
+  this->blocksPerRow    = (newFrameSize.width + newBlockSize - 1) / newBlockSize;
+  this->blocksPerColumn = (newFrameSize.height + newBlockSize - 1) / newBlockSize;
+
+  this->records.assign(size_t(this->nrFrames) * this->getBlocksPerFrame(), PixelBlockStats{});
+  this->framePresent.assign((size_t(this->nrFrames) + 7) / 8, 0);
+
+  // A missing cache directory only costs persistence: the in-memory cache above is already usable, so
+  // there is no second code path for callers.
+  if (const auto directory = BDCachePaths::itemDirectory(sourceFilePath); !directory.isEmpty())
+  {
+    /* The parameter hash goes into the file name, not just the header: that way each pixel format and
+     * filter combination keeps its own cache, so toggling the convolution filter back and forth reuses
+     * what was already computed instead of discarding it every time.
+     */
+    this->filePath = directory + QStringLiteral("/blockstats-%1.bin")
+                                     .arg(QString::number(newParamHash, 16));
+    if (!this->readExisting())
+      this->writeHeaderAndBitmap();
+  }
+  return true;
+}
+
+int64_t PixelStatisticsCache::frameOffsetInFile(int frameIdx) const
+{
+  const int64_t bitmapBytes = int64_t(this->framePresent.size());
+  return HEADER_BYTES + bitmapBytes +
+         int64_t(frameIdx) * this->getBlocksPerFrame() * int64_t(sizeof(PixelBlockStats));
+}
+
+void PixelStatisticsCache::writeHeaderAndBitmap()
+{
+  if (this->filePath.isEmpty())
+    return;
+  QFile file(this->filePath);
+  if (!file.open(QIODevice::WriteOnly | QIODevice::Truncate))
+  {
+    this->filePath.clear();
+    return;
+  }
+
+  QByteArray header(HEADER_BYTES, '\0');
+  auto      *p = header.data();
+  std::memcpy(p, CACHE_MAGIC, sizeof(CACHE_MAGIC));
+  const uint32_t u32[7] = {PIXEL_STATS_CACHE_VERSION,
+                           this->blockSize,
+                           this->frameSize.width,
+                           this->frameSize.height,
+                           this->blocksPerRow,
+                           this->blocksPerColumn,
+                           uint32_t(this->nrFrames)};
+  std::memcpy(p + 8, u32, sizeof(u32));
+  std::memcpy(p + 8 + sizeof(u32), &this->paramHash, sizeof(this->paramHash));
+  const uint32_t fieldsPerBlock = 4;
+  std::memcpy(p + 8 + sizeof(u32) + sizeof(this->paramHash), &fieldsPerBlock, sizeof(uint32_t));
+
+  file.write(header);
+  file.write(reinterpret_cast<const char *>(this->framePresent.data()),
+             qint64(this->framePresent.size()));
+  // The record area is left as a hole: only visited frames are ever written, so on a file system with
+  // sparse file support the cache costs what was actually computed.
+}
+
+bool PixelStatisticsCache::readExisting()
+{
+  if (this->filePath.isEmpty())
+    return false;
+  QFile file(this->filePath);
+  if (!file.open(QIODevice::ReadOnly))
+    return false;
+
+  const auto header = file.read(HEADER_BYTES);
+  if (header.size() != HEADER_BYTES)
+    return false;
+  if (std::memcmp(header.constData(), CACHE_MAGIC, sizeof(CACHE_MAGIC)) != 0)
+    return false;
+
+  uint32_t u32[7];
+  uint64_t storedHash{};
+  std::memcpy(u32, header.constData() + 8, sizeof(u32));
+  std::memcpy(&storedHash, header.constData() + 8 + sizeof(u32), sizeof(storedHash));
+
+  // Anything different means the numbers in the file describe other data. Start over rather than
+  // showing statistics that do not belong to what is on screen.
+  if (u32[0] != PIXEL_STATS_CACHE_VERSION || u32[1] != this->blockSize ||
+      u32[2] != this->frameSize.width || u32[3] != this->frameSize.height ||
+      u32[4] != this->blocksPerRow || u32[5] != this->blocksPerColumn ||
+      u32[6] != uint32_t(this->nrFrames) || storedHash != this->paramHash)
+    return false;
+
+  const auto bitmap = file.read(qint64(this->framePresent.size()));
+  if (bitmap.size() != qint64(this->framePresent.size()))
+    return false;
+  std::memcpy(this->framePresent.data(), bitmap.constData(), this->framePresent.size());
+
+  // Only read back the frames the bitmap says are there.
+  const auto frameBytes = qint64(this->getBlocksPerFrame() * sizeof(PixelBlockStats));
+  for (int frameIdx = 0; frameIdx < this->nrFrames; frameIdx++)
+  {
+    if (!this->has(frameIdx))
+      continue;
+    if (!file.seek(this->frameOffsetInFile(frameIdx)))
+      return false;
+    const auto data = file.read(frameBytes);
+    if (data.size() != frameBytes)
+      return false;
+    std::memcpy(this->records.data() + size_t(frameIdx) * this->getBlocksPerFrame(),
+                data.constData(),
+                size_t(frameBytes));
+  }
+  return true;
+}
+
+bool PixelStatisticsCache::has(int frameIdx) const
+{
+  if (frameIdx < 0 || frameIdx >= this->nrFrames)
+    return false;
+  return (this->framePresent[size_t(frameIdx) / 8] >> (frameIdx % 8)) & 1;
+}
+
+std::optional<PixelBlockStats> PixelStatisticsCache::at(int frameIdx, const QPoint &pixelPos) const
+{
+  if (!this->has(frameIdx) || this->blockSize == 0)
+    return {};
+  if (pixelPos.x() < 0 || pixelPos.y() < 0)
+    return {};
+  const auto blockX = unsigned(pixelPos.x()) / this->blockSize;
+  const auto blockY = unsigned(pixelPos.y()) / this->blockSize;
+  if (blockX >= this->blocksPerRow || blockY >= this->blocksPerColumn)
+    return {};
+  return this->records[size_t(frameIdx) * this->getBlocksPerFrame() +
+                       size_t(blockY) * this->blocksPerRow + blockX];
+}
+
+void PixelStatisticsCache::store(int frameIdx, const std::vector<PixelBlockStats> &blocks)
+{
+  if (frameIdx < 0 || frameIdx >= this->nrFrames)
+    return;
+  if (blocks.size() != this->getBlocksPerFrame())
+    // The frame was computed with other parameters than the ones this cache was opened with.
+    return;
+
+  std::copy(blocks.begin(),
+            blocks.end(),
+            this->records.begin() + int64_t(frameIdx) * this->getBlocksPerFrame());
+  this->framePresent[size_t(frameIdx) / 8] |= uint8_t(1u << (frameIdx % 8));
+
+  if (this->filePath.isEmpty())
+    return;
+  QFile file(this->filePath);
+  if (!file.open(QIODevice::ReadWrite))
+    return;
+  // Records first, present bit last. If we are interrupted in between, the next run sees the frame as
+  // absent and recomputes it. The other order would leave a frame marked present with zeroed
+  // statistics, which would be shown as if it were real.
+  if (!file.seek(this->frameOffsetInFile(frameIdx)))
+    return;
+  file.write(reinterpret_cast<const char *>(blocks.data()),
+             qint64(blocks.size() * sizeof(PixelBlockStats)));
+  if (!file.seek(HEADER_BYTES + qint64(frameIdx) / 8))
+    return;
+  file.write(reinterpret_cast<const char *>(&this->framePresent[size_t(frameIdx) / 8]), 1);
+}
+
+void PixelStatisticsCache::reset()
+{
+  if (!this->filePath.isEmpty())
+    QFile::remove(this->filePath);
+  this->records.clear();
+  this->framePresent.clear();
+  this->filePath.clear();
+  this->nrFrames = 0;
+}
+
+} // namespace stats
