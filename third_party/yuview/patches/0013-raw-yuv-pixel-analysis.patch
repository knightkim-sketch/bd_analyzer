+
+#include "HistogramWidget.h"
+
+#include <QPainter>
+#include <QPaintEvent>
+
+#include <algorithm>
+
+HistogramWidget::HistogramWidget(QWidget *parent) : QWidget(parent)
+{
+  this->setSizePolicy(QSizePolicy::Expanding, QSizePolicy::Fixed);
+}
+
+void HistogramWidget::setHistogram(const std::vector<uint32_t> &newBins)
+{
+  this->bins       = newBins;
+  this->maximumBin = this->bins.empty() ? 0 : *std::max_element(this->bins.begin(), this->bins.end());
+  this->update();
+}
+
+void HistogramWidget::setPlaceholderText(const QString &text)
+{
+  if (this->placeholder == text)
+    return;
+  this->placeholder = text;
+  this->update();
+}
+
+void HistogramWidget::paintEvent(QPaintEvent *)
+{
+  QPainter painter(this);
+  const auto area = this->rect().adjusted(0, 0, -1, -1);
+
+  painter.fillRect(area, this->palette().base());
+  painter.setPen(this->palette().mid().color());
+  painter.drawRect(area);
+
+  if (this->bins.empty() || this->maximumBin == 0)
+  {
+    if (!this->placeholder.isEmpty())
+    {
+      painter.setPen(this->palette().placeholderText().color());
+      painter.drawText(area, Qt::AlignCenter | Qt::TextWordWrap, this->placeholder);
+    }
+    return;
+  }
+
+  const auto plot = area.adjusted(1, 1, -1, -1);
+  if (plot.width() <= 0 || plot.height() <= 0)
+    return;
+
+  /* One column of pixels per bin would need 256 px of width, which the pane does not always have.
+   * Draw one bar per pixel column and take the largest bin that falls into it, so a narrow widget
+   * still shows the peaks rather than dropping them.
+   */
+  painter.setPen(Qt::NoPen);
+  painter.setBrush(this->palette().highlight());
+  const auto nrBins = int(this->bins.size());
+  for (int x = 0; x < plot.width(); x++)
+  {
+    const auto firstBin = int(int64_t(x) * nrBins / plot.width());
+    const auto lastBin  = std::max(firstBin, int(int64_t(x + 1) * nrBins / plot.width()) - 1);
+    uint32_t   peak     = 0;
+    for (int bin = firstBin; bin <= lastBin && bin < nrBins; bin++)
+      peak = std::max(peak, this->bins[size_t(bin)]);
+    if (peak == 0)
+      continue;
+    const auto barHeight =
+        std::max(1, int(int64_t(peak) * plot.height() / int64_t(this->maximumBin)));
+    painter.drawRect(plot.left() + x, plot.bottom() - barHeight + 1, 1, barHeight);
+  }
+}
