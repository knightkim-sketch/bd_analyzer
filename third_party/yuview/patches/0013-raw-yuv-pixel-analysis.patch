+
+/* Per-block statistics of the luma plane, and their on-disk cache.
+ *
+ * These describe the *pixels*, not the coding syntax - that is what statistics/StatisticsData.h and
+ * BlockInfo.h are for. Kept apart deliberately: coding statistics come from a decoder, these are
+ * computed from the samples and exist for raw YUV too.
+ */
+namespace stats
+{
+
+/* One block's luma statistics. Stored as four float32 (16 bytes) so that the record size does not
+ * depend on the bit depth. Adding a field means bumping PIXEL_STATS_CACHE_VERSION, which makes
+ * existing cache files be discarded and recomputed.
+ */
+struct PixelBlockStats
+{
+  float mean{};
+  float variance{};
+  float minimum{};
+  float maximum{};
+};
+static_assert(sizeof(PixelBlockStats) == 16, "the on-disk record layout depends on this");
+
+//!< Bump when the record layout or the meaning of a field changes.
+constexpr uint32_t PIXEL_STATS_CACHE_VERSION = 1;
+
+/* Statistics of every blockSize x blockSize block of the luma plane, row major (left to right, top to
+ * bottom). Blocks at the right/bottom border are clipped to the picture, so their statistics only
+ * cover the pixels that exist.
+ *
+ * Returns an empty vector for formats this cannot read (packed formats, byte packing). Callers must
+ * treat that as "no statistics available" rather than an error - it is a normal outcome for an exotic
+ * pixel format.
+ *
+ * Pure and thread safe: it only reads its arguments, so it can run on a worker thread while the GUI
+ * thread carries on. rawYUV must be a full frame in the given format.
+ */
+std::vector<PixelBlockStats> computeLumaBlockStats(const QByteArray                 &rawYUV,
+                                                   const video::yuv::PixelFormatYUV &format,
+                                                   const Size                       &frameSize,
+                                                   unsigned                          blockSize);
+
+/* 256 bin histogram of the luma plane. Values are scaled down to 256 bins for bit depths above 8, so
+ * the bin index is comparable across bit depths. Empty for formats that cannot be read.
+ */
+std::vector<uint32_t> computeLumaHistogram(const QByteArray                 &rawYUV,
+                                           const video::yuv::PixelFormatYUV &format,
+                                           const Size                       &frameSize);
+
+/* The per-frame block statistics of one source file, held in memory and backed by a file under
+ * .YUViewBD so it survives a restart and fills up as frames are visited.
+ *
+ * Not thread safe. Use it from one thread only (the GUI thread); computeLumaBlockStats() is the part
+ * that is meant to run in the background.
+ */
+class PixelStatisticsCache
+{
+public:
+  /* Bind the cache to a source file. An existing file whose header does not match exactly (frame
+   * size, block size, frame count, version, or paramHash) is discarded and started over - stale
+   * statistics are worse than none.
+   *
+   * paramHash must cover everything that changes the sample values: the pixel format and the
+   * convolution filter. See playlistItemRawFile::pixelStatsParamHash().
+   *
+   * Returns false only when the parameters are unusable. A missing cache directory is not a failure:
+   * the cache then works in memory only, which callers do not have to handle separately.
+   */
+  bool open(const QString                    &sourceFilePath,
+            const Size                       &frameSize,
+            unsigned                          blockSize,
+            int                               nrFrames,
+            uint64_t                          paramHash);
+
+  bool     isOpen() const { return this->nrFrames > 0; }
+  unsigned getBlockSize() const { return this->blockSize; }
+  unsigned getBlocksPerRow() const { return this->blocksPerRow; }
+  unsigned getBlocksPerColumn() const { return this->blocksPerColumn; }
+  unsigned getBlocksPerFrame() const { return this->blocksPerRow * this->blocksPerColumn; }
+
+  bool has(int frameIdx) const;
+
+  //!< The block containing the given luma pixel position, or nothing if not computed yet.
+  std::optional<PixelBlockStats> at(int frameIdx, const QPoint &pixelPos) const;
+
+  //!< Take a computed frame into memory and append it to the file.
+  void store(int frameIdx, const std::vector<PixelBlockStats> &blocks);
+
+  //!< Drop everything, in memory and on disk. Used when the parameters change.
+  void reset();
+
+  QString getFilePath() const { return this->filePath; }
+
+private:
+  int64_t frameOffsetInFile(int frameIdx) const;
+  void    writeHeaderAndBitmap();
+  bool    readExisting();
+
+  QString  filePath;
+  Size     frameSize{};
+  unsigned blockSize{};
+  unsigned blocksPerRow{};
+  unsigned blocksPerColumn{};
+  int      nrFrames{};
+  uint64_t paramHash{};
+
+  std::vector<PixelBlockStats> records;      //!< nrFrames * blocksPerFrame, row major per frame
+  std::vector<uint8_t>         framePresent; //!< bit per frame
+};
+
+} // namespace stats
