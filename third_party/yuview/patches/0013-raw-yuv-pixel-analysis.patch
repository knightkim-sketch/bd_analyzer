+#include <vector>
+
+/* A 256 bin bar graph, drawn directly in paintEvent().
+ *
+ * Deliberately not a charting library: the deployment bundle should not grow a dependency (and Qt
+ * Charts is not part of the Qt install used here) for what is a few lines of painting.
+ */
+class HistogramWidget : public QWidget
+{
+  Q_OBJECT
+
+public:
+  explicit HistogramWidget(QWidget *parent = nullptr);
+
+  //!< Empty clears the graph. Any bin count is accepted; 256 is what the luma histogram produces.
+  void setHistogram(const std::vector<uint32_t> &bins);
+
+  //!< Shown centered when there is nothing to draw.
+  void setPlaceholderText(const QString &text);
+
+  QSize minimumSizeHint() const override { return QSize(120, 70); }
+  QSize sizeHint() const override { return QSize(256, 90); }
+
+protected:
+  void paintEvent(QPaintEvent *event) override;
+
+private:
+  std::vector<uint32_t> bins;
+  uint32_t              maximumBin{};
+  QString               placeholder{};
+};
