+#pragma once
+
+#include <QString>
+
+/* Where YUView puts the data it derives from a source file and can recreate at any time: decoded YUV
+ * and per-block analysis statistics.
+ *
+ * The requested location is ".YUViewBD" next to the executable, so a portable install keeps its
+ * cache with it. That directory is not writable in every deployment (an AppImage mount, a read-only
+ * install prefix), so the first call probes it once and falls back to the user cache directory. The
+ * fallback can be overridden with the setting "BDCache/directory".
+ *
+ * Everything under the root is disposable. The user is asked on exit whether to delete it.
+ */
+namespace BDCachePaths
+{
+
+/* The cache root, created if needed. Empty if neither the executable directory nor the fallback is
+ * usable - callers must treat that as "caching unavailable" and carry on without it.
+ */
+QString root();
+
+/* A per-item subdirectory of root(), created if needed. Keyed on the source file path so the same
+ * file reuses its cache across sessions, with the file name kept in the directory name to make the
+ * cache browsable by hand. Empty if the directory could not be created.
+ */
+QString itemDirectory(const QString &sourceFilePath);
+
+//!< Number of files and total bytes below root(). For the deletion prompt.
+struct Usage
+{
+  int     fileCount{};
+  int64_t totalBytes{};
+};
+Usage usage();
+
+//!< Delete the whole cache root. Returns false if anything could not be removed.
+bool clear();
+
+} // namespace BDCachePaths
