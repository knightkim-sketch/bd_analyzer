+#include "BDCachePaths.h"
+
+#include <QCoreApplication>
+#include <QCryptographicHash>
+#include <QDir>
+#include <QDirIterator>
+#include <QFileInfo>
+#include <QRegularExpression>
+#include <QSettings>
+#include <QStandardPaths>
+#include <QTemporaryFile>
+
+namespace BDCachePaths
+{
+namespace
+{
+
+const QString CACHE_DIR_NAME = QStringLiteral(".YUViewBD");
+
+bool isWritable(const QString &path)
+{
+  QDir dir;
+  if (!dir.mkpath(path))
+    return false;
+  // mkpath succeeding does not prove we may create files in it (read-only mount, restrictive ACL),
+  // so actually try. QTemporaryFile removes itself.
+  QTemporaryFile probe(path + QStringLiteral("/.writeprobeXXXXXX"));
+  return probe.open();
+}
+
+/* Resolved once per run: probing the file system on every call would be wasteful and the answer
+ * cannot change while we run. An empty result means caching is unavailable.
+ */
+QString resolveRoot()
+{
+  QSettings settings;
+  if (const auto configured = settings.value("BDCache/directory").toString(); !configured.isEmpty())
+    return isWritable(configured) ? configured : QString();
+
+  const auto preferred = QCoreApplication::applicationDirPath() + "/" + CACHE_DIR_NAME;
+  if (isWritable(preferred))
+    return preferred;
+
+  // Deployed read-only (AppImage, system prefix). Keep working, just somewhere else.
+  const auto fallbackBase = QStandardPaths::writableLocation(QStandardPaths::CacheLocation);
+  if (fallbackBase.isEmpty())
+    return {};
+  const auto fallback = fallbackBase + QStringLiteral("/YUViewBD");
+  return isWritable(fallback) ? fallback : QString();
+}
+
+} // namespace
+
+QString root()
+{
+  static const QString resolved = resolveRoot();
+  return resolved;
+}
+
+QString itemDirectory(const QString &sourceFilePath)
+{
+  const auto cacheRoot = root();
+  if (cacheRoot.isEmpty())
+    return {};
+
+  const auto absolute = QFileInfo(sourceFilePath).absoluteFilePath();
+  const auto hash     = QCryptographicHash::hash(absolute.toUtf8(), QCryptographicHash::Sha1)
+                        .toHex()
+                        .left(12);
+  // The file name is only there to make the directory recognizable; the hash is what identifies it.
+  auto name = QFileInfo(absolute).fileName();
+  name.replace(QRegularExpression(QStringLiteral("[^A-Za-z0-9._-]")), QStringLiteral("_"));
+  const auto dir = cacheRoot + "/" + name + "-" + QString::fromUtf8(hash);
+
+  QDir d;
+  if (!d.mkpath(dir))
+    return {};
+  return dir;
+}
+
+Usage usage()
+{
+  Usage result;
+  const auto cacheRoot = root();
+  if (cacheRoot.isEmpty())
+    return result;
+
+  QDirIterator it(cacheRoot, QDir::Files, QDirIterator::Subdirectories);
+  while (it.hasNext())
+  {
+    it.next();
+    ++result.fileCount;
+    result.totalBytes += it.fileInfo().size();
+  }
+  return result;
+}
+
+bool clear()
+{
+  const auto cacheRoot = root();
+  if (cacheRoot.isEmpty())
+    return true;
+  QDir dir(cacheRoot);
+  if (!dir.exists())
+    return true;
+  return dir.removeRecursively();
+}
+
+} // namespace BDCachePaths
