+bool playlistItemWithVideo::setOriginalYUVSource(const QString &filePath, QString *error)
+{
+  const auto setError = [error](const QString &text)
+  {
+    if (error)
+      *error = text;
+    return false;
+  };
+
+  const auto wasAttached = !this->originalYUVPath.isEmpty();
+  /* Any outcome other than "the new file is usable" leaves nothing attached. Keeping the previous one
+   * is not an option: openFile() has already closed it, and a path that no longer matches the open
+   * file would be hashed into the cache key while the SSE is computed against something else.
+   */
+  this->originalYUVPath.clear();
+
+  const auto forget = [this, wasAttached]
+  {
+    /* Nothing to show any more, so the view has to go back to the reconstruction - otherwise it would
+     * keep drawing the frame of a file that is no longer attached.
+     */
+    this->originalVideo.reset();
+    if (this->displaySource != DisplaySource::Reconstruction)
+    {
+      this->displaySource = DisplaySource::Reconstruction;
+      emit SignalItemChanged(true, RECACHE_NONE);
+    }
+
+    // Every block record carries an SSE, so the values computed under the previous setting describe a
+    // comparison that is no longer configured. The next request recomputes them, under a new
+    // parameter hash - see pixelStatsParamHash().
+    if (!wasAttached)
+      return;
+    this->pixelStatsCache.reset();
+    this->pixelStatsCacheParamHash = 0;
+  };
+
+  if (filePath.isEmpty())
+  {
+    forget();
+    return true;
+  }
+
+  if (!this->supportsPixelStatistics())
+  {
+    forget();
+    return setError("This item has no raw YUV pixels to compare.");
+  }
+
+  const auto bytesPerFrame = this->getYUVVideo()->getBytesPerFrame();
+  if (bytesPerFrame <= 0)
+  {
+    forget();
+    return setError("The pixel format of this item is not known yet.");
+  }
+
+  if (!this->originalYUVFile.openFile(filePath.toStdString()))
+  {
+    forget();
+    return setError(QString("Cannot open %1.").arg(filePath));
+  }
+
+  const auto fileSize = this->originalYUVFile.getFileSize().value_or(0);
+  if (fileSize < bytesPerFrame)
+  {
+    forget();
+    return setError(QString("%1 is smaller than one %2x%3 frame (%4 bytes) of this item.")
+                        .arg(filePath)
+                        .arg(this->getYUVVideo()->getFrameSize().width)
+                        .arg(this->getYUVVideo()->getFrameSize().height)
+                        .arg(bytesPerFrame));
+  }
+
+  this->originalYUVPath = filePath;
+
+  /* A handler of its own so the original can be shown in the view without touching the item's own
+   * buffer. It is read with this item's size and format - it is the source this item was coded from.
+   */
+  this->originalVideo = std::make_unique<video::yuv::videoHandlerYUV>();
+  this->originalVideo->setFrameSize(this->getYUVVideo()->getFrameSize());
+  this->originalVideo->setPixelFormatYUV(this->getYUVVideo()->getPixelFormatYUV());
+  connect(this->originalVideo.get(),
+          &video::videoHandler::signalRequestRawData,
+          this,
+          [this](int frameIdx, bool) { this->loadOriginalRawData(frameIdx); },
+          Qt::DirectConnection);
+
+  // As in forget(): what was computed before carries the wrong SSE, or none at all.
+  this->pixelStatsCache.reset();
+  this->pixelStatsCacheParamHash = 0;
+  return true;
+}
+
+QByteArray playlistItemWithVideo::readOriginalYUVFrame(int frameIdx)
+{
+  if (this->originalYUVPath.isEmpty() || frameIdx < 0 || !this->originalYUVFile.isOk() ||
+      !this->supportsPixelStatistics())
+    return {};
+  const auto bytesPerFrame = this->getYUVVideo()->getBytesPerFrame();
+  if (bytesPerFrame <= 0)
+    return {};
+
+  QByteArray frame;
+  if (this->originalYUVFile.readBytes(frame, int64_t(frameIdx) * bytesPerFrame, bytesPerFrame) <
+      bytesPerFrame)
+    // The original is shorter than this item, so this frame has nothing to compare against.
+    return {};
+  return frame;
 }
 
