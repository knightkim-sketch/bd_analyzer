+void BlockInfoWidget::setCurrentFrame(playlistItem *item, int frameIdx)
+{
+  if (!this->selectedItem)
+    // Nothing has been clicked, so there is no position whose syntax could be re-read.
+    return;
+  if (this->selectedItem != item)
+  {
+    // The view moved to a different item. The stored click belongs to the old one.
+    this->setSelectedBlock(nullptr, QPoint(), -1);
+    return;
+  }
+  /* The view announces a frame change before that frame has been decoded, and again once the data is
+   * there. That repeat is the only chance to fill the pane, so it must not be dismissed as "nothing
+   * changed" while the values on screen still come from another frame. Same reasoning as
+   * FrameInfoWidget::setCurrentFrame.
+   */
+  if (this->selectedFrameIdx == frameIdx && this->shownFrameIdx == frameIdx)
+    return;
+  this->selectedFrameIdx = frameIdx;
+  this->refresh();
+}
