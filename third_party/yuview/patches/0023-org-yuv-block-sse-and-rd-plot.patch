+video::videoHandler *playlistItemWithVideo::videoToDisplay(int frameIdx)
+{
+  if (this->displaySource != DisplaySource::Original || !this->originalVideo)
+    return this->video.get();
+
+  /* Keep the original's handler in step with the item's own: the pixel format and the size can be
+   * changed in the properties panel after the original was attached, and the original is read with
+   * exactly those.
+   */
+  const auto handler = this->getYUVVideo();
+  if (this->originalVideo->getFrameSize() != handler->getFrameSize() ||
+      this->originalVideo->getPixelFormatYUV() != handler->getPixelFormatYUV())
+  {
+    this->originalVideo->setFrameSize(handler->getFrameSize());
+    this->originalVideo->setPixelFormatYUV(handler->getPixelFormatYUV());
+    this->originalVideo->invalidateAllBuffers();
+  }
+
+  /* Nothing loads for this handler in the background - the loading thread serves the item's own video
+   * - so fetch the frame here. It is one sequential read plus one conversion, on a file the user
+   * pointed at for exactly this purpose.
+   */
+  if (this->originalVideo->needsLoading(frameIdx, false) == ItemLoadingState::LoadingNeeded)
+    this->originalVideo->loadFrame(frameIdx);
+  return this->originalVideo.get();
+}
+
+bool playlistItemWithVideo::setDisplaySource(DisplaySource source)
+{
+  if (source == this->displaySource)
+    return true;
+  if (source == DisplaySource::Original && !this->originalVideo)
+    // Nothing attached to show.
+    return false;
+
+  this->displaySource = source;
+  // Only the picture changes, so nothing needs to be decoded or measured again.
+  emit SignalItemChanged(true, RECACHE_NONE);
+  return true;
+}
