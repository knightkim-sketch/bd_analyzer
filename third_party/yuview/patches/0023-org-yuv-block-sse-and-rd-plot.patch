+namespace
+{
+// Room for the axis labels around the plot area.
+constexpr int MARGIN_LEFT   = 62;
+constexpr int MARGIN_RIGHT  = 8;
+constexpr int MARGIN_TOP    = 22;
+constexpr int MARGIN_BOTTOM = 30;
+
+//!< A round number at or above value, so the axis ends somewhere readable.
+double niceUpperBound(double value)
+{
+  if (value <= 0.0)
+    return 1.0;
+  const auto magnitude = std::pow(10.0, std::floor(std::log10(value)));
+  for (const auto step : {1.0, 2.0, 2.5, 5.0, 10.0})
+    if (value <= step * magnitude)
+      return step * magnitude;
+  return 10.0 * magnitude;
+}
+
+QString axisNumber(double value)
+{
+  if (value >= 1000000.0)
+    return QString::number(value / 1000000.0, 'g', 3) + "M";
+  if (value >= 1000.0)
+    return QString::number(value / 1000.0, 'g', 3) + "k";
+  return QString::number(value, 'g', 3);
+}
+} // namespace
+
+RateDistortionPlotWidget::RateDistortionPlotWidget(QWidget *parent) : QWidget(parent)
+{
+  this->message = "Select a stream to plot its superblocks.";
+}
+
+void RateDistortionPlotWidget::setItem(playlistItem *newItem)
+{
+  if (this->item == newItem)
+    return;
+  this->item = newItem;
+  if (newItem)
+    // UniqueConnection so re-selecting the same item does not stack connections.
+    connect(newItem,
+            &playlistItem::pixelStatisticsReady,
+            this,
+            &RateDistortionPlotWidget::pixelStatisticsReady,
+            Qt::UniqueConnection);
+}
+
+void RateDistortionPlotWidget::setCurrentFrame(playlistItem *newItem, int newFrameIdx)
+{
+  /* The view announces a frame change before it is decoded and again once the data is there. The
+   * repeat is the only chance to fill the plot, so it must not be dismissed while the points on screen
+   * still belong to another frame. Same reasoning as in FrameInfoWidget::setCurrentFrame.
+   */
+  if (this->item == newItem && this->frameIdx == newFrameIdx && this->shownFrameIdx == newFrameIdx)
+    return;
+  this->setItem(newItem);
+  this->frameIdx = newFrameIdx;
+  this->refresh();
+}
+
+void RateDistortionPlotWidget::currentSelectedItemsChanged(playlistItem *item1, playlistItem *item2)
+{
+  if (this->item && this->item != item1 && this->item != item2)
+  {
+    this->setItem(nullptr);
+    this->frameIdx = -1;
+    this->refresh();
+  }
+}
+
+void RateDistortionPlotWidget::pixelStatisticsReady(int readyFrameIdx)
+{
+  if (readyFrameIdx == this->frameIdx)
+    this->refresh();
+}
+
+void RateDistortionPlotWidget::refresh()
+{
+  this->collect();
+  this->update();
+}
+
+void RateDistortionPlotWidget::collect()
+{
+  this->points.clear();
+  this->shownFrameIdx = -1;
+  this->maxBits       = 0.0;
+  this->maxSse        = 0.0;
+
+  auto *currentItem = this->item.data();
+  if (!currentItem || this->frameIdx < 0)
+  {
+    this->message = "Select a stream to plot its superblocks.";
+    return;
+  }
+
+  const auto bits = currentItem->getSuperblockBits(this->frameIdx);
+  if (bits.empty())
+  {
+    this->message = QString("No superblock bit counts for frame %1. Click a block in the view, or "
+                            "switch on a statistics overlay, so the bitstream statistics are "
+                            "collected.")
+                        .arg(this->frameIdx);
+    return;
+  }
+  if (currentItem->getOriginalYUVSource().isEmpty())
+  {
+    this->message = "No original attached. Use \"Load Org YUV\" to get an SSE per superblock.";
+    return;
+  }
+
+  auto waitingForStatistics = false;
+  for (const auto &superblock : bits)
+  {
+    const auto blockStats = currentItem->getPixelBlockStats(superblock.rect.topLeft(), this->frameIdx);
+    if (!blockStats)
+    {
+      waitingForStatistics = true;
+      continue;
+    }
+    if (blockStats->sse < 0.0)
+      // Measured before the original was attached.
+      continue;
+    this->points.push_back({double(superblock.bits), blockStats->sse});
+    this->maxBits = std::max(this->maxBits, double(superblock.bits));
+    this->maxSse  = std::max(this->maxSse, blockStats->sse);
+  }
+
+  if (this->points.empty())
+  {
+    if (waitingForStatistics)
+    {
+      // The whole frame is computed in one background pass; pixelStatisticsReady() brings us back.
+      currentItem->requestPixelStatistics(this->frameIdx);
+      this->message = QString("Computing the SSE of frame %1...").arg(this->frameIdx);
+    }
+    else
+      this->message = QString("No SSE for frame %1 yet.").arg(this->frameIdx);
+    return;
+  }
+  this->shownFrameIdx = this->frameIdx;
+}
+
+void RateDistortionPlotWidget::paintEvent(QPaintEvent *)
+{
+  QPainter painter(this);
+  painter.fillRect(this->rect(), this->palette().color(QPalette::Base));
+
+  const auto textColor = this->palette().color(QPalette::WindowText);
+  painter.setPen(textColor);
+
+  if (this->points.empty())
+  {
+    painter.drawText(this->rect().adjusted(8, 8, -8, -8),
+                     Qt::AlignCenter | Qt::TextWordWrap,
+                     this->message);
+    return;
+  }
+
+  // Short, because this pane shares the bottom of the item view with the dump and can get narrow.
+  painter.drawText(QRect(MARGIN_LEFT, 2, this->width() - MARGIN_LEFT - MARGIN_RIGHT, MARGIN_TOP - 4),
+                   Qt::AlignLeft | Qt::AlignVCenter,
+                   QString("frame %1 - %2 SB").arg(this->shownFrameIdx).arg(this->points.size()));
+
+  const QRect plotArea(MARGIN_LEFT,
+                       MARGIN_TOP,
+                       std::max(1, this->width() - MARGIN_LEFT - MARGIN_RIGHT),
+                       std::max(1, this->height() - MARGIN_TOP - MARGIN_BOTTOM));
+
+  const auto xMax = niceUpperBound(this->maxBits);
+  const auto yMax = niceUpperBound(this->maxSse);
+
+  // Axes with one tick label at each end, so a point can be read off without a grid.
+  auto axisPen = QPen(textColor);
+  axisPen.setCosmetic(true);
+  painter.setPen(axisPen);
+  painter.drawLine(plotArea.bottomLeft(), plotArea.bottomRight());
+  painter.drawLine(plotArea.bottomLeft(), plotArea.topLeft());
+
+  auto gridPen = QPen(textColor);
+  gridPen.setStyle(Qt::DotLine);
+  gridPen.setCosmetic(true);
+  auto gridColor = textColor;
+  gridColor.setAlpha(60);
+  gridPen.setColor(gridColor);
+  painter.setPen(gridPen);
+  for (int i = 1; i <= 2; i++)
+  {
+    const auto y = plotArea.bottom() - plotArea.height() * i / 2;
+    const auto x = plotArea.left() + plotArea.width() * i / 2;
+    painter.drawLine(plotArea.left(), y, plotArea.right(), y);
+    painter.drawLine(x, plotArea.top(), x, plotArea.bottom());
+  }
+
+  painter.setPen(textColor);
+  const auto labelFlagsY = Qt::AlignRight | Qt::AlignVCenter;
+  painter.drawText(QRect(0, plotArea.top() - 7, MARGIN_LEFT - 4, 14), labelFlagsY, axisNumber(yMax));
+  painter.drawText(QRect(0, plotArea.center().y() - 7, MARGIN_LEFT - 4, 14),
+                   labelFlagsY,
+                   axisNumber(yMax / 2));
+  painter.drawText(QRect(0, plotArea.bottom() - 7, MARGIN_LEFT - 4, 14), labelFlagsY, "0");
+  painter.drawText(QRect(plotArea.left() - 10, plotArea.bottom() + 2, 40, 14),
+                   Qt::AlignLeft,
+                   "0");
+  painter.drawText(QRect(plotArea.center().x() - 30, plotArea.bottom() + 2, 60, 14),
+                   Qt::AlignCenter,
+                   axisNumber(xMax / 2));
+  painter.drawText(QRect(plotArea.right() - 60, plotArea.bottom() + 2, 60, 14),
+                   Qt::AlignRight,
+                   axisNumber(xMax));
+  painter.drawText(QRect(MARGIN_LEFT, this->height() - 15, plotArea.width(), 14),
+                   Qt::AlignCenter,
+                   "bits per superblock");
+  // The y axis label is rotated, so it fits in the left margin.
+  painter.save();
+  painter.translate(12, plotArea.center().y());
+  painter.rotate(-90);
+  painter.drawText(QRect(-60, -12, 120, 14), Qt::AlignCenter, "SSE (luma)");
+  painter.restore();
+
+  /* Semi transparent dots: superblocks cluster heavily near the origin (cheap and undistorted), and
+   * with opaque dots that cluster would read as a single blob of unknown weight.
+   */
+  auto pointColor = this->palette().color(QPalette::Highlight);
+  pointColor.setAlpha(160);
+  painter.setBrush(pointColor);
+  painter.setPen(Qt::NoPen);
+  for (const auto &point : this->points)
+  {
+    const auto x = plotArea.left() + int(std::lround(point.bits / xMax * plotArea.width()));
+    const auto y = plotArea.bottom() - int(std::lround(point.sse / yMax * plotArea.height()));
+    painter.drawEllipse(QPoint(x, y), 3, 3);
+  }
+}
