+std::vector<playlistItem::SuperblockBits>
+playlistItemCompressedVideo::getSuperblockBits(int frameIdx)
+{
+  if (!this->loadingDecoder || !this->loadingDecoder->statisticsSupported() ||
+      !this->loadingDecoder->statisticsEnabled())
+    return {};
+
+  const auto superblockSize = int(this->getDefaultGridSize());
+  if (superblockSize <= 0)
+    return {};
+
+  /* sb_bitcount is reported per coding block - every block of a superblock carries the superblock's
+   * total - so collapse the blocks onto the superblock grid. One entry per cell, keyed on the cell so
+   * a block reported more than once cannot add a second point.
+   */
+  std::map<std::pair<int, int>, SuperblockBits> perSuperblock;
+  {
+    std::unique_lock<std::mutex> lock(this->statisticsData.accessMutex);
+    // As in getBlockInfoAt(): the statistics can lag the displayed frame, and values from another
+    // frame would be plotted against this frame's SSE.
+    if (this->statisticsData.getFrameIndex() != frameIdx)
+      return {};
+    if (!this->statisticsData.hasDataForTypeID(decoder::decoderDav1d::SB_BITCOUNT_TYPE_ID))
+      return {};
+    for (const auto &block :
+         this->statisticsData.getFrameTypeData(decoder::decoderDav1d::SB_BITCOUNT_TYPE_ID).valueData)
+    {
+      const auto cellX = block.pos[0] / superblockSize;
+      const auto cellY = block.pos[1] / superblockSize;
+      perSuperblock[{cellX, cellY}] = SuperblockBits{
+          QRect(cellX * superblockSize, cellY * superblockSize, superblockSize, superblockSize),
+          unsigned(std::max(0, block.value))};
+    }
+  }
+
+  std::vector<SuperblockBits> result;
+  result.reserve(perSuperblock.size());
+  for (const auto &[cell, entry] : perSuperblock)
+    result.push_back(entry);
+  return result;
+}
