+#pragma once
+
+#include <QPoint>
+#include <QPointer>
+#include <QWidget>
+
+#include <vector>
+
+class playlistItem;
+
+/* Rate against distortion, one point per superblock of the displayed frame: x is what the bitstream
+ * spent on the superblock (sb_bitcount), y is the SSE of its pixels against the attached original.
+ *
+ * Both numbers already exist elsewhere in the window - the bit count in the statistics overlay, the
+ * SSE in the block statistics table - but only per block that was clicked. Plotting the whole frame
+ * at once is what shows where the encoder spent bits without buying quality, which is the point of
+ * loading an original in the first place.
+ *
+ * Needs both sides to be available: the bit counts come from the bitstream statistics (collected only
+ * while something asks for them, so a block has to be selected or an overlay switched on) and the SSE
+ * needs an original attached. The pane says which one is missing rather than drawing an empty box.
+ */
+class RateDistortionPlotWidget : public QWidget
+{
+  Q_OBJECT
+
+public:
+  explicit RateDistortionPlotWidget(QWidget *parent = nullptr);
+
+  QSize minimumSizeHint() const override { return QSize(220, 150); }
+
+public slots:
+  //!< Which item and frame the view is showing. From splitViewWidget::viewFrameChanged.
+  void setCurrentFrame(playlistItem *item, int frameIdx);
+  //!< The playlist selection changed. Clears when our item is no longer selected.
+  void currentSelectedItemsChanged(playlistItem *item1, playlistItem *item2);
+  //!< Re-read everything for the current item and frame.
+  void refresh();
+  //!< The background computation of the pixel statistics finished.
+  void pixelStatisticsReady(int frameIdx);
+
+protected:
+  void paintEvent(QPaintEvent *event) override;
+
+private:
+  //!< Gather the points, or set message when there is nothing to draw.
+  void collect();
+  void setItem(playlistItem *item);
+
+  struct Point
+  {
+    double bits{};
+    double sse{};
+  };
+
+  std::vector<Point>     points;
+  QString                message;
+  QPointer<playlistItem> item;
+  int                    frameIdx{-1};
+  //!< The frame the points on screen belong to, or -1 when there are none. See setCurrentFrame().
+  int                    shownFrameIdx{-1};
+  double                 maxBits{};
+  double                 maxSse{};
+};
