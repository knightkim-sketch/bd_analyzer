+void MainWindow::showOriginalYUVOpenDialog()
+{
+  /* The original belongs to one item - it is the source that item was coded from, and it is read with
+   * that item's frame size and pixel format. So it goes to the item that is selected, the same one
+   * the Frame Info pane reports on.
+   */
+  auto *item = ui.playlistTreeWidget->getSelectedItems()[0];
+  if (!item)
+  {
+    QMessageBox::information(this,
+                             "Load Org YUV",
+                             "Select the item to compare first, then load its original YUV.");
+    return;
+  }
+
+  QSettings settings;
+  auto      fileName = QFileDialog::getOpenFileName(this,
+                                               "Open the original (source) YUV",
+                                               settings.value("lastFilePath").toString(),
+                                               "Raw YUV files (*.yuv *.y4m);;All files (*)");
+  if (fileName.isEmpty())
+    return;
+  settings.setValue("lastFilePath", fileName.section('/', 0, -2));
+
+  QString error;
+  if (!item->setOriginalYUVSource(fileName, &error))
+  {
+    QMessageBox::warning(this, "Load Org YUV", error);
+    return;
+  }
+
+  /* The statistics of the frame on screen were dropped, so ask the pane to read them again. It finds
+   * nothing cached, requests a recomputation and shows the SSE when that reports back. The block
+   * syntax pane reads the same click, so keep the two in step.
+   */
+  ui.frameInfoWidget->refresh();
+  ui.blockInfoWidget->refresh();
+  // The plot has an SSE axis only once an original is attached, so it was showing a hint until now.
+  ui.rateDistortionPlot->refresh();
+  this->updateDisplaySourceComboBox();
+  ui.statusBar->showMessage(
+      QString("Original YUV of \"%1\": %2").arg(item->text(0), QFileInfo(fileName).fileName()),
+      5000);
+}
+
+void MainWindow::displaySourceComboBoxIndexChanged(int index)
+{
+  auto *item = ui.playlistTreeWidget->getSelectedItems()[0];
+  if (!item)
+    return;
+  const auto source = (index == 1) ? playlistItem::DisplaySource::Original
+                                   : playlistItem::DisplaySource::Reconstruction;
+  if (!item->setDisplaySource(source))
+  {
+    // No original attached, so there is nothing to switch to. Put the box back where it was.
+    this->updateDisplaySourceComboBox();
+    return;
+  }
+  // The item redraws itself (SignalItemChanged), the view has to pick the new picture up.
+  ui.displaySplitView->update();
+  separateViewWindow.splitView.update();
+}
+
+void MainWindow::updateDisplaySourceComboBox()
+{
+  auto *item = ui.playlistTreeWidget->getSelectedItems()[0];
+  const auto hasOriginal = item && !item->getOriginalYUVSource().isEmpty();
+
+  // Setting the index must not be taken for a user request to switch.
+  const QSignalBlocker blocker(ui.displaySourceComboBox);
+  ui.displaySourceComboBox->setEnabled(hasOriginal);
+  ui.displaySourceComboBox->setCurrentIndex(
+      item && item->getDisplaySource() == playlistItem::DisplaySource::Original ? 1 : 0);
+  ui.displaySourceComboBox->setToolTip(
+      hasOriginal ? QString("Show the reconstruction or the original (%1) in the viewer. The "
+                            "statistics, the histogram and the SSE always describe the "
+                            "reconstruction.")
+                        .arg(QFileInfo(item->getOriginalYUVSource()).fileName())
+                  : QString("Load an original YUV for the selected item to switch the viewer "
+                            "between reconstruction and original."));
+}
