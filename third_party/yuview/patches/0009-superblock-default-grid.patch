+
+bool splitViewWidget::fullCellGrid() const
+{
+  // Only the bitstream-derived grid describes real blocks, so only it may draw cells that reach
+  // outside the picture. A grid size the user picked is just a ruler and stays inside.
+  return !this->regularGridSizeUserSet;
+}
+
+QSize splitViewWidget::gridExtent(playlistItem *item) const
+{
+  const auto frameSize = item->getSize();
+  const auto cells     = [this](int length) {
+    return (length + this->regularGridSize - 1) / this->regularGridSize;
+  };
+  return QSize(cells(frameSize.width()), cells(frameSize.height()));
+}
+
+void splitViewWidget::paintRegularGridIndices(QPainter *painter, playlistItem *item)
+{
+  const auto frameSize = item->getSize();
+  const auto gridZoom  = this->regularGridSize * this->zoomFactor;
+  // Below this the labels of neighboring cells would touch and only add noise.
+  if (gridZoom < 16)
+    return;
+
+  const auto itemSize = frameSize * this->zoomFactor;
+  const auto xMin     = -itemSize.width() / 2;
+  const auto yMin     = -itemSize.height() / 2;
+
+  // The last row/column may be a partial cell; it still gets an index. When the cells are drawn at
+  // full size the label is centered in the full cell, otherwise only in the part inside the picture.
+  const auto extent  = this->gridExtent(item);
+  const bool fullCell = this->fullCellGrid();
+
+  const QFont indexFont = QFont(SPLITVIEWWIDGET_ZOOMFACTOR_FONT, 9);
+  painter->setFont(indexFont);
+  painter->setPen(this->gridColor());
+  const QFontMetrics metrics(indexFont);
+  const int          labelHeight = metrics.height();
+
+  // Column indices above the picture
+  for (int x = 0; x < extent.width(); x++)
+  {
+    const int cellStart = static_cast<int>(x * gridZoom);
+    int       cellEnd   = static_cast<int>((x + 1) * gridZoom);
+    if (!fullCell && cellEnd > itemSize.width())
+      cellEnd = itemSize.width();
+    const QRect textRect(
+        xMin + cellStart, yMin - labelHeight - 2, cellEnd - cellStart, labelHeight);
+    painter->drawText(textRect, Qt::AlignCenter, QString::number(x));
+  }
+
+  // Row indices left of the picture
+  const int labelWidth = metrics.horizontalAdvance(QString::number(extent.height() - 1)) + 4;
+  for (int y = 0; y < extent.height(); y++)
+  {
+    const int cellStart = static_cast<int>(y * gridZoom);
+    int       cellEnd   = static_cast<int>((y + 1) * gridZoom);
+    if (!fullCell && cellEnd > itemSize.height())
+      cellEnd = itemSize.height();
+    const QRect textRect(xMin - labelWidth - 2, yMin + cellStart, labelWidth, cellEnd - cellStart);
+    painter->drawText(textRect, Qt::AlignCenter, QString::number(y));
   }
 }
 
