+unsigned playlistItemCompressedVideo::getMaxBlockSize() const
+{
+  // The decoder only knows this once the sequence header was pushed, so this returns 0 until the
+  // first frame was decoded. Callers must be able to deal with that and ask again later.
+  QMutexLocker<QRecursiveMutex> locker(&this->decoderAccessMutex);
+  if (!this->loadingDecoder)
+    return 0;
+  return this->loadingDecoder->getMaxBlockSize();
+}
