+
+void splitViewWidget::applyDefaultGridSizeFromItem(playlistItem *item)
+{
+  if (this->regularGridSizeUserSet || !item)
+    return;
+
+  const auto maxBlockSize = item->getMaxBlockSize();
+  if (maxBlockSize == 0)
+    // Not an item with a known block size, or the sequence header was not parsed yet. Keep whatever
+    // we have; update() calls us again on the next frame/redraw.
+    return;
+
+  if (this->regularGridSize == static_cast<int>(maxBlockSize))
+    return;
+
+  this->setRegularGridSize(static_cast<int>(maxBlockSize), true, false, false);
+}
