 #include <algorithm>
 
+namespace
+{
+/* Push whatever the item already reports into the assistant panel.
+ *
+ * Nothing here decodes or measures: every value is one the item has computed for its own panels.
+ * The decoder label matters more than it looks - a stream on the FFmpeg fallback has no block
+ * statistics at all, and telling the assistant that up front is what stops it explaining numbers
+ * that were never produced.
+ */
+void pushAssistStream(AssistPanelWidget *panel, playlistItem *item)
+{
+  if (!panel)
+    return;
+  if (!item)
+  {
+    panel->setStream({}, 0, 0, 0, {}, {});
+    return;
+  }
+
+  const auto size       = item->getRawFrameSize();
+  const auto compressed = dynamic_cast<playlistItemCompressedVideo *>(item);
+  const auto decoder    = (compressed && compressed->providesSuperblockBits())
+                              ? QStringLiteral("dav1d analyzer (block statistics available)")
+                              : QStringLiteral("fallback (no block statistics)");
+
+  panel->setStream(item->properties().name,
+                   static_cast<int>(size.width),
+                   static_cast<int>(size.height),
+                   static_cast<int>(item->getDefaultGridSize()),
+                   decoder,
+                   item->getOriginalYUVSource());
+}
+} // namespace
+
 MainWindow::MainWindow(bool useAlternativeSources, QWidget *parent) : QMainWindow(parent)
 {
   Q_INIT_RESOURCE(images);
