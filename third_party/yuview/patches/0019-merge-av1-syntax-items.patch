+      [&info](int typeIDL0, int typeIDL1, const QString &mergedName) {
+        const auto find = [&info](int typeID) {
+          return std::find_if(info.entries.begin(),
+                              info.entries.end(),
+                              [typeID](const BlockInfoEntry &e) { return e.typeID == typeID; });
+        };
+        auto l0 = find(typeIDL0);
+        if (l0 == info.entries.end())
+          return;
+        l0->typeName  = mergedName;
+        l0->valueText = "L0 " + l0->valueText;
+        if (auto l1 = find(typeIDL1); l1 != info.entries.end())
+        {
+          l0->valueText += "  L1 " + l1->valueText;
+          info.entries.erase(l1);
+        }
+      };
+  mergeReferencePair(14, 15, "ref frame index");
