+/* The intra angle delta is folded into the intra prediction mode value so that one statistics type
+ * covers both. AV1 signals the delta in -3..3, but real streams have been seen outside that (see the
+ * bounds check in calculateIntraPredDirection), so the encoded range is one wider on each side and
+ * anything beyond is clamped rather than producing an out of range value.
+ */
+constexpr int INTRA_ANGLE_DELTA_MIN   = -4;
+constexpr int INTRA_ANGLE_DELTA_MAX   = 3;
+constexpr int INTRA_ANGLE_DELTA_COUNT = INTRA_ANGLE_DELTA_MAX - INTRA_ANGLE_DELTA_MIN + 1;
