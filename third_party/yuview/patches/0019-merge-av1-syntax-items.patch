+int intraModeAndDeltaToValue(int mode, int angleDelta)
+{
+  const auto clamped = std::clamp(angleDelta, INTRA_ANGLE_DELTA_MIN, INTRA_ANGLE_DELTA_MAX);
+  return mode * INTRA_ANGLE_DELTA_COUNT + (clamped - INTRA_ANGLE_DELTA_MIN);
+}
