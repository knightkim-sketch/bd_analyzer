+void MainWindow::compareBlockAt(playlistItem *item, QPoint pixelPos, int frameIdx)
+{
+  using bda::integration::MeCompareEntry;
+  if (item == nullptr || frameIdx < 0)
+    return;
+
+  const auto refuse = [this](const QString &why) {
+    QMessageBox::information(this, "ME block compare", why);
+  };
+  if (!item->supportsMotionEstimation())
+  {
+    refuse("This item has no raw source to compare: open a raw YUV file, or attach the original "
+           "YUV to the stream.");
+    return;
+  }
+
+  bda::me::YuvFrameLayout layout;
+  QString                 why;
+  if (!bda::integration::yuvLayoutFromRawFormat(
+          item->getRawPixelFormat(), item->getRawFrameSize(), layout, &why))
+  {
+    refuse(why);
+    return;
+  }
+
+  const auto source = item->readRawFrame(frameIdx);
+  QList<MeCompareEntry> entries;
+
+  // Block ME: every enabled size whose block covers the pixel, smallest first.
+  const auto &me     = this->meLastResult;
+  const auto *panel  = ui.motionEstimationWidget;
+  const auto  sizes  = panel->params().blockSizes;
+  if (panel->autoComputeEnabled() && this->meLastItem == item && me.ok() && me.frameIdx == frameIdx)
+  {
+    std::vector<const bda::me::MeBlockResult *> hits;
+    for (const auto &b : me.blocks)
+    {
+      const int n = bda::me::blockSizeInPixels(b.block.size);
+      if (sizes.contains(b.block.size) && QRect(b.block.x, b.block.y, n, n).contains(pixelPos))
+        hits.push_back(&b);
+    }
+    std::sort(hits.begin(), hits.end(), [](const auto *a, const auto *b) {
+      return a->block.size < b->block.size;
+    });
+    const auto reference = item->readRawFrame(me.refFrameIdx);
+    for (const auto *b : hits)
+    {
+      const int      n = bda::me::blockSizeInPixels(b->block.size);
+      MeCompareEntry e;
+      e.title = QString("ME %1x%1").arg(n);
+      // Whole-pixel part, truncated toward zero - how commonMetricSad reads the vector (MeCost).
+      e.dx     = b->mv.x / 8;
+      e.dy     = b->mv.y / 8;
+      e.rect   = {b->block.x, b->block.y, n, n};
+      e.source = source;
+      e.reference = reference;
+      e.detail = QString("Block at pixel (x, y) = (%1, %2), %3x%3. Frame %4 against reference "
+                         "frame %5. MV(x, y) = (%6, %7) px. The estimator reported common SAD %8.")
+                     .arg(b->block.x)
+                     .arg(b->block.y)
+                     .arg(n)
+                     .arg(frameIdx)
+                     .arg(me.refFrameIdx)
+                     .arg(e.dx)
+                     .arg(e.dy)
+                     .arg(b->commonSad);
+      entries.append(e);
+    }
+  }
+
+  // Global ME: the window covering the pixel, when the Global motion window has this frame.
+  if (this->globalMotionWindow && this->globalMotionWindow->target() == item && frameIdx > 0)
+  {
+    const auto results = this->globalMotionWindow->results();
+    const auto it      = results.find(frameIdx);
+    if (it != results.end() && it->second.ok())
+    {
+      const auto size = item->getRawFrameSize();
+      // Quarter-pel to whole pixels, rounded half away from zero.
+      const auto toPel = [](int q) { return q >= 0 ? (q + 2) / 4 : -((-q + 2) / 4); };
+      for (const auto &w : it->second.windows)
+      {
+        int x{}, y{}, ww{}, wh{};
+        bda::me::gmWindowSourceRect(
+            it->second, w, int(size.width), int(size.height), x, y, ww, wh);
+        if (!QRect(x, y, ww, wh).contains(pixelPos))
+          continue;
+        MeCompareEntry e;
+        // Grid position as (row, col).
+        e.title     = QString("GME window (%1, %2)").arg(w.winJ).arg(w.winI);
+        e.dx        = w.acceptX ? toPel(w.dxQpel) : 0;
+        e.dy        = w.acceptY ? toPel(w.dyQpel) : 0;
+        e.rect      = {x, y, ww, wh};
+        e.source    = source;
+        e.reference = item->readRawFrame(frameIdx - 1);
+        e.detail =
+            QString("Window at pixel (x, y) = (%1, %2), %3x%4. Frame %5 against the previous "
+                    "frame %6. Accepted MV(x, y) = (%7, %8) px, rounded from the raw "
+                    "quarter-pel MV(x, y) = (%9, %10); x %11, y %12.")
+                .arg(x)
+                .arg(y)
+                .arg(ww)
+                .arg(wh)
+                .arg(frameIdx)
+                .arg(frameIdx - 1)
+                .arg(e.dx)
+                .arg(e.dy)
+                .arg(w.dxQpel)
+                .arg(w.dyQpel)
+                .arg(w.acceptX ? "accepted" : "rejected")
+                .arg(w.acceptY ? "accepted" : "rejected");
+        entries.append(e);
+      }
+    }
+  }
+
+  if (entries.isEmpty())
+  {
+    refuse(QString("No motion estimation result covers pixel (x, y) = (%1, %2) of frame %3. Turn on "
+                   "motion estimation (Ctrl+M) or run Global motion (Ctrl+Shift+G) on this frame.")
+               .arg(pixelPos.x())
+               .arg(pixelPos.y())
+               .arg(frameIdx));
+    return;
+  }
+
+  if (!this->meCompareWindow)
+    this->meCompareWindow = new bda::integration::MeCompareWindow(this);
+  this->meCompareWindow->setComparison(
+      QString("%1 - frame %2, pixel (x, y) = (%3, %4)")
+          .arg(item->properties().name)
+          .arg(frameIdx)
+          .arg(pixelPos.x())
+          .arg(pixelPos.y()),
+      layout,
+      entries);
+  this->meCompareWindow->show();
+  this->meCompareWindow->raise();
+}
