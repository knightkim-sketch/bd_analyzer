+/*  This file is part of YUView - The YUV player with advanced analytics toolset
+ *   <https://github.com/IENT/YUView>
+ */
+
+#include "HexdumpViewerWidget.h"
+
+#include <QFontDatabase>
+#include <QTextCharFormat>
+#include <QTextCursor>
+#include <QTextStream>
+
+#include <algorithm>
+
+namespace
+{
+
+constexpr int MAX_HEXDUMP_BYTES = 256 * 1024;
+
+QString printableAscii(unsigned char value)
+{
+  if (value >= 32 && value <= 126)
+    return QString(1, QLatin1Char(char(value)));
+  return ".";
+}
+
+} // namespace
+
+HexdumpViewerWidget::HexdumpViewerWidget(QWidget *parent) : QWidget(parent), layout(this)
+{
+  this->titleLabel.setTextInteractionFlags(Qt::TextSelectableByMouse);
+  this->descriptionLabel.setWordWrap(true);
+  this->descriptionLabel.setTextInteractionFlags(Qt::TextSelectableByMouse);
+
+  this->dumpText.setReadOnly(true);
+  this->dumpText.setLineWrapMode(QPlainTextEdit::NoWrap);
+  this->dumpText.setFont(QFontDatabase::systemFont(QFontDatabase::FixedFont));
+  this->dumpText.setMinimumHeight(120);
+
+  this->layout.setContentsMargins(4, 4, 4, 4);
+  this->layout.addWidget(&this->titleLabel);
+  this->layout.addWidget(&this->descriptionLabel);
+  this->layout.addWidget(&this->dumpText, 1);
+
+  this->showMessage("Data Dump", "Select an item or click a block to show the current data.");
+}
+
+void HexdumpViewerWidget::currentSelectedItemsChanged(playlistItem *item1, playlistItem *item2)
+{
+  this->currentItem = item1;
+  if (this->selectedItem && this->selectedItem != item1 && this->selectedItem != item2)
+  {
+    this->selectedItem      = nullptr;
+    this->selectedFrameIdx  = -1;
+    this->hasSelectedPoint  = false;
+  }
+  this->refresh();
+}
+
+void HexdumpViewerWidget::setSelectedBlock(playlistItem *item, QPoint pixelPos, int frameIdx)
+{
+  this->selectedItem     = item;
+  this->selectedPos      = pixelPos;
+  this->selectedFrameIdx = frameIdx;
+  this->hasSelectedPoint = item != nullptr;
+  if (item)
+  {
+    this->currentItem     = item;
+    this->currentFrameIdx = frameIdx;
+  }
+  this->refresh();
+}
+
+void HexdumpViewerWidget::setCurrentFrame(playlistItem *item, int frameIdx)
+{
+  this->currentItem     = item;
+  this->currentFrameIdx = frameIdx;
+  if (!this->hasSelectedPoint || this->selectedItem == item)
+    this->selectedFrameIdx = frameIdx;
+  this->refresh();
+}
+
+void HexdumpViewerWidget::setFrameFromObu(playlistItem *item, int frameIdx)
+{
+  this->currentItem      = item;
+  this->currentFrameIdx  = frameIdx;
+  this->selectedItem     = item;
+  this->selectedFrameIdx = frameIdx;
+  this->hasSelectedPoint = false;
+  this->refresh();
+}
+
+void HexdumpViewerWidget::refresh()
+{
+  auto item     = this->selectedItem ? this->selectedItem : this->currentItem;
+  auto frameIdx = this->selectedFrameIdx >= 0 ? this->selectedFrameIdx : this->currentFrameIdx;
+  if (!item || frameIdx < 0)
+  {
+    this->showMessage("Data Dump", "Select an indexed item to show frame data.");
+    return;
+  }
+
+  stats::BlockInfo blockInfo;
+  if (this->hasSelectedPoint)
+    blockInfo = item->getBlockInfoAt(this->selectedPos, frameIdx);
+
+  const auto dump = item->getItemDataDump(this->hasSelectedPoint ? this->selectedPos : QPoint(0, 0),
+                                          frameIdx,
+                                          blockInfo);
+  if (!dump.isValid())
+  {
+    this->showMessage("Data Dump", "No dump data is available for the current item.");
+    return;
+  }
+
+  this->showDump(dump);
+}
+
+void HexdumpViewerWidget::showMessage(const QString &title, const QString &message)
+{
+  this->titleLabel.setText(title);
+  this->descriptionLabel.setText(message);
+  this->dumpText.clear();
+}
+
+void HexdumpViewerWidget::showDump(const playlistItem::DataDump &dump)
+{
+  this->titleLabel.setText(dump.title);
+
+  if (!dump.text.isEmpty())
+  {
+    this->descriptionLabel.setText(dump.description);
+    this->dumpText.setPlainText(dump.text);
+    return;
+  }
+
+  /* Which bytes of the shown window are the block's own. The window is deliberately wider than the
+   * block (a block can be a single byte, see playlistItemCompressedVideo::getItemDataDump), so
+   * without marking them the reader cannot tell block from context.
+   */
+  std::optional<std::pair<int, int>> highlightBytes;
+  if (dump.highlightedRange && dump.highlightedRange->isValid())
+  {
+    const auto first = qint64(dump.highlightedRange->startBit / 8) - qint64(dump.baseOffset);
+    const auto last  = qint64((dump.highlightedRange->endBit + 7) / 8 - 1) - qint64(dump.baseOffset);
+    const auto from  = std::max<qint64>(0, first);
+    const auto to    = std::min<qint64>(dump.bytes.size() - 1, last);
+    if (to >= from && from < dump.bytes.size())
+      highlightBytes = std::make_pair(int(from), int(to));
+  }
+
+  bool                             truncated = false;
+  std::vector<std::pair<int, int>> spans;
+  auto text = this->formatHexDump(dump.bytes, dump.baseOffset, highlightBytes, truncated, spans);
+  auto desc = dump.description;
+  if (truncated)
+    desc += QString(" · showing first %1 bytes").arg(MAX_HEXDUMP_BYTES);
+  this->descriptionLabel.setText(desc);
+  this->dumpText.setPlainText(text);
+
+  if (spans.empty())
+    return;
+
+  // Colour the block's own hex pairs and ascii characters. Character positions rather than rich text
+  // so the dump stays plain text for copy and paste.
+  QTextCharFormat blockFormat;
+  blockFormat.setForeground(QBrush(QColor(200, 0, 0)));
+  blockFormat.setFontWeight(QFont::Bold);
+  auto cursor = QTextCursor(this->dumpText.document());
+  cursor.beginEditBlock();
+  for (const auto &span : spans)
+  {
+    cursor.setPosition(span.first);
+    cursor.setPosition(span.first + span.second, QTextCursor::KeepAnchor);
+    cursor.mergeCharFormat(blockFormat);
+  }
+  cursor.endEditBlock();
+
+  // Bring the marked bytes into view; a block near the end of a long window would be off screen.
+  auto show = QTextCursor(this->dumpText.document());
+  show.setPosition(spans.front().first);
+  this->dumpText.setTextCursor(show);
+  this->dumpText.ensureCursorVisible();
+}
+
+QString HexdumpViewerWidget::formatHexDump(const QByteArray                        &data,
+                                           uint64_t                                 baseOffset,
+                                           const std::optional<std::pair<int, int>> &highlightBytes,
+                                           bool                                    &truncated,
+                                           std::vector<std::pair<int, int>>        &spans) const
+{
+  const auto maxBytes = qsizetype(MAX_HEXDUMP_BYTES);
+  truncated           = data.size() > maxBytes;
+  const int bytes     = int(std::min(data.size(), maxBytes));
+
+  QString     text;
+  QTextStream stream(&text);
+  /* The character positions of the highlighted bytes are collected while writing rather than derived
+   * from the column layout afterwards, so the two can never drift apart. One span per line for the
+   * hex column and one for the ascii column, which keeps the count small even for a long block.
+   */
+  for (int offset = 0; offset < bytes; offset += 16)
+  {
+    const int lineBytes = std::min(16, bytes - offset);
+    // The address column counts in the containing packet, not from the start of this slice.
+    stream << QString("%1  ").arg(baseOffset + uint64_t(offset), 8, 16, QLatin1Char('0')).toUpper();
+    stream.flush();
+    const int hexColumnStart = int(text.size());
+
+    QString ascii;
+    int     firstMarked = -1, lastMarked = -1;
+    for (int i = 0; i < 16; ++i)
+    {
+      if (i < lineBytes)
+      {
+        const auto value = static_cast<unsigned char>(data.at(offset + i));
+        stream << QString("%1 ").arg(value, 2, 16, QLatin1Char('0')).toUpper();
+        ascii += printableAscii(value);
+        if (highlightBytes && offset + i >= highlightBytes->first &&
+            offset + i <= highlightBytes->second)
+        {
+          if (firstMarked < 0)
+            firstMarked = i;
+          lastMarked = i;
+        }
+      }
+      else
+      {
+        stream << "   ";
+        ascii += ' ';
+      }
+      if (i == 7)
+        stream << ' ';
+    }
+    stream << " |" << ascii << "|\n";
+    stream.flush();
+
+    if (firstMarked >= 0)
+    {
+      // Byte i occupies 3 characters, with one extra separator inserted after byte 7.
+      const auto hexPos = [hexColumnStart](int i) {
+        return hexColumnStart + i * 3 + (i >= 8 ? 1 : 0);
+      };
+      spans.emplace_back(hexPos(firstMarked), hexPos(lastMarked) + 2 - hexPos(firstMarked));
+      // The ascii column starts after the hex column, the extra separator, a space and a '|'.
+      const int asciiStart = hexColumnStart + 16 * 3 + 1 + 2;
+      spans.emplace_back(asciiStart + firstMarked, lastMarked - firstMarked + 1);
+    }
+  }
+  return text;
+}
