+QString videoHandlerYUV::getLumaSampleBlockText(const QPoint &pixelPos,
+                                                int           frameIndex,
+                                                unsigned      blockSize,
+                                                QString      *description) const
+{
+  if (blockSize == 0)
+    return {};
+  if (this->currentFrameRawData_frameIndex != frameIndex || this->currentFrameRawData.isEmpty())
+    return {};
+
+  const auto frameWidth  = this->frameSize.width;
+  const auto frameHeight = this->frameSize.height;
+  if (frameWidth <= 0 || frameHeight <= 0 || pixelPos.x() < 0 || pixelPos.y() < 0 ||
+      pixelPos.x() >= frameWidth || pixelPos.y() >= frameHeight)
+    return {};
+
+  const auto originX = (pixelPos.x() / int(blockSize)) * int(blockSize);
+  const auto originY = (pixelPos.y() / int(blockSize)) * int(blockSize);
+  const auto width   = std::min<int>(int(blockSize), frameWidth - originX);
+  const auto height  = std::min<int>(int(blockSize), frameHeight - originY);
+
+  if (description)
+    *description = QString("Frame %1 · Y plane %2x%3 block @ (%4, %5)")
+                     .arg(frameIndex)
+                     .arg(width)
+                     .arg(height)
+                     .arg(originX)
+                     .arg(originY);
+
+  QString     text;
+  QTextStream stream(&text);
+  stream << "      ";
+  for (int x = 0; x < width; ++x)
+    stream << QString("%1").arg(originX + x, 4);
+  stream << '\n';
+
+  for (int y = 0; y < height; ++y)
+  {
+    stream << QString("%1:").arg(originY + y, 5);
+    for (int x = 0; x < width; ++x)
+      stream << QString("%1").arg(this->getPixelValue(QPoint(originX + x, originY + y)).Y, 4);
+    stream << '\n';
+  }
+
+  return text;
+}
