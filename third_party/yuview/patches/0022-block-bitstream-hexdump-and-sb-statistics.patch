+void FFmpegVersionHandler::closeInput(AVFormatContextWrapper &fmt)
+{
+  if (!fmt)
+    return;
+
+  /* avformat_close_input() also releases the AVIOContext, which is what holds the open file. The
+   * stream wrappers the caller may still be holding point into this context, so replacing the
+   * wrapper with an empty one is not enough on its own - the caller must be done with them. That is
+   * why this is called from the FileSourceFFmpegFile destructor and nowhere else.
+   */
+  auto *ctx = fmt.getFormatCtx();
+  this->lib.avformat.avformat_close_input(&ctx);
+  fmt = AVFormatContextWrapper();
+}
