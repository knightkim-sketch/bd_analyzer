+void MainWindow::clampInitialItemDumpPane()
+{
+  const auto totalHeight = std::max(1, ui.itemViewSplitter->height());
+  const auto maxDump     = std::max(1, totalHeight / 3);
+  const auto dumpHeight  = std::min(maxDump, 220);
+  ui.itemViewSplitter->setSizes({std::max(1, totalHeight - dumpHeight), dumpHeight});
+}
+
+void MainWindow::clampInitialLeftDocks()
+{
+  const auto inLeftColumn = [this](QDockWidget *dock) {
+    return dock && dock->isVisible() && !dock->isFloating() &&
+           this->dockWidgetArea(dock) == Qt::LeftDockWidgetArea;
+  };
+
+  // The pane that must keep its room. Nothing to balance against if it is not there.
+  auto *below = ui.cachingInfoDock;
+  if (!inLeftColumn(below) || !inLeftColumn(ui.fileInfoDock))
+    return;
+
+  QList<QDockWidget *> above;
+  for (auto *dock : {ui.playlistDockWidget, ui.fileInfoDock})
+    if (inLeftColumn(dock))
+      above.push_back(dock);
+
+  auto aboveHeight = 0;
+  for (auto *dock : above)
+    aboveHeight += dock->height();
+
+  /* Measured rather than assumed: what sits between the top of the window and the bottom of the file
+   * info pane also includes the menu bar and the dock separators.
+   */
+  const auto infoBottom =
+      ui.fileInfoDock->mapTo(this, QPoint(0, ui.fileInfoDock->height())).y();
+  const auto chrome = infoBottom - aboveHeight;
+  const auto target = this->height() / 2 - chrome;
+  if (aboveHeight <= target || target <= 0)
+    return;
+
+  // Shrink the panes above proportionally and hand what they give up to the pane below.
+  constexpr auto MIN_DOCK_HEIGHT = 60;
+  QList<int>     sizes;
+  auto           freed = 0;
+  for (auto *dock : above)
+  {
+    const auto height = std::max(MIN_DOCK_HEIGHT, dock->height() * target / aboveHeight);
+    freed += dock->height() - height;
+    sizes.push_back(height);
+  }
+  above.push_back(below);
+  sizes.push_back(below->height() + freed);
+
+  this->resizeDocks(above, sizes, Qt::Vertical);
+}
+
+void MainWindow::revealItemDumpPane()
+{
+  const auto sizes = ui.itemViewSplitter->sizes();
+  if (sizes.size() < 2)
+    return;
+
+  const auto totalHeight = std::max(1, sizes[0] + sizes[1]);
+  const auto maxDump     = std::max(1, totalHeight / 3);
+  const auto minVisible  = std::min(maxDump, std::max(120, ui.hexdumpViewer->minimumSizeHint().height()));
+  if (sizes[1] >= minVisible)
+    return;
+
+  ui.itemViewSplitter->setSizes({std::max(1, totalHeight - minVisible), minVisible});
+}
