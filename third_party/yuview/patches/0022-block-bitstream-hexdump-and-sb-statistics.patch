+playlistItem::DataDump
+playlistItemCompressedVideo::getItemDataDump(const QPoint          &pixelPos,
+                                             int                    frameIdx,
+                                             const stats::BlockInfo &blockInfo)
+{
+  DataDump dump;
+  dump.kind  = DataDump::Kind::Bitstream;
+  dump.title = "Frame Bitstream";
+
+  QByteArray frameData;
+  QString    frameDescription;
+
+  if (isInputFormatTypeAnnexB(this->inputFormat))
+  {
+    if (!this->inputFileAnnexBParser)
+    {
+      dump.description = "No AnnexB parser is available for this item.";
+      return dump;
+    }
+
+    /* frameIdx is what the video view and the playback controls handed out, so it counts frames in
+     * display order. getFrameStartEndPos() indexes the coding order list instead - that is why the
+     * decoding path in loadRawData() keeps its own readAnnexBFrameCounterCodingOrder rather than
+     * passing frameIdx. Using the coding order lookup here showed a different frame's bytes as soon
+     * as the two orders diverged.
+     */
+    const auto frameStartEndFilePos =
+        this->inputFileAnnexBParser->getFrameStartEndPosDisplayOrder(unsigned(frameIdx));
+    if (!frameStartEndFilePos)
+    {
+      dump.description = QString("No frame bitstream range is available for frame %1.").arg(frameIdx);
+      return dump;
+    }
+
+    if (!this->inputFileAnnexBDump)
+      this->inputFileAnnexBDump = std::make_unique<FileSourceAnnexBFile>(
+          std::filesystem::path(this->properties().name.toStdString()));
+    frameData = this->inputFileAnnexBDump->getFrameData(*frameStartEndFilePos);
+    frameDescription =
+        QString("Frame %1 · source bytes %2-%3 · %4 bytes")
+            .arg(frameIdx)
+            .arg(frameStartEndFilePos->first)
+            .arg(frameStartEndFilePos->second)
+            .arg(frameData.size());
+  }
+  else if (isInputFormatTypeFFmpeg(this->inputFormat))
+  {
+    if (!this->inputFileFFmpegDump)
+    {
+      this->inputFileFFmpegDump = std::make_unique<FileSourceFFmpegFile>();
+      // parseFile == false and the loading reader as "other": the frame count and the key frame
+      // list are copied from there instead of scanning the whole file again.
+      if (!this->inputFileFFmpegDump->openFile(
+              this->properties().name, nullptr, this->inputFileFFmpegLoading.get(), false))
+      {
+        this->inputFileFFmpegDump.reset();
+        dump.description = "Unable to open the input file for the packet dump.";
+        return dump;
+      }
+      this->dumpReaderPacketIdx = -1;
+    }
+
+    if (this->dumpReaderPacketCount && frameIdx >= *this->dumpReaderPacketCount)
+    {
+      dump.description =
+          QString("No video packet is available for frame %1 - the stream has %2 video packets.")
+              .arg(frameIdx)
+              .arg(*this->dumpReaderPacketCount);
+      return dump;
+    }
+
+    /* One video packet per frame, counted over the video stream only. That is the same definition
+     * the bitstream analysis tab annotates every AVPacket with ("YUView frame index"), so a frame
+     * picked from the OBU tree and the bytes shown here refer to the same packet.
+     *
+     * The reader keeps its position between calls: stepping to the next frame demuxes one packet,
+     * not frameIdx + 1 of them from the start of the file. Only a jump backwards has to rewind.
+     */
+    if (frameIdx < this->dumpReaderPacketIdx)
+    {
+      if (!this->inputFileFFmpegDump->seekFileToBeginning())
+      {
+        dump.description = "Unable to rewind the input file for the packet dump.";
+        return dump;
+      }
+      this->dumpReaderPacketIdx = -1;
+    }
+
+    FFmpeg::AVPacketWrapper packet;
+    if (frameIdx == this->dumpReaderPacketIdx)
+      // Already the packet the reader holds. Asking for the next one would step past it.
+      packet = this->inputFileFFmpegDump->getNextPacket(true, true);
+    else
+      while (this->dumpReaderPacketIdx < frameIdx)
+      {
+        packet = this->inputFileFFmpegDump->getNextPacket(false, true);
+        if (!packet)
+        {
+          // The file ended, so we now know how many video packets it has. Remember it: without this
+          // every later request for an out of range frame would walk the whole file again.
+          this->dumpReaderPacketCount = this->dumpReaderPacketIdx + 1;
+          break;
+        }
+        this->dumpReaderPacketIdx++;
+      }
+
+    if (!packet)
+    {
+      dump.description =
+          QString("No video packet is available for frame %1 - the stream has %2 video packets.")
+              .arg(frameIdx)
+              .arg(this->dumpReaderPacketIdx + 1);
+      return dump;
+    }
+
+    frameData =
+        QByteArray(reinterpret_cast<const char *>(packet.getData()), packet.getDataSize());
+    frameDescription = QString("Frame %1 · demuxed packet payload · %2 bytes")
+                           .arg(frameIdx)
+                           .arg(frameData.size());
+  }
+  else
+  {
+    dump.description = "No bitstream dump source is available for this input format.";
+    return dump;
+  }
+
+  if (frameData.isEmpty())
+  {
+    dump.description = frameDescription + " · empty";
+    return dump;
+  }
+
+  if (blockInfo.bitstreamRange && blockInfo.bitstreamRange->isValid())
+  {
+    const auto &range     = *blockInfo.bitstreamRange;
+    const auto  blockData = sliceBitRange(frameData, range);
+    if (!blockData.isEmpty())
+    {
+      /* AV1 codes block syntax with an arithmetic coder, so a block routinely occupies only a few
+       * bits and its slice can be a single byte. On its own that is unreadable, so some surrounding
+       * bytes are shown as well; the description says which bytes are the block's own.
+       */
+      const auto blockFirstByte = qsizetype(range.startBit / 8);
+      const auto blockLastByte  = blockFirstByte + blockData.size() - 1;
+      const auto from           = std::max(qsizetype(0), blockFirstByte - BLOCK_DUMP_CONTEXT_BYTES);
+      const auto to =
+          std::min(qsizetype(frameData.size()) - 1, blockLastByte + BLOCK_DUMP_CONTEXT_BYTES);
+
+      dump.title       = "Block Bitstream";
+      dump.description = QString("%1 · %2 bits %3-%4 · block bytes %5-%6 (%7), showing %8-%9 · the "
+                                 "range is the arithmetic coder's read positions, not a bit field")
+                             .arg(frameDescription)
+                             .arg(range.origin.isEmpty() ? "packet payload" : range.origin)
+                             .arg(range.startBit)
+                             .arg(range.endBit)
+                             .arg(blockFirstByte)
+                             .arg(blockLastByte)
+                             .arg(blockData.size() == 1 ? QString("1 byte")
+                                                        : QString("%1 bytes").arg(blockData.size()))
+                             .arg(from)
+                             .arg(to);
+      dump.bytes            = frameData.mid(int(from), int(to - from + 1));
+      dump.baseOffset       = uint64_t(from);
+      dump.highlightedRange = range;
+      return dump;
+    }
+  }
+
+  (void)pixelPos;
+  dump.description = frameDescription;
+  dump.bytes       = frameData;
+  return dump;
+}
