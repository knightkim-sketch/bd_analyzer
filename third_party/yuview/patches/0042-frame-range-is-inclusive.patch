@@ -739,7 +739,13 @@
 
   indexRange range;
   range.first  = int(this->keyFrameList.at(0).frame);
-  range.second = int(this->nrFrames);
+  /* Inclusive, so the last index is one below the count. nrFrames is how many packets the scan
