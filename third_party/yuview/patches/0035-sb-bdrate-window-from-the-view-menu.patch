+void MainWindow::addBdRateGroupFromSelection()
+{
+  if (!this->bdRateWindow)
+  {
+    this->bdRateWindow = new bda::integration::BdRatePlotWindow(this);
+    /* The superblock panel is about the block the user clicked, and the frame panel about the
+     * frame on screen, so both follow the view rather than freezing at whatever was showing when
+     * the window opened.
+     */
+    connect(ui.displaySplitView,
+            &splitViewWidget::blockSelected,
+            this->bdRateWindow.data(),
+            [window = this->bdRateWindow.data()](playlistItem *item, QPoint pixelPos, int)
+            { window->setSelectedPosition(pixelPos, item != nullptr); });
+    connect(ui.displaySplitView,
+            &splitViewWidget::viewFrameChanged,
+            this->bdRateWindow.data(),
+            [window = this->bdRateWindow.data()](playlistItem *, int frameIdx)
+            { window->setCurrentFrame(frameIdx); });
+  }
+
+  this->bdRateWindow->setCurrentFrame(ui.playbackController->getCurrentFrame());
+
+  const auto result = this->bdRateWindow->addGroup(ui.playlistTreeWidget->getAllSelectedItems());
+  if (!result.ok())
+  {
+    /* A dialog rather than a status line: the action was a deliberate press and the reasons are
+     * specific enough to act on - the wrong decoder, a missing original, one stream instead of
+     * four.
+     */
+    QMessageBox::information(this, "SB BD-rate", bda::integration::bdRateGroupErrorText(result));
+    if (this->bdRateWindow->empty())
+      return;
+  }
+
+  this->bdRateWindow->show();
+  this->bdRateWindow->raise();
+}
