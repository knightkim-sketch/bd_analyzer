+bool playlistItemCompressedVideo::supportsMotionEstimation() const
+{
+  /* An attached original is the whole requirement. It is read with this item's geometry, so once it
+   * is there the two frames the estimator needs are a file read away - no decoding, and no
+   * dependence on the decoder having reached the reference frame.
+   */
+  return !this->getOriginalYUVSource().isEmpty() && this->supportsPixelStatistics();
+}
+
+QByteArray playlistItemCompressedVideo::readRawFrame(int frameIdx)
+{
+  // The source, not the reconstruction: that is what an open-loop estimator searches.
+  return this->readOriginalYUVFrame(frameIdx);
+}
