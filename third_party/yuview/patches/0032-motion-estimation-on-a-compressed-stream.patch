+/* Index the frames of a Y4M file: the byte offset of each frame's sample data, and how many bytes
+ * one frame carries according to the header.
+ *
+ * Deliberately not playlistItemRawFile::parseY4MFile(). That one is the loader for a Y4M *item* -
+ * it adopts the header's size, format and frame rate as the item's own, and reports through the
+ * item's error state. Here the file is an attachment: the item already has a geometry, and what is
+ * wanted is the frame offsets plus enough of the header to refuse a file that does not match. The
+ * two would have to be pulled apart to share, and the shared part is this function.
+ *
+ * A Y4M frame is "FRAME", optional parameters, 0x0A, then the samples - so the payload is not at a
+ * fixed stride and cannot be reached by multiplying, which is exactly why the flat path is wrong
+ * for these files.
+ */
+struct Y4MIndex
+{
+  std::vector<int64_t> frameOffsets;
+  int64_t              bytesPerFrame{};
+  unsigned             width{};
+  unsigned             height{};
+  bool                 isY4M{};
+};
+
+Y4MIndex indexY4M(FileSource &file)
+{
+  Y4MIndex index;
+
+  QByteArray header;
+  // The header may be arbitrarily long in theory; 512 bytes covers it in practice, as upstream's
+  // own parser assumes.
+  if (file.readBytes(header, 0, 512) < 16 || header.left(10) != "YUV4MPEG2 ")
+    return index;
+
+  int      offset        = 9;
+  unsigned bitsPerSample = 8;
+  QByteArray subsampling = "420"; // the Y4M default when no C parameter is present
+
+  while (offset < header.size() && header.at(offset) == ' ')
+  {
+    ++offset;
+    if (offset >= header.size())
+      return index;
+    const char parameter = header.at(offset++);
+    const auto readNumber = [&header, &offset]() {
+      QByteArray digits;
+      while (offset < header.size() && QChar(header.at(offset)).isDigit())
+        digits.append(header.at(offset++));
+      return digits.toUInt();
+    };
+
+    if (parameter == 'W')
+      index.width = readNumber();
+    else if (parameter == 'H')
+      index.height = readNumber();
+    else if (parameter == 'C')
+    {
+      subsampling = header.mid(offset, 3);
+      offset += 3;
+      if (offset < header.size() && header.at(offset) == 'p')
+      {
+        ++offset;
+        QByteArray digits;
+        while (offset < header.size() && QChar(header.at(offset)).isDigit())
+          digits.append(header.at(offset++));
+        const auto depth = digits.toUInt();
+        if (depth >= 8 && depth <= 16)
+          bitsPerSample = depth;
+      }
+    }
+
+    // Skip whatever is left of this parameter; 0x0A ends the header.
+    while (offset < header.size() && header.at(offset) != ' ' && header.at(offset) != 10)
+      ++offset;
+    if (offset < header.size() && header.at(offset) == 10)
+    {
+      ++offset;
+      break;
+    }
+  }
+
+  if (index.width == 0 || index.height == 0)
+    return index;
+
+  auto samplesPerFrame = int64_t(index.width) * index.height * 3 / 2;
+  if (subsampling == "422")
+    samplesPerFrame = int64_t(index.width) * index.height * 2;
+  else if (subsampling == "444")
+    samplesPerFrame = int64_t(index.width) * index.height * 3;
+  else if (subsampling == "mon" || subsampling == "400")
+    samplesPerFrame = int64_t(index.width) * index.height;
+  index.bytesPerFrame = bitsPerSample > 8 ? samplesPerFrame * 2 : samplesPerFrame;
+  index.isY4M         = true;
+
+  const auto fileSize = int64_t(file.getFileSize().value_or(0));
+  int64_t    pos      = offset;
+  while (pos + 6 < fileSize)
+  {
+    QByteArray marker;
+    if (file.readBytes(marker, pos, 32) < 6)
+      break;
+    if (marker.left(5) != "FRAME")
+      break;
+    // Frame parameters run to the next 0x0A. They carry nothing this needs.
+    int headerEnd = 5;
+    while (headerEnd < marker.size() && marker.at(headerEnd) != 10)
+      ++headerEnd;
+    if (headerEnd >= marker.size())
+      break;
+    const auto dataStart = pos + headerEnd + 1;
+    if (dataStart + index.bytesPerFrame > fileSize)
+      break;
+    index.frameOffsets.push_back(dataStart);
+    pos = dataStart + index.bytesPerFrame;
+  }
+
+  return index;
+}
