+QByteArray playlistItemWithVideo::readFilteredRawFrame(int frameIdx)
+{
+  auto raw = this->readRawFrame(frameIdx);
+  if (raw.isEmpty() || this->rawFormat != video::RawFormat::YUV)
+    return raw;
+  const auto filter = this->getYUVVideo()->getConvolutionFilter();
+  if (filter.isNoOp())
+    return raw;
+  // The previous frame comes from the same source as this one, unfiltered; the chain runs it
+  // through the stages in front of a GM compensation stage itself.
+  filter.applyToLuma(raw, this->getRawPixelFormat(), this->getRawFrameSize(), [this, frameIdx]() {
+    return frameIdx > 0 ? this->readRawFrame(frameIdx - 1) : QByteArray();
+  });
+  return raw;
+}
+
+QByteArray playlistItemWithVideo::readMeFrame(int frameIdx)
+{
+  if (this->rawFormat == video::RawFormat::YUV && this->getYUVVideo()->filterIsMeInput())
+    return this->readFilteredRawFrame(frameIdx);
+  return this->readRawFrame(frameIdx);
+}
