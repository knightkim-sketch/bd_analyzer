+
+void videoHandlerYUV::dropStaleGmRaw()
+{
+  const auto generation = this->gmRawGeneration.load();
+  if (generation != this->gmRawCacheGeneration)
+  {
+    this->gmRawCache.clear();
+    this->gmRawCacheGeneration = generation;
+  }
+}
+
+void videoHandlerYUV::rememberRawForGm(int frameIndex, const QByteArray &raw)
+{
+  this->dropStaleGmRaw();
+  // A format or size change makes the kept frames unusable; drop them rather than mix sizes.
+  if (!this->gmRawCache.empty() && this->gmRawCache.front().second.size() != raw.size())
+    this->gmRawCache.clear();
+  for (const auto &entry : this->gmRawCache)
+    if (entry.first == frameIndex)
+      return;
+  this->gmRawCache.emplace_back(frameIndex, raw);
+  // A few frames, for the caching threads, which do not load strictly in order.
+  while (this->gmRawCache.size() > 4)
+    this->gmRawCache.pop_front();
+}
+
+QByteArray videoHandlerYUV::rawForGm(int frameIndex, bool caching)
+{
+  this->dropStaleGmRaw();
+  for (const auto &entry : this->gmRawCache)
+    if (entry.first == frameIndex)
+      return entry.second;
+  emit signalRequestRawData(frameIndex, caching);
+  if (frameIndex != this->rawData_frameIndex || this->rawData.isEmpty())
+    return {};
+  const auto raw = this->rawData;
+  this->rememberRawForGm(frameIndex, raw);
+  return raw;
+}
