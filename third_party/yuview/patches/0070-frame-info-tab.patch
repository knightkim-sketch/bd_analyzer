+void FileInfoWidget::setCurrentFrame(int frameIdx)
+{
+  if (frameIdx == this->currentFrame)
+    return;
+  this->currentFrame = frameIdx;
+  this->refreshFrameTab();
+}
+
+void FileInfoWidget::refreshFrameTab()
+{
+  const auto set = [this](const char *key, const QString &text) {
+    this->frameValues[key]->setText(text);
+  };
+  const auto clear = [&](const QString &first) {
+    for (auto &[key, label] : this->frameValues)
+      label->setText("-");
+    set("YUView frame index", first);
+    this->frameObuView->setRootIndex({});
+    this->frameObuView->setVisible(false);
+  };
+
+  if (!this->obuModel)
+  {
+    clear("-");
+    return;
+  }
+  this->frameIndex.update(*this->obuModel);
+  const auto *frame = this->frameIndex.frame(this->currentFrame);
+  if (!frame)
+  {
+    clear(this->currentFrame < 0 ? QString("-")
+                                 : QString("%1 (not parsed yet)").arg(this->currentFrame));
+    return;
+  }
+
+  using bda::integration::frameTypeName;
+  set("YUView frame index", QString::number(frame->yuviewFrameIndex));
+  set("coding_order", frame->showExisting ? QString("-") : QString::number(frame->codingOrder));
+  set("order_hint", frame->orderHint < 0 ? QString("-") : QString::number(frame->orderHint));
+  set("frame_type", QString::fromStdString(frameTypeName(frame->frameType)));
+  if (frame->showExisting)
+    set("show_existing_frame",
+        QString("1 (frame_to_show_map_idx %1 = coding_order %2)")
+            .arg(frame->frameToShowMapIdx)
+            .arg(frame->shownCodingOrder < 0 ? QString("?")
+                                             : QString::number(frame->shownCodingOrder)));
+  else
+    set("show_existing_frame", "0");
+  QStringList hidden;
+  for (const auto &h : frame->hidden)
+    hidden << QString("coding_order %1, order_hint %2, %3")
+                  .arg(h.codingOrder)
+                  .arg(h.orderHint)
+                  .arg(QString::fromStdString(frameTypeName(h.frameType)));
+  set("Hidden frames in this TU", hidden.isEmpty() ? QString("none") : hidden.join("\n"));
+  set("AVPacket", QString::fromStdString(frame->packetName));
+
+  const auto packetIndex = this->obuModel->index(frame->packetRow, 0);
+  if (this->frameObuView->rootIndex() != packetIndex)
+  {
+    this->frameObuView->setRootIndex(packetIndex);
+    this->frameObuView->expandToDepth(0);
+  }
+  this->frameObuView->setVisible(true);
+}
