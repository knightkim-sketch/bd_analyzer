+/* Everything below implements click-to-select-a-block.
+ *
+ * The arithmetic duplicates the tail of updatePixelPositions() on purpose rather than sharing it:
+ * that function computes one diffInItem from the view under the mouse and then applies it to both
+ * items, which is what the zoom box wants but is wrong for a selection - we need only the item that
+ * was actually clicked, relative to its own center.
+ */
+bool splitViewWidget::widgetPosToItemPixel(const QPoint &widgetPos,
+                                           int          &view,
+                                           QPoint       &pixelPos,
+                                           bool         &insideItem)
+{
+  const auto item = playlist->getSelectedItems();
+
+  const auto drawAreaBotR = this->rect().bottomRight();
+  const int  xSplit       = int(drawAreaBotR.x() * splittingPoint);
+
+  QPoint centerPoints[2];
+  if (viewSplitMode == COMPARISON || !isSplitting())
+  {
+    centerPoints[0] = drawAreaBotR / 2;
+    centerPoints[1] = centerPoints[0];
+  }
+  else
+  {
+    const auto y    = drawAreaBotR.y() / 2;
+    centerPoints[0] = QPoint(xSplit / 2, y);
+    centerPoints[1] = QPoint(xSplit + (drawAreaBotR.x() - xSplit) / 2, y);
+  }
+
+  view = (isSplitting() && widgetPos.x() > xSplit) ? 1 : 0;
+  if (!item[view])
+    return false;
+
+  const auto itemCenter = centerPoints[view] + this->moveOffset;
+  const auto itemSize   = item[view]->getSize();
+
+  const double diffX = (double)(itemCenter.x() - widgetPos.x()) / this->zoomFactor + 0.5;
+  const double diffY = (double)(itemCenter.y() - widgetPos.y()) / this->zoomFactor + 0.5;
+
+  double px = -diffX + (double(itemSize.width()) / 2) + 0.5;
+  double py = -diffY + (double(itemSize.height()) / 2) + 0.5;
+  // Same quantization as updatePixelPositions(): 0...-1 must become -1, not 0.
+  if (px < 0)
+    px -= 1;
+  if (py < 0)
+    py -= 1;
+
+  pixelPos   = QPoint(px, py);
+  insideItem = pixelPos.x() >= 0 && pixelPos.x() < itemSize.width() && pixelPos.y() >= 0 &&
+               pixelPos.y() < itemSize.height();
+  return true;
+}
+
+void splitViewWidget::selectBlockAt(const QPoint &widgetPos)
+{
+  int    view{};
+  QPoint pixelPos;
+  bool   insideItem{};
+
+  if (!this->widgetPosToItemPixel(widgetPos, view, pixelPos, insideItem) || !insideItem)
+  {
+    if (this->blockSelection.valid)
+    {
+      // Stop paying for statistics collection once nothing is selected any more.
+      if (this->blockSelection.item)
+        this->blockSelection.item->setBlockInfoRequested(false);
+      this->blockSelection = {};
+      emit blockSelected(nullptr, QPoint(), -1);
+      this->update();
+    }
+    return;
+  }
+
+  const auto item = playlist->getSelectedItems();
+
+  // Only one block is selected at a time across the primary and the separate view, otherwise a
+  // stale highlight would sit in the other one while the info pane shows this block.
+  if (auto other = this->getOtherWidget(); other && other->blockSelection.valid)
+  {
+    other->blockSelection = {};
+    other->update();
+  }
+
+  this->blockSelection          = {};
+  this->blockSelection.item     = item[view];
+  this->blockSelection.view     = view;
+  this->blockSelection.pixelPos = pixelPos;
+  this->blockSelection.valid    = true;
+
+  // Block statistics are only collected when something asks for them. Ask here rather than leaving
+  // it to the info pane, so that the highlight also works with the pane closed. The data arrives
+  // asynchronously; refreshBlockSelection() below will come up empty on the very first click and is
+  // retried from update() once the frame has been re-decoded.
+  if (item[view])
+    item[view]->setBlockInfoRequested(true);
+
+  this->refreshBlockSelection();
+
+  emit blockSelected(item[view], pixelPos, this->blockSelection.frameIdx);
+  this->update();
+}
+
+void splitViewWidget::refreshBlockSelection()
+{
+  if (!this->blockSelection.valid || !this->blockSelection.item)
+    return;
+
+  const auto frameIdx = playback->getCurrentFrame();
+
+  // The query walks every statistics entry of the frame - about a millisecond at 1080p and several
+  // at 4K. That is fine per click or per frame change, but it must never run per repaint, so the
+  // resolved rects are cached here and paintBlockSelection() only draws them.
+  const auto info = this->blockSelection.item->getBlockInfoAt(this->blockSelection.pixelPos,
+                                                              frameIdx);
+
+  this->blockSelection.frameIdx = frameIdx;
+  if (info.isValid)
+  {
+    this->blockSelection.codingBlockRect = info.codingBlockRect;
+    this->blockSelection.transformBlockRect =
+        info.transformBlockRect ? *info.transformBlockRect : QRect();
+  }
+  else
+  {
+    // Keep the selected position, but draw nothing: statistics may not be collected yet, or the
+    // partitioning genuinely has no block at this pixel.
+    this->blockSelection.codingBlockRect    = QRect();
+    this->blockSelection.transformBlockRect = QRect();
+  }
+}
+
+void splitViewWidget::paintBlockSelection(QPainter     &painter,
+                                          playlistItem *item,
+                                          int           view,
+                                          double        zoom)
+{
+  if (!this->blockSelection.valid || this->blockSelection.view != view ||
+      this->blockSelection.item != item || this->blockSelection.codingBlockRect.isEmpty())
+    return;
+
+  // Match how the video and the statistics overlay place the item, so the outline lands exactly on
+  // the block edges the user sees (videoHandler::drawFrame / stats::paintStatisticsData both use
+  // moveCenter, which is not the same as the zoom box's rect math).
+  QRect itemRect;
+  itemRect.setSize(QSize(item->getSize().width() * zoom, item->getSize().height() * zoom));
+  itemRect.moveCenter(QPoint(0, 0));
+
+  const auto toDisplay = [&](const QRect &b) {
+    return QRect(b.x() * zoom, b.y() * zoom, b.width() * zoom, b.height() * zoom)
+        .translated(itemRect.topLeft());
+  };
