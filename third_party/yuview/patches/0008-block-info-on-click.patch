+
+BlockInfoWidget::BlockInfoWidget(QWidget *parent) : QWidget(parent), layout(this)
+{
+  this->statusLabel.setWordWrap(true);
+  this->statusLabel.setTextInteractionFlags(Qt::TextSelectableByMouse);
+
+  this->tree.setColumnCount(2);
+  this->tree.setHeaderLabels({"Syntax Element", "Value"});
+  this->tree.setRootIsDecorated(true);
+  this->tree.setUniformRowHeights(true);
+  this->tree.setSelectionMode(QAbstractItemView::SingleSelection);
+  this->tree.header()->setSectionResizeMode(0, QHeaderView::ResizeToContents);
+  this->tree.header()->setStretchLastSection(true);
+
+  this->layout.setContentsMargins(4, 4, 4, 4);
+  this->layout.addWidget(&this->statusLabel);
+  this->layout.addWidget(&this->tree);
+
+  this->showMessage("Click a block in the video view to show its mode information.");
+}
+
+void BlockInfoWidget::setSelectedBlock(playlistItem *item, QPoint pixelPos, int frameIdx)
+{
+  this->selectedItem     = item;
+  this->selectedPos      = pixelPos;
+  this->selectedFrameIdx = frameIdx;
+
+  if (!item)
+  {
+    this->showMessage("Click a block in the video view to show its mode information.");
+    return;
+  }
+
+  // Note: requesting statistics collection is the view's job (splitViewWidget::selectBlockAt), so
+  // that the highlight also works with this pane closed. Do not request it here as well, or the two
+  // would fight over switching it off again.
+  this->refresh();
+}
+
+void BlockInfoWidget::refresh()
+{
+  if (!this->selectedItem)
+    return;
+
+  const auto info = this->selectedItem->getBlockInfoAt(this->selectedPos, this->selectedFrameIdx);
+  if (!info.isValid)
+  {
+    // Either the statistics for this frame have not been collected yet (they are on their way), or
+    // this position genuinely has no block - real dav1d output does contain small gaps.
+    this->showMessage(QString("No block information at (%1, %2) in frame %3 yet.")
+                          .arg(this->selectedPos.x())
+                          .arg(this->selectedPos.y())
+                          .arg(this->selectedFrameIdx));
+    return;
+  }
+
+  this->populate(info);
+}
+
+void BlockInfoWidget::currentSelectedItemsChanged(playlistItem *item1, playlistItem *item2)
+{
+  if (this->selectedItem && this->selectedItem != item1 && this->selectedItem != item2)
+    this->setSelectedBlock(nullptr, QPoint(), -1);
+}
+
+void BlockInfoWidget::showMessage(const QString &text)
+{
+  this->tree.clear();
+  this->statusLabel.setText(text);
+}
+
+void BlockInfoWidget::populate(const stats::BlockInfo &info)
+{
+  this->statusLabel.setText(QString("Frame %1 · pixel (%2, %3)")
+                                .arg(info.frameIndex)
+                                .arg(this->selectedPos.x())
+                                .arg(this->selectedPos.y()));
+
+  this->tree.clear();
+
+  // One group per distinct rectangle, largest first (allRects is already sorted that way), so for
+  // AV1 the coding block comes before the transform block. Deriving the grouping from the data keeps
+  // this codec neutral: HEVC CTB/CU/TU fall out the same way.
+  for (const auto &rect : info.allRects)
+  {
+    auto *group = new QTreeWidgetItem(&this->tree);
+    auto  label = QString("Block %1×%2 @ (%3, %4)")
+                     .arg(rect.width())
+                     .arg(rect.height())
+                     .arg(rect.x())
+                     .arg(rect.y());
+    if (rect == info.codingBlockRect)
+      label += "  — coding block";
+    else if (info.transformBlockRect && rect == *info.transformBlockRect)
+      label += "  — transform block";
+    group->setText(0, label);
+    group->setFirstColumnSpanned(true);
+    group->setExpanded(true);
+
+    for (const auto &entry : info.entries)
+    {
+      if (entry.rect != rect)
+        continue;
+      auto *row = new QTreeWidgetItem(group);
+      row->setText(0, entry.typeName);
+      row->setText(1, entry.valueText);
+
+      // VQAnalyzer puts the explanation of an abbreviated name in a tooltip; several statistic
+      // types have no description, so always append the type id and the raw value.
+      auto tip = entry.description;
+      if (!tip.isEmpty())
+        tip += "\n";
+      tip += QString("Type ID: %1").arg(entry.typeID);
+      if (entry.hasRawValue)
+        tip += QString(", raw value: %1").arg(entry.rawValue);
+      row->setToolTip(0, tip);
+      row->setToolTip(1, tip);
+    }
+
+    if (group->childCount() == 0)
+      delete group;
+  }
+}
