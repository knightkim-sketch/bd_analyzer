+#include <QTreeWidget>
+#include <QVBoxLayout>
+#include <QWidget>
+
+#include <statistics/BlockInfo.h>
+
+class playlistItem;
+
+/* Shows the mode information of the block the user clicked in the view.
+ *
+ * This is the equivalent of VQAnalyzer's "Block" tab: one group per distinct block rectangle (for
+ * AV1 the coding block, and the transform block when it differs), with the statistic types of that
+ * block underneath.
+ *
+ * The widget asks the item for the data itself rather than receiving it, so that a frame change only
+ * has to tell it "re-read", and the highlight in the view and the values here can never disagree.
+ */
+class BlockInfoWidget : public QWidget
+{
+  Q_OBJECT
+
+public:
+  explicit BlockInfoWidget(QWidget *parent = nullptr);
+
+public slots:
+  //!< From splitViewWidget::blockSelected. item == nullptr clears the pane.
+  void setSelectedBlock(playlistItem *item, QPoint pixelPos, int frameIdx);
+  //!< Something about the current item changed (frame loaded, decoder switched, statistics
+  //!< toggled). Re-read the values for the stored selection.
+  void refresh();
+  //!< The playlist selection changed. Clears when our item is no longer selected.
+  void currentSelectedItemsChanged(playlistItem *item1, playlistItem *item2);
+
+private:
+  void showMessage(const QString &text);
+  void populate(const stats::BlockInfo &info);
+
+  QVBoxLayout layout;
+  QLabel      statusLabel;
+  QTreeWidget tree;
+
+  QPointer<playlistItem> selectedItem;
+  QPoint                 selectedPos;
+  int                    selectedFrameIdx{-1};
+};
