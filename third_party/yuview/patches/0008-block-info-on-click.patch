+stats::BlockInfo playlistItemCompressedVideo::getBlockInfoAt(const QPoint &pixelPos, int frameIdx)
+{
+  if (!this->loadingDecoder || !this->loadingDecoder->statisticsSupported() ||
+      !this->loadingDecoder->statisticsEnabled())
+    return {};
+
+  auto info = this->statisticsData.getBlockInfoAt(pixelPos);
+
+  // The statistics can lag the displayed frame. One real case: when a frame cannot be decoded
+  // loadRawData() advances currentFrameIdx without decoding, so the cache still holds the previous
+  // frame. Reporting that as if it belonged to frameIdx would show the wrong block.
+  if (info.frameIndex != frameIdx)
+    return {};
+
+  return info;
+}
+
+void playlistItemCompressedVideo::setBlockInfoRequested(bool requested)
+{
+  if (this->statisticsData.isBlockInfoRequested() == requested)
+    return;
+
+  this->statisticsData.setBlockInfoRequested(requested);
+  if (requested)
+    // Statistics are only collected when something asks for them. This makes the existing
+    // needsLoading -> loadFrame -> loadStatistics path run, which enables retrieval in the decoder
+    // and re-decodes the current frame. It happens on a loading thread.
+    emit SignalItemChanged(true, RECACHE_NONE);
+}
