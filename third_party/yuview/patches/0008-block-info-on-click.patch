+BlockInfo StatisticsData::getBlockInfoAt(const QPoint &pos) const
+{
+  BlockInfo info;
+
+  std::unique_lock<std::mutex> lock(this->accessMutex);
+
+  info.frameIndex = this->frameIdx;
+
+  // The dav1d analyzer fork emits every block two to four times (its recursion always starts at
+  // BL_128X128 while the outer loop already steps per sub block), so the same (type, rect, value)
+  // triple shows up repeatedly. Deduplicate on exactly that triple; measured on real output the
+  // duplicates never disagree, so nothing is lost.
+  const auto alreadyHaveValue = [&info](int typeID, const QRect &rect, int value) {
+    for (const auto &e : info.entries)
+      if (e.typeID == typeID && e.rect == rect && e.hasRawValue && e.rawValue == value)
+        return true;
+    return false;
+  };
+  // Vectors are keyed on the vector itself, and must not collide with a scalar entry of the same
+  // type and rect - some decoders emit both for one type.
+  const auto alreadyHaveVector =
+      [&info](int typeID, const QRect &rect, const QString &valueText) {
+        for (const auto &e : info.entries)
+          if (e.typeID == typeID && e.rect == rect && !e.hasRawValue && e.valueText == valueText)
+            return true;
+        return false;
+      };
+
+  for (const auto &statType : this->statsTypes)
+  {
+    if (statType.typeID == INT_INVALID || this->frameCache.count(statType.typeID) == 0)
+      continue;
+
+    // Deliberately no renderGrid/render test here: the pane must show what the block is, not what
+    // the user happens to be drawing on top of the video.
+    const auto &frameData = this->frameCache.at(statType.typeID);
+
+    for (const auto &valueItem : frameData.valueData)
+    {
+      const auto rect =
+          QRect(valueItem.pos[0], valueItem.pos[1], valueItem.size[0], valueItem.size[1]);
+      if (!rect.contains(pos))
+        continue;
+      if (alreadyHaveValue(statType.typeID, rect, valueItem.value))
+        continue;
+
+      BlockInfoEntry entry;
+      entry.typeID      = statType.typeID;
+      entry.typeName    = statType.typeName;
+      entry.description = statType.description;
+      entry.rawValue    = valueItem.value;
+      entry.hasRawValue = true;
+      entry.rect        = rect;
+      entry.valueText   = statType.getValueTxt(valueItem.value);
+      if (entry.valueText.isEmpty() && statType.scaleValueToBlockSize)
+        entry.valueText =
+            QString("%1").arg(float(valueItem.value) / (valueItem.size[0] * valueItem.size[1]));
+      if (entry.valueText.isEmpty())
+        entry.valueText = QString("%1").arg(valueItem.value);
+      info.entries.push_back(entry);
+    }
+
+    for (const auto &vectorItem : frameData.vectorData)
+    {
+      const auto rect =
+          QRect(vectorItem.pos[0], vectorItem.pos[1], vectorItem.size[0], vectorItem.size[1]);
+      if (!rect.contains(pos))
+        continue;
+      double x{};
+      double y{};
+      if (vectorItem.isLine)
+      {
+        x = double(vectorItem.point[1].x - vectorItem.point[0].x) / statType.vectorScale;
+        y = double(vectorItem.point[1].y - vectorItem.point[0].y) / statType.vectorScale;
+      }
+      else
+      {
+        x = double(vectorItem.point[0].x) / statType.vectorScale;
+        y = double(vectorItem.point[0].y) / statType.vectorScale;
+      }
+
+      const auto valueText = QString("(%1,%2)").arg(x).arg(y);
+      if (alreadyHaveVector(statType.typeID, rect, valueText))
+        continue;
+
+      BlockInfoEntry entry;
+      entry.typeID      = statType.typeID;
+      entry.typeName    = statType.typeName;
+      entry.description = statType.description;
+      entry.hasRawValue = false;
+      entry.rect        = rect;
+      entry.valueText   = valueText;
+      info.entries.push_back(entry);
+    }
+  }
+
+  if (info.entries.empty())
+    return info;
+
+  // Pick the block to highlight. Prefer the type the decoder designated; where a designated type
+  // covers the position more than once (the fork does produce overlapping blocks) take the
+  // smallest, which is the more specific one.
+  const auto smallestRectOfType = [&info](int typeID) -> std::optional<QRect> {
+    std::optional<QRect> best;
+    for (const auto &e : info.entries)
+    {
+      if (e.typeID != typeID)
+        continue;
+      const auto area = e.rect.width() * e.rect.height();
+      if (!best || area < best->width() * best->height())
+        best = e.rect;
+    }
+    return best;
+  };
+
+  std::optional<QRect> coding;
+  if (this->codingBlockTypeID)
+    coding = smallestRectOfType(*this->codingBlockTypeID);
+  if (!coding)
+  {
+    /* No designated type, or it has no data here. Fall back to the smallest rect covering the
+     * position. Deliberately not the largest: decoders that have not designated their types can
+     * emit a superblock/CTB sized type (libde265 puts the slice index on the CTB rect), and
+     * outlining a whole CTB as "the block" would be plainly wrong. The smallest rect is at worst
+     * too specific. Decoders should call setBlockRectTypeIDs() to get this right.
+     */
+    for (const auto &e : info.entries)
+      if (!coding || e.rect.width() * e.rect.height() < coding->width() * coding->height())
+        coding = e.rect;
+  }
+  info.codingBlockRect = *coding;
+
+  if (this->transformBlockTypeID)
+  {
+    if (const auto tx = smallestRectOfType(*this->transformBlockTypeID))
+      if (*tx != info.codingBlockRect)
+        info.transformBlockRect = tx;
+  }
+
+  for (auto &e : info.entries)
+    e.isPrimaryRect = (e.rect == info.codingBlockRect);
+
+  for (const auto &e : info.entries)
+    if (std::find(info.allRects.begin(), info.allRects.end(), e.rect) == info.allRects.end())
+      info.allRects.push_back(e.rect);
+  std::sort(info.allRects.begin(), info.allRects.end(), [](const QRect &a, const QRect &b) {
+    return a.width() * a.height() > b.width() * b.height();
+  });
+
+  std::stable_sort(info.entries.begin(),
+                   info.entries.end(),
+                   [](const BlockInfoEntry &a, const BlockInfoEntry &b) {
+                     return a.typeID < b.typeID;
+                   });
+
+  info.isValid = true;
+  return info;
+}
+
+void StatisticsData::setBlockRectTypeIDs(std::optional<int> codingBlockTypeID,
+                                        std::optional<int> transformBlockTypeID)
+{
+  this->codingBlockTypeID    = codingBlockTypeID;
+  this->transformBlockTypeID = transformBlockTypeID;
+}
+
 void StatisticsData::clear()
 {
   this->frameCache.clear();
   this->frameIdx  = -1;
   this->frameSize = {};
   this->statsTypes.clear();
+  // The type IDs are meaningless for the next decoder; it will designate them again.
+  this->codingBlockTypeID.reset();
+  this->transformBlockTypeID.reset();
 }
 
 void StatisticsData::setFrameIndex(int frameIndex)
