+
+namespace stats
+{
+
+// One statistic type's data for a clicked position, with the block it belongs to.
+struct BlockInfoEntry
+{
+  int     typeID{INT_INVALID};
+  QString typeName;
+  QString description; // May be empty; several decoder types do not set one.
+  QString valueText;   // Already formatted: "INTER (1)", "TX_8X8 (1)", "(-1.25,0.5)" ...
+  int     rawValue{INT_INVALID};
+  bool    hasRawValue{}; // false for vector/affine entries
+
+  QRect rect;            // Frame pixel coordinates, as stored in StatsItem*::pos/size
+  bool  isPrimaryRect{}; // rect == BlockInfo::codingBlockRect
+};
+
+/* The result of a single "what is at this pixel" query.
+ *
+ * Note that isValid == false is a perfectly normal outcome: statistics may not be collected yet,
+ * the position may be outside the picture, or - measured on real dav1d output - the block
+ * partitioning can leave small holes where no block covers a pixel at all.
+ */
+struct BlockInfo
+{
+  bool isValid{};
+  int  frameIndex{-1}; // The frame the data actually came from. Compare against the frame you asked
+                       // for: statistics can lag the displayed frame.
+
+  // The block that should be highlighted. For AV1 this is the coding block.
+  QRect                codingBlockRect;
+  // Only set when a transform block was found and it differs from the coding block.
+  std::optional<QRect> transformBlockRect;
+  // Every distinct rect that covers the position, largest first.
+  std::vector<QRect>   allRects;
+
+  std::vector<BlockInfoEntry> entries; // Deduplicated, ascending typeID.
+};
+
+} // namespace stats
