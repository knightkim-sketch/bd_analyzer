 void decoderDav1d::cacheStatistics(const Dav1dPictureWrapper &img)
 {
+  /* This runs on a loading/caching thread and fills statisticsData through the unlocked at()
+   * accessor, while the GUI thread reads it (statistics painting, the zoom box, and the block info
+   * query). Hold the data's mutex for the whole frame: whole-frame granularity means it is taken
+   * once per decoded frame rather than per block, so it cannot ping-pong with the readers.
+   */
+  std::unique_lock<std::mutex> statisticsLock(this->statisticsData->accessMutex);
+
   if (!internalsSupported || !this->statisticsEnabled())
     return;
 
