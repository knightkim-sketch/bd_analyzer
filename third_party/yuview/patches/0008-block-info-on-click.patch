+  painter.save();
+  // paintStatisticsData leaves antialiasing on, which would blur a 1px outline.
+  painter.setRenderHint(QPainter::Antialiasing, false);
+  painter.setBrush(Qt::NoBrush);
+  painter.setClipRect(itemRect, Qt::IntersectClip);
+
+  const auto codingRect = toDisplay(this->blockSelection.codingBlockRect);
+  const bool small      = codingRect.width() < 6 || codingRect.height() < 6;
+
+  if (!this->blockSelection.transformBlockRect.isEmpty())
+  {
+    QPen pen(BLOCK_SELECTION_COLOR);
+    pen.setWidthF(1.0);
+    pen.setCosmetic(true); // Without this the pen width would be scaled by the zoom.
+    pen.setStyle(Qt::DashLine);
+    painter.setPen(pen);
+    painter.drawRect(toDisplay(this->blockSelection.transformBlockRect));
+  }
+
+  if (!small)
+  {
+    // A dark halo so the outline reads on bright content too.
+    QPen halo(QColor(0, 0, 0, 160));
+    halo.setWidthF(3.0);
+    halo.setCosmetic(true);
+    painter.setPen(halo);
+    painter.drawRect(codingRect);
+  }
+  QPen pen(BLOCK_SELECTION_COLOR);
+  pen.setWidthF(small ? 1.0 : 1.5);
+  pen.setCosmetic(true);
+  painter.setPen(pen);
+  painter.drawRect(codingRect);
+
+  painter.restore();
+}
