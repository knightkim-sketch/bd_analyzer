 }
 
+/* Snapshot the playlist for the next session and stop the timer in the same step.
+ *
+ * The timer has to stop here, not later: MainWindow::closeEvent deletes the playlist items after
+ * this call and then may open a dialog, which runs a nested event loop. A timer firing in that
+ * window would call autoSavePlaylist() on an empty playlist, and that removes the snapshot instead
+ * of writing one.
+ */
+void PlaylistTreeWidget::savePlaylistForNextSession()
+{
+  this->autosaveTimer.stop();
+  this->autoSavePlaylist();
+}
