   QByteArray uncompressedPlaylist = qUncompress(compressedPlaylist);
-  loadPlaylistFromByteArray(uncompressedPlaylist, QDir::current().absolutePath());
+  /* The second argument is a playlist *file* path, not a directory: the item loaders run it
+   * through QFileInfo::path() to get the directory that the stored relative paths are based on.
+   * Passing the directory itself stripped one level off, so every relative path resolved one
+   * directory too high and every item came back as a nullptr - an empty playlist. The names in
+   * the snapshot are relative to QDir::current() because that is what autoSavePlaylist() passes
+   * to getPlaylistString(), so name a file inside that directory to keep the two symmetric.
+   *
+   * The stored absolutePath does not save us here: it is written as a "file://" URL but checked
+   * with QFileInfo, which never matches, so the relative path is the only route that works.
+   */
+  loadPlaylistFromByteArray(uncompressedPlaylist,
+                            QDir::current().absoluteFilePath("autosave.yuvplaylist"));
 
   dropAutosavedPlaylist();
 }
