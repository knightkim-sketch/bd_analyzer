 PlaylistTreeWidget::~PlaylistTreeWidget()
 {
-  // This is a conventional quit. Remove the automatically saved playlist.
+  // This is a conventional quit. Remove the automatically saved playlist - unless the playlist is
+  // meant to survive the session, in which case that snapshot is what the next start restores.
   autosaveTimer.stop();
   QSettings settings;
-  if (settings.contains("Autosaveplaylist"))
+  if (!settings.value("SavePlaylistOnExit", true).toBool() &&
