+void FileInfoWidget::setFrameInfo(const InfoData &info)
+{
+  while (this->frameItemForm->rowCount() > 0)
+    this->frameItemForm->removeRow(0);
+  for (const auto &item : info.items)
+  {
+    auto *value = new QLabel(QString::fromStdString(item.text), this->frameItemBox);
+    value->setObjectName(QString("frameItemInfo:%1").arg(QString::fromStdString(item.name)));
+    value->setTextInteractionFlags(Qt::TextSelectableByMouse);
+    value->setWordWrap(true);
+    value->setToolTip(QString::fromStdString(item.description));
+    this->frameItemForm->addRow(QString::fromStdString(item.name), value);
+  }
+  this->frameItemBox->setTitle(info.title);
+  this->hasFrameItemInfo = !info.items.isEmpty();
+  this->frameItemBox->setVisible(this->hasFrameItemInfo);
+  this->tabs->setTabEnabled(this->frameTabIndex, this->obuModel != nullptr || this->hasFrameItemInfo);
+}
