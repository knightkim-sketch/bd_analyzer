+InfoData playlistItemCompressedVideo::getFrameInfo(int frameIdx) const
+{
+  if (!this->lcevcStream)
+    return {};
+  const auto &summary = this->lcevcStream->summary;
+  InfoData    info("LCEVC");
+  if (frameIdx < 0 || std::size_t(frameIdx) >= summary.pictures.size() ||
+      !summary.present[std::size_t(frameIdx)])
+  {
+    info.items.append(InfoItem("LCEVC NAL unit"sv, "none for this frame"sv));
+    return info;
+  }
+  const auto &p = summary.pictures[std::size_t(frameIdx)];
+  const auto &g = summary.global;
+  static const char *scaling[]  = {"none", "1D (horizontal)", "2D"};
+  static const char *upsample[] = {"nearest", "linear", "cubic", "modified cubic", "adaptive cubic"};
+  const auto onOff = [](bool b) { return std::string(b ? "1" : "0"); };
+  info.items.append(InfoItem("nal_unit_type"sv,
+                             std::to_string(p.nalUnitType) + " (" +
+                                 bda::lcevc::nalUnitTypeName(p.nalUnitType) + ")"));
+  info.items.append(InfoItem("Resolution"sv,
+                             std::to_string(p.baseWidth) + "x" + std::to_string(p.baseHeight) +
+                                 " -> " + std::to_string(g.outputWidth()) + "x" +
+                                 std::to_string(g.outputHeight()),
+                             "Base picture -> enhanced picture (after the conformance window)."sv));
+  info.items.append(InfoItem("Transform"sv, g.transformBlockSize == 4 ? "DDS (4x4)"sv : "DD (2x2)"sv));
+  info.items.append(InfoItem(
+      "Scaling LoQ-1 / LoQ-0"sv,
+      std::string(scaling[std::min(g.scalingModeLevel1, 2u)]) + " / " + scaling[std::min(g.scalingModeLevel2, 2u)],
+      "scaling_mode_level1 / scaling_mode_level2: base -> sub-layer 1 -> sub-layer 2 resolution."sv));
+  info.items.append(InfoItem("Upsampler"sv, upsample[std::min(g.upsampleType, 4u)]));
+  info.items.append(InfoItem("Enhancement"sv,
+                             p.enhancementEnabled ? "on"sv : "off (no_enhancement_bit)"sv));
+  info.items.append(InfoItem("step_width LoQ-1 / LoQ-0"sv,
+                             std::to_string(p.stepWidthLevel1) + " / " + std::to_string(p.stepWidthLevel2),
+                             "Quantisation step width of sub-layer 1 / sub-layer 2 (32767 = not coded)."sv));
+  info.items.append(InfoItem("quant_matrix_mode"sv, std::to_string(p.quantMatrixMode)));
+  info.items.append(InfoItem("Temporal"sv,
+                             std::string(g.temporalEnabled ? "enabled" : "disabled") +
+                                 ", temporal_refresh " + onOff(p.temporalRefresh) +
+                                 ", temporal_signalling_present " + onOff(p.temporalSignallingPresent)));
+  info.items.append(InfoItem(
+      "Dithering"sv,
+      p.ditheringControl ? "type " + std::to_string(p.ditheringType) + ", strength " +
+                               std::to_string(p.ditheringStrength) + " (not applied here)"
+                         : std::string("off"),
+      "bd-analyzer decodes with dithering off, so the picture is deterministic."sv));
+  const auto bytes = [&p](int loq) {
+    return std::to_string(p.surfaceBytes[0][loq]) + " / " + std::to_string(p.surfaceBytes[1][loq]) + " / " +
+           std::to_string(p.surfaceBytes[2][loq]);
+  };
+  info.items.append(InfoItem("Residual bytes LoQ-1 (Y/U/V)"sv, bytes(0)));
+  info.items.append(InfoItem("Residual bytes LoQ-0 (Y/U/V)"sv, bytes(1)));
+  return info;
+}
