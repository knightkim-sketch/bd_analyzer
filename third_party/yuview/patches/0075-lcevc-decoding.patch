+std::vector<std::vector<uint8_t>> ParserAnnexB::getLcevcPerFrameDisplayOrder()
+{
+  std::vector<std::vector<uint8_t>> perFrame;
+  if (this->lcevcUnits.empty())
+    return perFrame;
+  this->updateFrameListDisplayOrder();
+  perFrame.resize(this->frameListDisplayOder.size());
+  for (const auto &[filePos, bytes] : this->lcevcUnits)
+  {
+    // The first frame (coding order is file order) that ends after the unit. Not "starts after": a
+    // frame's range may begin at the parameter sets in front of the unit.
+    const auto frame = std::find_if(
+        this->frameListCodingOrder.begin(), this->frameListCodingOrder.end(), [filePos = filePos](const auto &f) {
+          return f.fileStartEndPos && f.fileStartEndPos->second > filePos;
+        });
+    if (frame == this->frameListCodingOrder.end())
+      continue;
+    const auto shown =
+        std::find(this->frameListDisplayOder.begin(), this->frameListDisplayOder.end(), *frame);
+    if (shown != this->frameListDisplayOder.end())
+      perFrame[std::size_t(std::distance(this->frameListDisplayOder.begin(), shown))] = bytes;
+  }
+  return perFrame;
+}
