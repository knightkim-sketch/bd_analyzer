   auto loadLibrary = [this](QLibrary &lib, QString libPath) {
     lib.setFileName(libPath);
+    // Never dlclose the ffmpeg libraries. Several objects own an FFmpegVersionHandler at the same
+    // time (every FileSourceFFmpegFile and every decoderFFmpeg), each with its own QLibrary for the
+    // same file. QLibrary reference counting does not survive that here: unloadAllLibraries() is
+    // called repeatedly while probing version combinations, so destroying one owner drops the
+    // shared mapping and leaves the other owners with dangling resolved function pointers.
+    // Measured: libavcodec mappings 4 -> 0 after deleting a single decoderFFmpeg, then any call
+    // through a still-open FileSourceFFmpegFile segfaults.
+    lib.setLoadHints(QLibrary::PreventUnloadHint);
     auto success = lib.load();
     this->log("Loading library " + libPath + (success ? " succeded" : " failed"));
     return success;
