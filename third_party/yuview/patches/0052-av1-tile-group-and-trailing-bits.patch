+{
+  try
+  {
+    if (!this->byte_aligned())
+      throw std::logic_error("Trying to read a le(n) value while not byte aligned.");
+
+    auto [value, code] = SubByteReader::readLE(nrBytes);
+    checkAndLog(this->currentTreeLevel, "le(v)", symbolName, options, value, code);
+    return value;
+  }
+  catch (const std::exception &ex)
+  {
+    this->logExceptionAndThrowError(ex, "le(" + std::to_string(nrBytes) + ") symbol " + symbolName);
+  }
+}
