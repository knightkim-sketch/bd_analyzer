+/* Spec 5.3.5 byte_alignment(). The padding is required to be zero and carries nothing, so a
+ * conformant stream logs no line for it - a bit per line here would bury the tile sizes. A
+ * non-zero bit is a conformance error, and that one does get a line.
+ */
+void byte_alignment(reader::SubByteReaderLogging &reader)
+{
+  while (!reader.byte_aligned())
+    if (reader.readBitsSilent(1))
+      reader.logArbitrary("byte_alignment_bit", "1", "f(1)", "1", "should be zero");
+}
+
+} // namespace
+
+void tile_group_obu::parse(SubByteReaderLogging &reader, const tile_info &tileInfo, size_t sz)
+{
+  SubByteReaderLoggingSubLevel subLevel(reader, "tile_group_obu()");
+
+  // Spec 5.9.1 aligns after the frame header and before the tile group. A tile group that has an
+  // OBU to itself already starts aligned, so this is a no-op there. nrBytesRead() rounds a partial
+  // byte up either way, so the caller's sz is the same before and after.
+  byte_alignment(reader);
+
+  const auto NumTiles    = tileInfo.TileCols * tileInfo.TileRows;
+  const auto startBitPos = reader.nrBitsRead();
+
+  if (NumTiles == 0)
+    throw std::logic_error("Tile group with no tiles - the frame header was not parsed.");
+
+  this->tile_start_and_end_present_flag = false;
+  if (NumTiles > 1)
+    this->tile_start_and_end_present_flag = reader.readFlag("tile_start_and_end_present_flag");
+
+  if (NumTiles == 1 || !this->tile_start_and_end_present_flag)
+  {
+    this->tg_start = 0;
+    this->tg_end   = NumTiles - 1;
+  }
+  else
+  {
+    const auto tileBits = tileInfo.TileColsLog2 + tileInfo.TileRowsLog2;
+    this->tg_start      = unsigned(reader.readBits("tg_start", tileBits));
+    this->tg_end        = unsigned(reader.readBits("tg_end", tileBits));
+  }
+
+  byte_alignment(reader);
+  const auto headerBytes = (reader.nrBitsRead() - startBitPos) / 8;
+  if (sz < headerBytes)
+    throw std::logic_error("Tile group header is larger than the OBU that carries it.");
+  sz -= headerBytes;
+
+  if (this->tg_end < this->tg_start || this->tg_end >= NumTiles)
+    throw std::logic_error("Tile group range is outside the frame's tile grid.");
+
+  for (auto TileNum = this->tg_start; TileNum <= this->tg_end; TileNum++)
+  {
+    size_t tileSize;
+    if (TileNum == this->tg_end)
+    {
+      // The last tile of the group has no size field - it is whatever is left of the OBU.
+      tileSize = sz;
+      sz       = 0;
+    }
+    else
+    {
+      const auto tile_size_minus_1 = reader.readLE("tile_size_minus_1", tileInfo.TileSizeBytes);
+      tileSize                     = size_t(tile_size_minus_1) + 1;
+      if (sz < tileSize + tileInfo.TileSizeBytes)
+        throw std::logic_error("Tile is larger than the bytes left in the OBU.");
+      sz -= tileSize + tileInfo.TileSizeBytes;
+    }
+    this->tileSizes.push_back(tileSize);
+    reader.skipBytes(tileSize);
+  }
+}
+
+} // namespace parser::av1
