+/* How many payload bytes of this OBU the reader has not consumed yet.
+ *
+ * obu_size counts the payload only, so the OBU header bytes come off the reader's total. An OBU
+ * without a size field runs to the end of what we were handed.
+ */
+size_t obuPayloadBytesLeft(const parser::av1::obu_header &header,
+                           const size_t                   dataSize,
+                           const size_t                   nrHeaderBytes,
+                           const parser::reader::SubByteReaderLogging &reader)
+{
+  const auto payloadBytes =
+      header.obu_has_size_field ? size_t(header.obu_size) : dataSize - nrHeaderBytes;
+  const auto consumed = reader.nrBytesRead() - nrHeaderBytes;
+  return payloadBytes > consumed ? payloadBytes - consumed : 0;
+}
+
+/* Spec 5.3.4 trailing_bits(), called from 5.3.1 for every OBU that is not a tile group, a tile
+ * list or a frame. A single one bit, then zeroes to the end of the OBU. It is the only thing that
+ * says where the payload really ended, so a parser that skips it cannot tell a short read from a
+ * complete one.
+ */
+void trailing_bits(parser::reader::SubByteReaderLogging &reader, size_t nbBitsLeft)
+{
+  reader.readFlag("trailing_one_bit");
+  for (nbBitsLeft--; nbBitsLeft > 0; nbBitsLeft--)
+    reader.readFlag("trailing_zero_bit");
+}
