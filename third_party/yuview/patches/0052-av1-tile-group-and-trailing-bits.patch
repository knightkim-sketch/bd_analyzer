+/* Spec 5.11.1 general_tile_group_obu().
+ *
+ * We read the tile group header and the size of each tile, and step over the tile payloads - the
+ * entropy coded blocks inside them are dav1d's job, not this parser's. The sizes are what makes a
+ * tiled stream legible: they say how the frame's bits were actually split across the tile grid,
+ * which the frame header only describes in the abstract.
+ */
+class tile_group_obu : public ObuPayload
+{
+public:
+  tile_group_obu() = default;
+
+  // sz is the number of payload bytes left in the OBU at the point this is called - after the OBU
+  // header, and for an OBU_FRAME after the frame header and its byte alignment.
+  void parse(reader::SubByteReaderLogging &reader, const tile_info &tileInfo, size_t sz);
+
+  bool     tile_start_and_end_present_flag{};
+  unsigned tg_start{};
+  unsigned tg_end{};
+  vector<size_t> tileSizes;
+};
+
+} // namespace parser::av1
