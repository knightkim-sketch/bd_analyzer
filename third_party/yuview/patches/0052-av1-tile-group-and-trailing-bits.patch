+void SubByteReader::skipBytes(size_t nrBytes)
+{
+  if (this->posInBufferBits != 0 && this->posInBufferBits != 8)
+    throw std::logic_error("When skipping bytes in the bitstream, it must be byte aligned.");
+
+  if (this->posInBufferBits == 8)
+    if (!this->gotoNextByte())
+      throw std::logic_error("Trying to skip over the buffer boundary.");
+
+  for (size_t i = 0; i < nrBytes; i++)
+    if (!this->gotoNextByte())
+      if (i < nrBytes - 1)
+        throw std::logic_error("Trying to skip over the buffer boundary.");
+}
+
+std::tuple<uint64_t, std::string> SubByteReader::readLE(size_t nrBytes)
+{
+  uint64_t    value = 0;
+  std::string coding;
+  for (size_t i = 0; i < nrBytes; i++)
+  {
+    auto [byte, byteCoding] = this->readBits(8);
+    coding += byteCoding;
+    value |= (byte << (i * 8));
+  }
+  return {value, coding};
+}
