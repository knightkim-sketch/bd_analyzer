+bool playlistItemCompressedVideo::attachLcevcEnhancement(const QString &path,
+                                                         QString       &error,
+                                                         DecoderEngine  engine)
+{
+  if (!this->video || this->rawFormat != video::RawFormat::YUV || this->propertiesWidget)
+  {
+    error = "LCEVC enhancement can only be attached to a freshly opened YUV item.";
+    return false;
+  }
+  QFile file(path);
+  if (!file.open(QIODevice::ReadOnly))
+  {
+    error = "Cannot read " + path;
+    return false;
+  }
+  const auto bytes = file.readAll();
+  // enh.nal.sizes next to enh.nal: one byte count per picture, so pictures without data keep their place.
+  std::optional<std::vector<std::size_t>> sizes;
+  if (QFile sizesFile(path + ".sizes"); sizesFile.open(QIODevice::ReadOnly))
+  {
+    sizes = bda::lcevc::parseSizesFile(sizesFile.readAll().toStdString());
+    if (!sizes)
+    {
+      error = path + ".sizes is not a list of byte counts";
+      return false;
+    }
+  }
+  auto perFrame = bda::lcevc::lcevcPerPictureFromNalFile(
+    reinterpret_cast<const std::uint8_t *>(bytes.constData()), std::size_t(bytes.size()), sizes ? &*sizes : nullptr);
+  const auto frames = std::size_t(this->properties().startEndRange.second + 1);
+  if (perFrame.size() != frames)
+    error = QString("%1 has %2 pictures, the base %3: frames past the shorter one show the base.")
+              .arg(path)
+              .arg(perFrame.size())
+              .arg(frames);
+  perFrame.resize(frames);
+  auto stream = bda::integration::makeLcevcStream(std::move(perFrame));
+  if (!stream->valid())
+  {
+    error = path + " has no LCEVC global_config";
+    return false;
+  }
+
+  QMutexLocker<QRecursiveMutex> decoderLock(&this->decoderAccessMutex);
+  const auto previousEngine = this->decoderEngine;
+  this->lcevcStream          = std::move(stream);
+  this->lcevcEnhancementPath = path;
+  for (const auto e : {DecoderEngine::LcevcLtm, DecoderEngine::LcevcDec})
+    if (!vectorContains(this->possibleDecoders, e))
+      this->possibleDecoders.push_back(e);
+  this->decoderEngine = isLcevcEngine(engine) ? engine : DecoderEngine::LcevcLtm;
+  bool allocated      = this->allocateDecoder();
+  if (!allocated && this->decoderEngine == DecoderEngine::LcevcLtm)
+  {
+    this->decoderEngine = DecoderEngine::LcevcDec;
+    allocated           = this->allocateDecoder();
+  }
+  if (!allocated)
+  {
+    error += (error.isEmpty() ? "" : "\n") + this->infoText;
+    this->decoderEngine = previousEngine;
+    this->allocateDecoder();
+  }
+  this->currentFrameIdx[0]       = -1;
+  this->currentFrameIdx[1]       = -1;
+  this->decodingNotPossibleAfter = -1;
+  this->video->invalidateAllBuffers();
+  this->statisticsUIHandler.clearStatTypes();
+  this->fillStatisticList();
+  return allocated;
+}
