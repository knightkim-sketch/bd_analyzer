diff -ruN a/decoder/src/HuffmanDecoder.cpp b/decoder/src/HuffmanDecoder.cpp
--- a/decoder/src/HuffmanDecoder.cpp	2026-10-23 16:10:14.886800537 +0900
+++ b/decoder/src/HuffmanDecoder.cpp	2026-10-23 17:10:44.480112977 +0900
@@ -124,14 +124,44 @@
 		}
 		c->value = current_value++;
 	}
+
+	// bd-analyzer: lookup table over the next lut_bits_ bits. Entries are filled in codes_ order and never
+	// overwritten, so an entry is the code decode_symbol()'s loop would match first.
+	lut_bits_ = std::min(codes_.back().bits, 12u);
+	lut_.assign(size_t(1) << lut_bits_, -1);
+	for (size_t i = 0; i < codes_.size() && i < 32768; ++i) {
+		const HuffmanCode &c = codes_[i];
+		if (c.bits > lut_bits_ || c.value >= (1u << c.bits))
+			break;
+		const unsigned first = c.value << (lut_bits_ - c.bits), last = (c.value + 1) << (lut_bits_ - c.bits);
+		for (unsigned w = first; w < last; ++w)
+			if (lut_[w] < 0)
+				lut_[w] = (int16_t)i;
+	}
 }
 
 unsigned HuffmanDecoder::decode_symbol(BitstreamUnpacker &b) {
+#if BITSTREAM_DEBUG
 	BitstreamUnpacker::ScopedContextLabel label(b, "entropy_symb");
+#endif
 
 	if (codes_.empty())
 		return single_symbol_;
 
+#if !BITSTREAM_DEBUG
+	// bd-analyzer: table lookup on the next lut_bits_ bits. A miss (only a longer code matches) or the end
+	// of the data falls through to the bit-by-bit loop, which starts from the same, unconsumed position.
+	if (lut_bits_ && b.remaining_bits() >= lut_bits_) {
+		const int16_t i = lut_[b.peek(lut_bits_)];
+		if (i >= 0) {
+			HuffmanCode &c = codes_[(size_t)i];
+			b.skip(c.bits);
+			c.count++;
+			return c.symbol;
+		}
+	}
+#endif
+
 	// Codes are sorted by increaing bit-length
 	//
 	// Check each code, adding bits to current value as necessary a match is found
