+uint32_t BitstreamUnpacker::peek(unsigned num_bits) const {
+	assert(num_bits <= 32);
+	assert((bit_offset_ + num_bits) <= bit_size());
+
+	// Same extraction as u(), on a copy of the offset.
+	unsigned offset = bit_offset_;
+	uint32_t r = 0;
+	while (num_bits) {
+		const unsigned bit_left = BITS_PER_BYTE - offset % BITS_PER_BYTE;
+		const unsigned data = view_.data()[offset / BITS_PER_BYTE];
+		const unsigned n = LCEVC_MIN(bit_left, num_bits);
+		r = (r << n) | ((data >> (bit_left - n)) & ((1 << n) - 1));
+		offset += n;
+		num_bits -= n;
+	}
+	return r;
+}
+
+void BitstreamUnpacker::skip(unsigned num_bits) {
+	assert((bit_offset_ + num_bits) <= bit_size());
+	bit_offset_ += num_bits;
+}
