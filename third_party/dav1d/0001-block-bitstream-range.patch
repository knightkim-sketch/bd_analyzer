diff --git a/src/msac.h b/src/msac.h
index 91556fc..f44b38c 100644
--- a/src/msac.h
+++ b/src/msac.h
@@ -41,10 +41,36 @@ typedef struct MsacContext {
     uint16_t rng;
     int cnt;
     int allow_update_cdf;
+    /* Analyzer extension. Where this tile's data started, so that a bit position can be reported
+     * relative to it, and where that data sits in the buffer the caller sent in. */
+    const uint8_t *buf_start;
+    uint64_t abs_bit_offset;
 } MsacContext;
 
+/* Number of bits the arithmetic decoder has consumed from buf_start.
+ *
+ * dav1d_msac_init() leaves cnt at -15 before the first refill, and every refill adds 8 bits per
+ * byte it takes from the buffer while ctx_norm() subtracts the bits a symbol actually used. So the
+ * bits still sitting unused in `dif` are cnt + 15, and everything else that was read has been
+ * consumed. This is exact bookkeeping of the coder, not an estimate - but note that an arithmetic
+ * coder does not give each syntax element its own bits, so a per-block range is only a range of the
+ * bytes the block's symbols were drawn from.
+ */
+static inline uint64_t dav1d_msac_consumed_bits(const MsacContext *const s) {
+    const int64_t bits = (int64_t)(s->buf_pos - s->buf_start) * 8 - s->cnt - 15;
+    return bits < 0 ? 0 : (uint64_t)bits;
+}
+
+/* The same position, but counted in the stream the caller pushed (see Dav1dData.m.offset). */
+static inline uint64_t dav1d_msac_abs_bit_pos(const MsacContext *const s) {
+    return s->abs_bit_offset + dav1d_msac_consumed_bits(s);
+}
