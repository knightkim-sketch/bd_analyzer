diff --git a/src/levels.h b/src/levels.h
index 427b25b..ae56564 100644
--- a/src/levels.h
+++ b/src/levels.h
@@ -287,6 +287,37 @@ typedef struct Av1Block {
             mv mv[2];
         }; // inter
     };
+    /* Analyzer extension. Where this block's symbols were read from, counted in bits from the start
+     * of the buffer that was handed to dav1d_send_data(), plus whatever the caller put in
+     * Dav1dData.m.offset for that buffer. So with m.offset set to the position of the pushed OBU
+     * inside its demuxed packet, these are positions inside that packet.
+     *
+     * Only filled when EXPORT_BLKDATA is set. Both are 0 when the position is unknown.
+     *
+     * These are the arithmetic decoder's read positions, not a bit field boundary: AV1 codes block
+     * syntax with a multi-symbol arithmetic coder, so a block has no exact bit range of its own.
+     * The interval does contain every byte the block's symbols were drawn from, which is what makes
+     * it useful for locating the block in the bitstream.
+     */
+    uint64_t bitstream_start_bit;
+    uint64_t bitstream_end_bit;
+    /* Analyzer extension. The quantizer index in effect for the superblock this block belongs to,
+     * which is the spec's CurrentQIndex: the frame's base y AC qindex plus whatever delta_q was read
+     * for the superblock. Every block of a superblock reports the same value, since delta_q is only
+     * read at the superblock's first block.
+     *
+     * Note this is the superblock value, not the block's final qindex - segmentation can shift it
+     * further per block (see get_qidx()).
+     */
+    uint8_t sb_qindex;
+    /* Analyzer extension. Bits the arithmetic decoder consumed for the whole superblock this block
+     * belongs to, so every block of a superblock reports the same number. Unlike the per block range
+     * above this is a real total: a superblock's symbols are contiguous in the tile data, so the
+     * difference between the coder's position before and after it is exactly its cost.
+     *
+     * Written after the superblock finished decoding, into every 4x4 cell it covers.
+     */
+    uint32_t sb_bit_count;
 } Av1Block;
 
